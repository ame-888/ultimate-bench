---
import Layout from '../../layouts/Layout.astro';
import { METHODOLOGY, METHODOLOGY_SECTIONS, methodologyFacts } from '../../data/methodology';
const canonical = new URL(METHODOLOGY.publicationPath, Astro.site).href;
---
<Layout robots="noindex, nosnippet" title={METHODOLOGY.webTitle} description={METHODOLOGY.description}>
  <Fragment slot="head">
    <meta property="og:image" content={new URL('/favicon.svg', Astro.site)} />
    <meta property="og:image:alt" content="Ultimate Bench methodology publication" />
    <meta name="twitter:card" content="summary" /><meta name="twitter:title" content={METHODOLOGY.webTitle} /><meta name="twitter:description" content={METHODOLOGY.description} />
  </Fragment>
  <main class="publication">
    <header class="cover">
      <p class="eyebrow">Complete public methodology</p><h1>Ultimate Bench:<br/><span>Methodology and Evaluation Protocol</span></h1>
      <div class="actions">
        <a class="primary" href={METHODOLOGY.pdfPath}>Open PDF</a><a href={METHODOLOGY.pdfPath} download>Download PDF</a>
        <button id="share-document" type="button">Share document</button><button id="copy-link" type="button" data-url={canonical}>Copy link</button>
      </div><p id="share-status" class="status" role="status" aria-live="polite"></p>
      <p class="abstract">{METHODOLOGY.description} This consolidated publication supplements the arena-specific pages; protected test cases and answer keys remain private.</p>
      <p class="meta"><strong>Version {METHODOLOGY.version}</strong><span>Revised {METHODOLOGY.revisionDate}</span><a href={METHODOLOGY.versionedPdfPath}>Versioned PDF</a></p>
    </header>
    <div class="document-grid">
      <nav class="toc" aria-label="Table of contents"><h2>Contents</h2><ol>{METHODOLOGY_SECTIONS.map((section)=><li><a href={`#${section.id}`}>{section.title}</a></li>)}</ol></nav>
      <article>
        {METHODOLOGY_SECTIONS.map((section, index) => <section id={section.id}><p class="section-number">{String(index+1).padStart(2,'0')}</p><h2>{section.title}</h2>{section.paragraphs.map(p=><p>{p}</p>)}
          {section.id === 'weights' && <div class="fact-grid">{methodologyFacts.map(f=><div><strong>{f.name}</strong><span>Operational {f.operationalWeight}/{f.permanentDenominator}</span><span>Reserved {f.reservedWeight}/{f.permanentDenominator}</span></div>)}</div>}
          {['visual-bench','data-bench','chess-bench'].includes(section.id) && (()=>{const id=section.id==='visual-bench'?'visual':section.id==='data-bench'?'data-retrieval':'chess';const f=methodologyFacts.find(x=>x.id===id)!;return <><div class="table-wrap"><table><thead><tr><th>Level</th><th>Name</th><th>Weight</th><th>Status</th></tr></thead><tbody>{f.levels.map(l=><tr><td>{l.number}</td><th scope="row">{l.name}</th><td>{l.weight}</td><td>{l.status}</td></tr>)}</tbody></table></div><p><a href={`/methodology/${id==='visual'?'visual-bench':id==='data-retrieval'?'data-bench':'chess-bench'}/`}>Read the detailed {f.name} methodology</a></p></>})()}
        </section>)}
      </article>
    </div>
  </main>
  <script is:inline define:vars={{ canonical, title: METHODOLOGY.webTitle, description: METHODOLOGY.description }}>
    const status=document.querySelector('#share-status'); const copy=async()=>{try{await navigator.clipboard.writeText(canonical)}catch{const t=document.createElement('textarea');t.value=canonical;document.body.append(t);t.select();document.execCommand('copy');t.remove()}status.textContent='Link copied to clipboard.'};
    document.querySelector('#copy-link')?.addEventListener('click',copy); document.querySelector('#share-document')?.addEventListener('click',async()=>{if(navigator.share){try{await navigator.share({title,text:description,url:canonical});status.textContent='Share sheet opened.'}catch(e){if(e.name!=='AbortError')await copy()}}else await copy()});
  </script>
</Layout>
<style>
  .publication{--accent:#5eead4;max-width:76rem;margin:auto;padding:clamp(3rem,7vw,6rem) 1.25rem 7rem;color:#cbd5e1}.cover{padding:clamp(2rem,6vw,5rem);border:1px solid #334155;border-radius:1.5rem;background:#172033}.eyebrow,.section-number{color:var(--accent);font-size:.72rem;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.cover h1{margin:.7rem 0 1.5rem;color:#fff;font-size:clamp(2.4rem,6vw,5rem);line-height:1}.cover h1 span{color:#a9b7ca}.abstract{max-width:50rem;font-size:1.08rem;line-height:1.75}.meta{display:flex;gap:1.2rem}.actions{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.6rem}.actions a,.actions button{min-height:2.8rem;padding:0 1rem;border:1px solid #64748b;border-radius:.6rem;background:transparent;color:#fff;font:700 .84rem var(--font-body);text-decoration:none;display:inline-flex;align-items:center;cursor:pointer}.actions .primary{border-color:#2dd4bf;background:#0f766e}.actions :focus-visible,.toc a:focus-visible{outline:3px solid var(--accent);outline-offset:3px}.status{min-height:1.2rem;color:#99f6e4}.document-grid{display:grid;grid-template-columns:16rem minmax(0,1fr);gap:clamp(2rem,6vw,6rem);margin-top:4rem}.toc{align-self:start;position:sticky;top:5.5rem;max-height:calc(100vh - 7rem);overflow:auto}.toc h2{color:#fff}.toc ol{padding-left:1.3rem}.toc li{margin:.45rem 0}.toc a{color:#9fb1c7;font-size:.8rem;text-underline-offset:.2em}article section{padding:0 0 4rem;scroll-margin-top:5rem;border-bottom:1px solid #293548;margin-bottom:4rem}article h2{margin:.3rem 0 1.1rem;color:#fff;font-size:clamp(1.7rem,4vw,2.5rem)}article p{line-height:1.8}.fact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.fact-grid div{display:flex;flex-direction:column;gap:.4rem;padding:1rem;border:1px solid #334155;border-radius:.7rem}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;margin:1.5rem 0}th,td{padding:.7rem;text-align:left;border-bottom:1px solid #334155}thead{color:#fff;background:#1e293b}article a{color:#7dd3fc}@media(max-width:760px){.document-grid{grid-template-columns:1fr}.toc{position:static;max-height:none}.fact-grid{grid-template-columns:1fr}.cover{padding:1.5rem}.actions>*{flex:1 1 9rem;justify-content:center}}@media print{nav.navbar,.site-footer,.actions,.status,.toc{display:none!important}.publication{max-width:none;padding:0;color:#111}.cover{background:#fff;border:0}.cover h1,article h2{color:#111}.cover h1 span{color:#444}.document-grid{display:block}article section{break-before:page;border:0}body{background:#fff!important}}
</style>
