---
import Layout from '../layouts/Layout.astro';
import MethodologyFingerprint from '../components/MethodologyFingerprint.astro';
import '../styles/content-pages.css';
import { ARENA_LIST, activeLevels, plannedLevels, canonicalDenominator, operationalWeight } from '../data/benchmarkSpec';
import { METHODOLOGY } from '../data/methodology';

const pillars = [
    {
        number: '01',
        title: 'Multi-domain by design',
        copy: 'Models are evaluated across visual reasoning, structured data work, and chess—three distinct ways to test how reliably a system can interpret, transform, and reason.',
    },
    {
        number: '02',
        title: 'Consistent conditions',
        copy: 'Within each category, models face the same task families and scoring standard. Runs are checked before results are accepted into the published dataset.',
    },
    {
        number: '03',
        title: 'Comparable, not absolute',
        copy: 'Scores make differences easier to explore; they do not reduce model quality to one universal number or predict performance for every real-world use case.',
    },
];

const process = [
    { title: 'Define', copy: 'We select bounded task families that reward correct outputs and meaningful reasoning—not presentation style or verbosity.' },
    { title: 'Evaluate', copy: 'Each named product or interface configuration follows a documented category procedure; provider-controlled conditions remain part of that product environment.' },
    { title: 'Verify', copy: 'Outputs and score records are reviewed for obvious run failures, inconsistencies, and data-entry errors before publication.' },
    { title: 'Publish', copy: 'Category results and the aggregate are added to the public leaderboard with enough context to compare models responsibly.' },
];
---

<Layout title="Methodology | Ultimate Bench" description="How Ultimate Bench evaluates and compares AI models—our principles, score aggregation, safeguards, and limitations.">
    <main class="methodology-page">
        <header class="methodology-hero">
            <p class="eyebrow"><span aria-hidden="true"></span> Behind the benchmark</p>
            <h1>Rigorous by design.<br /><em>Transparent where public.</em></h1>
            <p class="hero-copy">A clear view of the public protocols, scoring rules, safeguards, and protected test material behind the current experimental comparison.</p>
        <section class="publication-download" aria-label="Complete methodology publication">
            <div><strong>Complete methodology · PDF · v{METHODOLOGY.version}</strong><span>Updated {METHODOLOGY.revisionDate}</span></div>
            <div><a class="download" href={METHODOLOGY.pdfPath} download>Download complete methodology</a><a href={METHODOLOGY.publicationPath}>Read complete methodology online</a></div>
        </section>

            <nav class="jump-links" aria-label="On this page">
                <a href="#protocols">Protocols</a>
                <a href="#principles">Principles</a>
                <a href="#process">Process</a>
                <a href="#scoring">Scoring</a>
                <a href="#analysis-methods">Analysis methods</a>
                <a href="#limitations">Limitations</a>
            </nav>
        </header>


        <section id="protocols" class="protocol-card" aria-labelledby="protocols-title">
            <div>
                <p class="section-label">Detailed benchmark protocols</p>
                <h2 id="protocols-title">From general principles to level-specific methods.</h2>
                <p>This page describes the benchmark’s general principles and aggregation. Dedicated sibling pages document the Visual Bench, DATA Bench, and Chess Bench procedures and level protocols. Planned and Locked levels reserve weight without model-level results.</p>
            </div>
            <div class="protocol-links">
                <a href="/methodology/visual-bench/">Read the Visual Bench level protocols <span aria-hidden="true">→</span></a>
                <a href="/methodology/data-bench/">Read the DATA Bench level protocols <span aria-hidden="true">→</span></a>
                <a href="/methodology/chess-bench/">Read the Chess Bench level protocols <span aria-hidden="true">→</span></a>
            </div>
        </section>

        <section class="trust-note" aria-labelledby="transparency-title">
            <div class="lock-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 10V7a5 5 0 0 1 10 0v3M6 10h12v10H6z" /></svg>
            </div>
            <div>
                <p class="section-label">A note on transparency</p>
                <h2 id="transparency-title">We explain the standard, not the answer key.</h2>
                <p>Ultimate Bench publicly documents its evaluated constructs, administration structure, scoring framework, result semantics, weighting, coverage rules, and limitations. Exact active prompts, protected stimuli, answer keys, fixed item details, private scoring schedules, adversarial event schedules, and other details that could enable memorization, reconstruction, fingerprinting, or targeted benchmark-specific optimization remain confidential while a benchmark version is active. This is methodological transparency without publication of exploitable active material.</p>
            </div>
            <span class="status-pill"><span></span> Public protocol · protected cases</span>
        </section>

        <section id="principles" class="section-block" aria-labelledby="principles-title">
            <div class="section-intro">
                <div>
                    <p class="section-label">What we measure</p>
                    <h2 id="principles-title">Three principles shape every comparison.</h2>
                </div>
                <p>Ultimate Bench is an independent experimental benchmark. It is designed to reveal useful differences between models, not to declare a single model “best” for every person or task.</p>
            </div>
            <div class="pillar-grid">
                {pillars.map((pillar) => (
                    <article class="pillar-card">
                        <span class="card-number">{pillar.number}</span>
                        <h3>{pillar.title}</h3>
                        <p>{pillar.copy}</p>
                    </article>
                ))}
            </div>
        </section>

        <section id="process" class="section-block process-section" aria-labelledby="process-title">
            <div class="section-intro compact">
                <div>
                    <p class="section-label">Evaluation lifecycle</p>
                    <h2 id="process-title">From task design to leaderboard.</h2>
                </div>
                <p>The exact execution method remains confidential, but every published result follows the same high-level path.</p>
            </div>
            <ol class="process-list">
                {process.map((step, index) => (
                    <li>
                        <span class="step-index">{String(index + 1).padStart(2, '0')}</span>
                        <div><h3>{step.title}</h3><p>{step.copy}</p></div>
                    </li>
                ))}
            </ol>
        </section>

        <section id="scoring" class="score-section" aria-labelledby="scoring-title">
            <div class="score-copy"><p class="section-label">Scoring &amp; aggregation</p><h2 id="scoring-title">Progressive Level Weighting,<br />three distinct signals.</h2>
            <p><strong>Fixed six-level normalization:</strong> Every arena is permanently normalized against all six progressive weights—1, 2, 4, 8, 16, and 32—for a full ladder denominator of 63. Active numeric results earn weighted points; all unearned or unavailable capacity contributes zero to the numerator. Planned and Locked levels reserve future weight without model-level results, so activation never changes the denominator.</p>
            <p><code>Arena score = Σ(earned level result × level weight) / 63</code>. Operational weight is Visual 31/63, Data Retrieval 15/63, and Chess 31/63; the currently attainable maxima are 49.21%, 23.81%, and 49.21%. An arena score is weighted performance earned against the complete intended six-level arena—not a percentage only across Active levels.</p>
            <p><strong>Overall = (Visual + Data Retrieval + Chess) / 3</strong>, calculated at full precision and rounded only for display. Token price affects only cost comparisons, chart position, and Pareto membership—never results, canonical scores, or ranks.</p></div>
            <div class="formula-card" aria-label="Progressive Level Weighting formula"><p>Universal weights</p><div class="fraction"><span><b>1, 2, 4, 8, 16, 32</b></span><span>Level 1 → Level 6</span></div><small>Full ladder denominator: 63. Status determines whether weight is operational or reserved.</small></div>
        </section>
        <section class="section-block" aria-labelledby="structure-title"><div class="section-intro"><div><p class="section-label">Current structure</p><h2 id="structure-title">Active, Planned, and Locked levels.</h2></div></div><div class="pillar-grid">{ARENA_LIST.map(arena => <article class="pillar-card"><h3>{arena.name}</h3><p>{activeLevels(arena).length} Active; {plannedLevels(arena).length} Planned; {arena.levels.filter(level => level.status === 'Locked').length} Locked.</p><ul>{arena.levels.map(level => <li>Level {level.number} — {level.name}: <strong>{level.status}</strong> · weight {level.weight} {level.status === 'Active' ? 'operational' : 'reserved'}</li>)}</ul></article>)}</div></section>
        <section class="section-block" aria-labelledby="status-rules-title"><div class="section-intro"><div><p class="section-label">Coverage and qualification</p><h2 id="status-rules-title">Every result state has one rule.</h2></div></div><div class="limitation-grid"><p><strong>Numeric 0–100:</strong> the Active level was administered and produced a valid result; zero means an observed score of zero and is fully weighted.</p><p><strong>Invalid:</strong> attempted but failed validity; contributes zero and retains weight.</p><p><strong>Unavailable:</strong> could not run; contributes zero without reducing denominator 63, and makes Active-level coverage incomplete.</p><p><strong>Not tested:</strong> not attempted; contributes zero without reducing denominator 63, and makes Active-level coverage incomplete.</p><p><strong>Missing:</strong> a validation error for any Active level.</p><p><strong>Locked / Planned:</strong> reserved zero capacity, not a model result. Locked requires a protocol and unlock condition; Planned has no operational protocol.</p></div><p><strong>Independent administration.</strong> Every model/configuration is administered on every Active level, regardless of earlier results. A score of 0% or INVALID does not stop testing or prevent administration of later Active levels.</p><h3>Computable score</h3><p>A score always uses denominator 63. Score normalization is separate from Active-level coverage.</p><h3>Officially rankable score</h3><p>An arena score is officially rankable only when every Active level is included. Officially ranked models therefore use the same set of levels and the same full denominator.</p><h3>Provisional score</h3><p>A computable score with one or more <strong>Unavailable</strong> or <strong>Not tested</strong> Active levels is provisional. It remains visible for transparency, but receives no official rank and cannot determine an arena leader or Overall qualification. For example, a result covering 1/4 Active levels remains provisional even though its score uses the same denominator 63 as every other result.</p><p>A model qualifies for Overall only with a rank-eligible score and complete Active-level coverage in all three arenas. Equal full-precision scores share rank; alphabetical order between ties is presentation only. Alternate arena modes reorder rows for exploration and never modify canonical scores, coverage, eligibility, or official ranks.</p></section>
        <section class="section-block" aria-labelledby="worked-example-title"><div class="section-intro"><div><p class="section-label">Recorded worked example</p><h2 id="worked-example-title">GPT-5.6 Sol (high) - JULY.</h2></div></div><p><strong>Visual:</strong> <code>(86 + 2×71 + 4×65 + 8×25 + 16×0) / 63 = 688 / 63 = 10.9206…</code> → 10.9%.</p><p><strong>Data Retrieval:</strong> <code>(51 + 2×46 + 4×36 + 8×3) / 63 = 311 / 63 = 4.9365…</code> → 4.9%.</p><p><strong>Chess:</strong> <code>(97 + 2×68 + 4×59 + 8×0 + 16×0) / 63 = 469 / 63 = 7.4444…</code> → 7.4%.</p><p><strong>Overall:</strong> the equal mean of those unrounded values is 7.7672… → 7.8%.</p><p>Raw trials are individual administration outcomes; arena aggregates apply Progressive Level Weighting; Overall averages arena aggregates; cost comparisons place Overall beside separate price data.</p></section>
        <section id="analysis-methods" class="section-block" aria-labelledby="analysis-methods-title">
            <div class="section-intro"><div><p class="section-label">Analysis dashboard</p><h2 id="analysis-methods-title">Official scores, exploratory lenses.</h2></div><p>The Analysis page derives every result from the published records at build time. It never replaces or modifies canonical leaderboard arithmetic.</p></div>
            <div class="limitation-grid">
                <p><strong>Cohorts and transfer.</strong> Cross-arena analysis includes only globally qualified configurations. Spearman correlation is Pearson correlation of ascending ranks; tied values receive their average rank. Rank-gap outliers are the largest absolute differences between a configuration’s two arena mid-ranks.</p>
                <p><strong>Status policy.</strong> Numeric positives and observed numeric zeroes remain distinct counts. Numeric exploratory medians include all numeric values. INVALID, UNAVAILABLE, and NOT_TESTED are omitted unless a view explicitly says INVALID is mapped to zero.</p>
                <p><strong>Relative profiles.</strong> Within each arena, percentile is <code>(tied mid-rank − 1) / (n − 1)</code>; a one-row cohort receives 50%. Broad profiles meet the 66⅔rd percentile in every arena; specialists reach the 80th percentile somewhere with at least a 50-point percentile spread; consistently weak profiles are at or below the 33rd percentile throughout.</p>
                <p><strong>Matched configurations.</strong> Pairs exist only where records share explicit comparison-group metadata and exactly identify a baseline and changed condition. Every Active level remains visible, including non-numeric status changes. Observed differences are descriptive and not necessarily causal.</p>
                <p><strong>Dominance.</strong> A globally qualified configuration is dominated when another has an equal or higher full-precision canonical score in every arena and a strictly higher score in at least one. Configurations without a dominator form the Pareto frontier; identical profiles do not dominate one another.</p>
                <p><strong>Sensitivity.</strong> Canonical weighted results and denominator 63 remain official. Exploratory flat means weight Active levels equally; the default omits non-numeric statuses, while the disclosed alternative maps INVALID to zero and still omits unavailable or untested results. Arena-relative percentiles discard absolute score distances.</p>
            </div>
            <p>These descriptive analyses have no significance test or confidence interval. Small globally qualified cohorts, uneven arena coverage, related configurations, provider-controlled settings, and protected test cases limit inference and independent reproduction. “Early-level collapse” is shown at level and status granularity rather than assigned as a cross-arena archetype because the data do not support a defensible cross-arena threshold.</p>
        </section>
        <p><a href="/glossary">Open the public benchmark glossary</a> · <a href="/revisions">Review methodology and dataset revisions</a></p>
        <aside class="correction-card" aria-label="Benchmark migration note"><div><p class="section-label">Benchmark version · 29 July 2026</p><p>All arenas now use permanent denominator 63; Planned and Locked weights are reserved. Hydra returned from Active to Locked because no model passed Python, and its model-level zeroes were removed. Visual, Data Retrieval, Chess, and Overall scores changed, so active-only-denominator scores from the former version are not directly comparable.</p></div></aside>
        <section id="limitations" class="section-block limitations" aria-labelledby="limitations-title">
            <div class="section-intro compact">
                <div>
                    <p class="section-label">Read results responsibly</p>
                    <h2 id="limitations-title">What the scores cannot tell you.</h2>
                </div>
            </div>
            <div class="limitation-grid">
                <p><strong>Not a universal measure.</strong> A benchmark samples capabilities; it cannot represent every workflow, language, risk, or user preference.</p>
                <p><strong>Results are time-bound.</strong> Scores reflect the tested model version and evaluation conditions. Providers may update models after a run.</p>
                <p><strong>Small gaps need caution.</strong> Nearby scores should not be treated as decisive proof that one model is categorically superior.</p>
                <p><strong>Not independent certification.</strong> Results are not a vendor guarantee, safety audit, or substitute for testing against your own requirements.</p>
            </div>
        </section>

        <aside class="correction-card">
            <div><p class="section-label">Help us keep it accurate</p><h2>Spot something that needs attention?</h2></div>
            <a href="/contact">Submit a correction <span aria-hidden="true">→</span></a>
        </aside>
      <MethodologyFingerprint value="UB-METH-20260730-A7Q4" />
</main>
</Layout>

<style>
    .publication-download { display:flex;justify-content:space-between;align-items:center;gap:1rem;margin:-2.5rem 0 2rem;padding:1.2rem;border:1px solid rgba(94,234,212,.35);border-radius:1rem;background:rgba(15,118,110,.13) }.publication-download>div{display:flex;flex-wrap:wrap;gap:.7rem;align-items:center}.publication-download span{color:#94a3b8;font-size:.8rem}.publication-download a{display:inline-flex;align-items:center;min-height:2.75rem;padding:0 1rem;border:1px solid #64748b;border-radius:.6rem;color:#e2e8f0;font-size:.8rem;font-weight:800;text-decoration:none}.publication-download .download{border-color:#2dd4bf;background:#0f766e;color:#fff}.publication-download a:focus-visible{outline:3px solid #5eead4;outline-offset:3px}@media(max-width:700px){.publication-download{margin-top:-2rem;align-items:stretch;flex-direction:column}.publication-download>div:last-child{display:grid}.publication-download a{justify-content:center}}
    .methodology-page { --mint: #5eead4; --blue: #60a5fa; max-width: 72rem; margin: 0 auto; padding: clamp(4.5rem, 9vw, 8rem) 1.25rem 7rem; color: #cbd5e1; }
    .methodology-hero { position: relative; max-width: 58rem; margin-bottom: clamp(4rem, 9vw, 7.5rem); }
    .methodology-hero::after { content: ''; position: absolute; z-index: -1; width: 32rem; height: 24rem; top: -9rem; right: -23rem; border-radius: 50%; background: rgba(45, 212, 191, .1); filter: blur(80px); }
    .eyebrow, .section-label { color: var(--mint); font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
    .eyebrow { display: flex; align-items: center; gap: .7rem; margin: 0 0 1.25rem; }
    .eyebrow span { width: 2.5rem; height: 1px; background: var(--mint); }
    h1 { margin: 0; color: #f8fafc; font-size: clamp(3rem, 7.2vw, 6.2rem); line-height: .98; letter-spacing: -.065em; }
    h1 em { color: #94a3b8; font-style: normal; }
    .hero-copy { max-width: 43rem; margin: 1.8rem 0 2rem; color: #94a3b8; font-size: clamp(1rem, 2vw, 1.15rem); line-height: 1.75; }
    .jump-links { display: flex; flex-wrap: wrap; gap: .55rem; }
    .jump-links a { padding: .55rem .9rem; border: 1px solid rgba(148,163,184,.18); border-radius: 99px; color: #cbd5e1; font-size: .76rem; font-weight: 700; text-decoration: none; transition: .2s ease; }
    .jump-links a:hover { border-color: var(--mint); color: var(--mint); transform: translateY(-2px); }
    .jump-links a:focus-visible, .protocol-card a:focus-visible { outline: 3px solid var(--mint); outline-offset: 4px; }
    .protocol-card { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; margin-bottom: 2rem; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid rgba(96,165,250,.25); border-radius: 1.5rem; background: rgba(30,41,59,.48); scroll-margin-top: 5rem; }
    .protocol-card h2 { margin: 0; color: #f8fafc; font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -.035em; }
    .protocol-card p:last-child { max-width: 48rem; margin: .8rem 0 0; color: #94a3b8; line-height: 1.7; }
    .protocol-links { display: flex; flex-direction: column; align-items: flex-start; gap: .75rem; }
    .protocol-links a { color: #bfdbfe; font-size: .86rem; font-weight: 800; text-underline-offset: .25em; }
    .protocol-links a:hover { color: #fff; }
    .trust-note { display: grid; grid-template-columns: auto 1fr auto; gap: 1.5rem; align-items: start; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid rgba(94,234,212,.2); border-radius: 1.5rem; background: linear-gradient(120deg, rgba(19,78,74,.2), rgba(15,23,42,.72)); box-shadow: 0 25px 70px rgba(0,0,0,.18); }
    .lock-mark { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border: 1px solid rgba(94,234,212,.25); border-radius: 1rem; background: rgba(94,234,212,.08); }
    .lock-mark svg { width: 1.35rem; fill: none; stroke: var(--mint); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .section-label { margin: 0 0 .6rem; }
    .trust-note h2, .section-block h2, .score-section h2, .correction-card h2 { margin: 0; color: #f8fafc; font-size: clamp(1.6rem, 3.5vw, 2.4rem); line-height: 1.18; letter-spacing: -.04em; }
    .trust-note p:last-child { max-width: 48rem; margin: .8rem 0 0; color: #a8b5c7; line-height: 1.75; }
    .status-pill { display: flex; align-items: center; gap: .45rem; white-space: nowrap; color: #99f6e4; font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
    .status-pill span { width: .45rem; height: .45rem; border-radius: 50%; background: var(--mint); box-shadow: 0 0 10px var(--mint); }
    .section-block { padding-top: clamp(5rem, 10vw, 8rem); scroll-margin-top: 5rem; }
    .section-intro { display: grid; grid-template-columns: 1.05fr .8fr; align-items: end; gap: 4rem; margin-bottom: 2.25rem; }
    .section-intro > p { margin: 0; color: #94a3b8; line-height: 1.75; }
    .section-intro.compact { align-items: start; }
    .pillar-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .pillar-card { min-height: 15rem; padding: 1.7rem; border: 1px solid rgba(148,163,184,.13); border-radius: 1.25rem; background: rgba(30,41,59,.38); transition: border-color .25s, transform .25s; }
    .pillar-card:hover { transform: translateY(-4px); border-color: rgba(94,234,212,.32); }
    .card-number { color: var(--mint); font: 700 .72rem var(--font-body); letter-spacing: .1em; }
    .pillar-card h3 { margin: 3.5rem 0 .65rem; color: #f8fafc; font-size: 1.12rem; }
    .pillar-card p { margin: 0; color: #94a3b8; font-size: .91rem; line-height: 1.7; }
    .process-list { display: grid; grid-template-columns: repeat(4, 1fr); margin: 3rem 0 0; padding: 0; list-style: none; counter-reset: steps; }
    .process-list li { position: relative; padding: 0 1.5rem 0 0; }
    .process-list li:not(:last-child)::after { content: ''; position: absolute; top: 1rem; left: 2.8rem; right: .7rem; height: 1px; background: linear-gradient(90deg, rgba(94,234,212,.65), rgba(94,234,212,.08)); }
    .step-index { display: grid; place-items: center; position: relative; z-index: 1; width: 2rem; height: 2rem; border-radius: 50%; color: #081a1b; background: var(--mint); font-size: .66rem; font-weight: 900; }
    .process-list h3 { margin: 1.2rem 0 .45rem; color: #f8fafc; font-size: 1rem; }
    .process-list p { margin: 0; color: #8897aa; font-size: .84rem; line-height: 1.7; }
    .score-section { display: grid; grid-template-columns: 1fr .9fr; gap: clamp(2rem, 7vw, 6rem); align-items: center; margin-top: clamp(5rem, 11vw, 9rem); padding: clamp(2rem, 6vw, 4rem); border-block: 1px solid rgba(148,163,184,.14); scroll-margin-top: 5rem; }
    .score-copy > p:not(.section-label) { color: #94a3b8; line-height: 1.75; }
    .data-note { padding-left: 1rem; border-left: 2px solid rgba(94,234,212,.45); font-size: .82rem; }
    code { color: #ccfbf1; font-size: .85em; }
    .formula-card { padding: 2.2rem; border: 1px solid rgba(96,165,250,.24); border-radius: 1.5rem; text-align: center; background: radial-gradient(circle at top, rgba(59,130,246,.16), rgba(15,23,42,.72) 68%); }
    .formula-card > p { margin: 0 0 1.5rem; color: #93c5fd; font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
    .fraction { display: inline-flex; flex-direction: column; color: #f8fafc; font-size: clamp(1.15rem, 3vw, 1.6rem); }
    .fraction span:first-child { padding: 0 .8rem .7rem; border-bottom: 1px solid #64748b; }
    .fraction span:last-child { padding-top: .5rem; }
    .fraction b:nth-child(1) { color: #a5b4fc; } .fraction b:nth-child(2) { color: #7dd3fc; } .fraction b:nth-child(3) { color: #5eead4; }
    .formula-card small { display: block; margin-top: 1.5rem; color: #64748b; }
    .limitation-grid { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid rgba(148,163,184,.14); border-radius: 1.25rem; overflow: hidden; }
    .limitation-grid p { margin: 0; padding: 1.5rem; color: #94a3b8; font-size: .9rem; line-height: 1.7; }
    .limitation-grid p:nth-child(odd) { border-right: 1px solid rgba(148,163,184,.14); }
    .limitation-grid p:nth-child(-n+2) { border-bottom: 1px solid rgba(148,163,184,.14); }
    .limitation-grid strong { display: block; margin-bottom: .2rem; color: #e2e8f0; }
    .correction-card { display: flex; justify-content: space-between; align-items: center; gap: 2rem; margin-top: 5rem; padding: 2rem 2.5rem; border-radius: 1.25rem; background: #e2e8f0; }
    .correction-card .section-label { color: #0f766e; }
    .correction-card h2 { color: #0f172a; font-size: 1.4rem; }
    .correction-card a { padding: .85rem 1.1rem; border-radius: .7rem; color: white; background: #0f766e; font-size: .8rem; font-weight: 800; text-decoration: none; white-space: nowrap; }
    @media (max-width: 760px) {
        .methodology-page { padding-top: 3.5rem; }
        .trust-note { grid-template-columns: auto 1fr; } .status-pill { grid-column: 2; }
        .section-intro, .score-section { grid-template-columns: 1fr; gap: 1.5rem; }
        .pillar-grid { grid-template-columns: 1fr; } .pillar-card { min-height: auto; } .pillar-card h3 { margin-top: 2rem; }
        .process-list { grid-template-columns: 1fr; gap: 1.8rem; } .process-list li { display: grid; grid-template-columns: auto 1fr; gap: 1rem; }
        .process-list li::after { display: none; } .process-list h3 { margin-top: 0; }
