---
import Layout from '../layouts/Layout.astro';
import '../styles/content-pages.css';
const terms = [
['Active','A level whose operational protocol is currently administered and scored.'],['Planned','A future level without an operational protocol. Its weight is reserved and it has no model-level results.'],['Locked','A defined protocol held behind an explicit activation condition. Its weight remains reserved until a deliberate benchmark-version decision.'],['Numeric zero','A completed, valid administration that scored zero. It is not missing data and counts toward Active-level coverage.'],['INVALID','An attempted administration that failed its applicable validity rule. It contributes zero and counts as covered.'],['UNAVAILABLE','The named configuration could not be accessed. It contributes zero and makes Active-level coverage incomplete.'],['NOT_TESTED','The Active level was not administered. It contributes zero and makes coverage incomplete.'],['Provisional','A computable arena result with one or more UNAVAILABLE or NOT_TESTED Active levels. It is visible but not officially ranked.'],['Rank eligible','A result with numeric or INVALID outcomes for every Active level, making it eligible for an official arena rank.'],['Permanent denominator','The sum of all six Progressive Level Weighting positions: 1 + 2 + 4 + 8 + 16 + 32 = 63.'],['Operational weight','The sum of weights assigned to levels currently marked Active. It describes earnable arena capacity, not a model’s coverage.'],['Reserved weight','The part of denominator 63 assigned to Planned or Locked levels. Reserved weight is not a model result.'],['Overall','The equal arithmetic mean of the three full-precision canonical arena scores, available only to globally qualified configurations.'],['Progressive Level Weighting','The published system that weights Levels 1–6 by 1, 2, 4, 8, 16, and 32 while retaining the permanent denominator 63.'],
] as const;
---
<Layout title="Benchmark Glossary | Ultimate Bench" description="Definitions for Ultimate Bench levels, result states, coverage, weighting, rank eligibility, and Overall scoring."><main class="content-page"><header class="page-heading"><span class="page-kicker">Reader reference</span><h1>Benchmark glossary</h1><p>Concise definitions for the status, coverage, and scoring language used throughout Ultimate Bench.</p></header><article class="content-card"><dl class="glossary">{terms.map(([term,definition])=><div><dt>{term}</dt><dd>{definition}</dd></div>)}</dl><p>For formal rules and edge cases, read the <a href="/methodology">methodology overview</a> or use the <a href="/guide">practical guide</a>.</p></article></main></Layout>
<style>.glossary{display:grid}.glossary div{padding:1.2rem 0;border-bottom:1px solid #334155}.glossary dt{color:#e0f2fe;font-weight:800}.glossary dd{margin:.4rem 0 0;color:#b8c5d4;line-height:1.75}</style>
