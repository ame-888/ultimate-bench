---
import Layout from '../layouts/Layout.astro';
import '../styles/content-pages.css';

const terms = [
    ['Active', 'A level whose operational protocol is currently administered and scored.'],
    ['Planned', 'A future level without an operational protocol. Its weight is reserved and it has no model-level results.'],
    ['Locked', 'A defined protocol held behind an explicit activation condition. Its weight remains reserved until a deliberate benchmark-version decision.'],
    ['Numeric zero', 'A completed, valid administration that scored zero. It is not missing data and counts toward Active-level coverage.'],
    ['INVALID', 'An attempted administration that failed its applicable validity rule. It contributes zero and counts as covered.'],
    ['UNAVAILABLE', 'The named configuration could not be accessed. It contributes zero and makes Active-level coverage incomplete.'],
    ['NOT_TESTED', 'The Active level was not administered. It contributes zero and makes coverage incomplete.'],
    ['Provisional', 'A computable arena result with one or more UNAVAILABLE or NOT_TESTED Active levels. It is visible but not officially ranked.'],
    ['Rank eligible', 'A result with numeric or INVALID outcomes for every Active level, making it eligible for an official arena rank.'],
    ['Permanent denominator', 'The sum of all six Progressive Level Weighting positions: 1 + 2 + 4 + 8 + 16 + 32 = 63.'],
    ['Operational weight', 'The sum of weights assigned to levels currently marked Active. It describes earnable arena capacity, not a model’s coverage.'],
    ['Reserved weight', 'The part of denominator 63 assigned to Planned or Locked levels. Reserved weight is not a model result.'],
    ['Overall', 'The equal arithmetic mean of the three full-precision canonical arena scores, available only to globally qualified configurations.'],
    ['Progressive Level Weighting', 'The published system that weights Levels 1–6 by 1, 2, 4, 8, 16, and 32 while retaining the permanent denominator 63.'],
] as const;
---
<Layout title="Benchmark Glossary | Ultimate Bench" description="Definitions for Ultimate Bench levels, result states, coverage, weighting, rank eligibility, and Overall scoring.">
    <main class="content-page">
        <header class="page-heading">
            <span class="page-kicker">Reader reference</span>
            <h1>Benchmark glossary</h1>
            <p>Concise definitions for the status, coverage, and scoring language used throughout Ultimate Bench.</p>
        </header>
        <article class="content-card">
            <dl class="glossary">
                {terms.map(([term, definition]) => (
                    <div>
                        <dt>{term}</dt>
                        <dd>{definition}</dd>
                    </div>
                ))}
            </dl>
            <p class="glossary-footer">
                For formal rules and edge cases, read the <a href="/methodology">methodology overview</a> or use the <a href="/guide">practical guide</a>.
            </p>
        </article>
    </main>
</Layout>

<style>
.glossary {
    display: grid;
    margin: 0;
}

.glossary div {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 0.45rem 1.75rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line-subtle);
}

.glossary div:first-child {
    padding-top: 0;
}

.glossary div:last-child {
    border-bottom: 0;
}

.glossary dt {
    color: var(--text);
    font-weight: 700;
}

.glossary dd {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
}

.glossary-footer {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-subtle);
}

@media (max-width: 640px) {
    .glossary div {
        grid-template-columns: 1fr;
    }
}
</style>
