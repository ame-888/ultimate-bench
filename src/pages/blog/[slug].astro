---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';

export function getStaticPaths() {
    return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const published = new Date(`${article.date}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
});
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const articleJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    datePublished: article.date,
    author: { '@type': 'Person', name: 'Ame-888', url: new URL('/about/', Astro.site).href },
    publisher: { '@type': 'Organization', name: 'Ultimate Bench', url: new URL('/', Astro.site).href },
    mainEntityOfPage: canonicalUrl,
};
const breadcrumbJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Articles', item: new URL('/blog/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: article.title, item: canonicalUrl },
    ],
};
---

<Layout title={`${article.title} | Ultimate Bench`} description={article.description} ogType="article">
    <Fragment slot="head">
        <meta property="article:published_time" content={`${article.date}T00:00:00Z`} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replaceAll('<', '\\u003c')} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replaceAll('<', '\\u003c')} />
    </Fragment>
    <main class="article-page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/guide">Guide</a>
            <span aria-hidden="true">/</span>
            <a href="/blog">Articles</a>
            <span aria-hidden="true">/</span>
            <span>{article.title}</span>
        </nav>
        <article>
            <header>
                <p class="eyebrow">Benchmark field note</p>
                <h1>{article.title}</h1>
                <p class="dek">{article.description}</p>
                <div class="byline">
                    <span>By <a href="/about">Ame-888</a> · Ultimate Bench</span>
                    <time datetime={article.date}>{published}</time>
                    <span>{article.readingTime}</span>
                </div>
            </header>
            <div class="article-body">
                {article.sections.map((section) => (
                    <section>
                        <h2>{section.heading}</h2>
                        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                    </section>
                ))}
                <aside>
                    <strong>Keep the context attached.</strong> Ultimate Bench results are experimental snapshots. Review the <a href="/methodology">methodology and limitations</a> before using them in a decision.
                </aside>
            </div>
        </article>
    </main>
</Layout>

<style>
.article-page {
    max-width: 54rem;
    margin: auto;
    padding: 2.25rem 1.5rem 4.25rem;
}

.breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    color: var(--subtle);
    font-size: 0.8rem;
}

.breadcrumb span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

header {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
}

.eyebrow {
    margin: 0 0 0.55rem;
    color: var(--link);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.9rem, 4.2vw, 2.75rem);
    line-height: 1.16;
}

.dek {
    max-width: 46rem;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.75;
}

.byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.35rem;
    margin-top: 1.15rem;
    color: var(--subtle);
    font-size: 0.82rem;
}

.article-body {
    max-width: 45rem;
    margin: 2.25rem 0 0;
}

.article-body section {
    margin-bottom: 2.25rem;
}

h2 {
    margin: 0 0 0.75rem;
    font-size: 1.42rem;
}

section p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
}

aside {
    margin-top: 2.5rem;
    padding: 1.15rem 1.35rem;
    border: 1px solid var(--line-subtle);
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--surface);
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.72;
}

aside strong {
    color: var(--text);
}

@media (max-width: 640px) {
    .article-page {
        padding: 1.5rem 1rem 3rem;
    }
}
</style>
