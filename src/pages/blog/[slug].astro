---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';

export function getStaticPaths() {
    return articles.map(article => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const published = new Date(`${article.date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const articleJsonLd = { '@context':'https://schema.org', '@type':'Article', headline:article.title, description:article.description, datePublished:article.date, author:{'@type':'Person',name:'Ame-888',url:new URL('/about/',Astro.site).href}, publisher:{'@type':'Organization',name:'Ultimate Bench',url:new URL('/',Astro.site).href}, mainEntityOfPage:canonicalUrl };
const breadcrumbJsonLd = { '@context':'https://schema.org', '@type':'BreadcrumbList', itemListElement:[{ '@type':'ListItem',position:1,name:'Articles',item:new URL('/blog/',Astro.site).href},{'@type':'ListItem',position:2,name:article.title,item:canonicalUrl}] };
---

<Layout title={`${article.title} | Ultimate Bench`} description={article.description} ogType="article">
    <Fragment slot="head">
        <meta property="article:published_time" content={`${article.date}T00:00:00Z`} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd).replaceAll('<', '\\u003c')} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd).replaceAll('<', '\\u003c')} />
    </Fragment>
    <main class="article-page">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/guide">Guide</a><span aria-hidden="true">/</span><a href="/blog">Articles</a><span aria-hidden="true">/</span><span>{article.title}</span></nav>
        <article>
            <header>
                <p class="eyebrow">Benchmark field note</p>
                <h1>{article.title}</h1>
                <p class="dek">{article.description}</p>
                <div class="byline"><span>By <a href="/about">Ame-888</a> · Ultimate Bench</span><time datetime={article.date}>{published}</time><span>{article.readingTime}</span></div>
            </header>
            <div class="article-body">
                {article.sections.map(section => (
                    <section>
                        <h2>{section.heading}</h2>
                        {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
                    </section>
                ))}
                <aside><strong>Keep the context attached.</strong> Ultimate Bench results are experimental snapshots. Review the <a href="/methodology">methodology and limitations</a> before using them in a decision.</aside>
            </div>
        </article>
    </main>
</Layout>

<style>

.article-page{max-width:54rem;margin:auto;padding:2rem 1.5rem 4rem}.breadcrumb{display:flex;gap:.5rem;margin-bottom:2rem;color:var(--muted);font-size:.8rem}.breadcrumb span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
header{padding-bottom:1.75rem;border-bottom:1px solid var(--line)}.eyebrow{color:var(--muted);font-size:.8rem}h1{margin:.5rem 0 1rem;font-size:clamp(1.85rem,4vw,2.6rem);line-height:1.2}.dek{max-width:44rem;color:var(--muted);line-height:1.75}
.byline{display:flex;flex-wrap:wrap;gap:.5rem 1.25rem;margin-top:1rem;color:var(--muted);font-size:.8rem}.article-body{max-width:44rem;margin:2rem 0 0}.article-body section{margin-bottom:2rem}h2{font-size:1.4rem;margin:0 0 .7rem}section p{color:var(--muted);line-height:1.85}
aside{margin-top:2.5rem;padding:1rem 0;border-block:1px solid var(--line);color:var(--muted);font-size:.9rem;line-height:1.7}aside strong{color:var(--text)}
@media(max-width:640px){.article-page{padding:1.5rem 1rem 3rem}}

</style>
