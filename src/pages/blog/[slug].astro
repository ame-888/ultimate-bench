---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';

export function getStaticPaths() {
    return articles.map(article => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const published = new Date(`${article.date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Layout title={`${article.title} | Ultimate Bench`} description={article.description}>
    <Fragment slot="head">
        <meta property="og:type" content="article" />
        <meta property="article:published_time" content={`${article.date}T00:00:00Z`} />
    </Fragment>
    <main class="article-page">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/guide">Guide</a><span aria-hidden="true">/</span><a href="/blog">Articles</a><span aria-hidden="true">/</span><span>{article.title}</span></nav>
        <article>
            <header>
                <p class="eyebrow">Benchmark field note</p>
                <h1>{article.title}</h1>
                <p class="dek">{article.description}</p>
                <div class="byline"><span>By Ultimate Bench editors</span><time datetime={article.date}>{published}</time><span>{article.readingTime}</span></div>
            </header>
            <div class="article-body">
                {article.sections.map(section => (
                    <section>
                        <h2>{section.heading}</h2>
                        {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
                    </section>
                ))}
                <aside><strong>Keep the context attached.</strong> Ultimate Bench results are experimental snapshots. Review the <a href="/methodology">methodology and limitations</a> before using them in a decision.</aside>
            </div>
        </article>
    </main>
</Layout>

<style>
    .article-page { max-width: 70rem; margin: 0 auto; padding: 3rem 1.25rem 7rem; }
    .breadcrumb { display: flex; gap: .6rem; margin-bottom: 4rem; color: #64748b; font-size: .78rem; }
    .breadcrumb a { color: #93c5fd; } .breadcrumb span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    article { max-width: 54rem; margin: 0 auto; }
    header { padding-bottom: 2.5rem; border-bottom: 1px solid #293548; }
    .eyebrow { color: #67e8f9; font-size: .7rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
    h1 { margin: .8rem 0 1.3rem; color: #f8fafc; font-size: clamp(2.7rem,7vw,5.6rem); line-height: 1; letter-spacing: -.06em; }
    .dek { max-width: 45rem; color: #a8b5c7; font-size: 1.15rem; line-height: 1.75; }
    .byline { display: flex; flex-wrap: wrap; gap: .8rem 1.3rem; margin-top: 1.5rem; color: #718198; font-size: .75rem; }
    .article-body { max-width: 44rem; margin: 3.5rem auto 0; }
    section { margin-bottom: 3rem; }
    h2 { margin: 0 0 1.1rem; color: #eff6ff; font-size: clamp(1.6rem,4vw,2.25rem); line-height: 1.2; letter-spacing: -.035em; }
    section p { color: #b5c1d0; font-size: 1.02rem; line-height: 1.9; }
    aside { margin-top: 4rem; padding: 1.5rem; border: 1px solid #28506a; border-radius: .8rem; color: #9fb0c3; background: #0d1d2b; line-height: 1.7; }
    aside strong { color: #e0f2fe; } aside a { color: #67e8f9; }
</style>
