---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';
---

<Layout title="AI Benchmark Articles | Ultimate Bench" description="Editorial field notes about reading AI benchmarks, comparing model costs, and building evaluations for real-world decisions.">
    <main class="blog-page">
        <header>
            <p class="eyebrow">From the workbench</p>
            <h1>Articles</h1>
            <p class="intro">Longer editorial notes on benchmark literacy and private evaluation. New here? Start with the <a href="/guide">practical Ultimate Bench Guide</a>.</p>
        </header>
        <section class="article-grid" aria-labelledby="latest-title">
            <h2 id="latest-title">Latest articles</h2>
            {articles.map((article, index) => (
                <article class:list={{ featured: index === 0 }}>
                    <div class="article-meta"><time datetime={article.date}>{new Date(`${article.date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time><span>{article.readingTime}</span></div>
                    <h3><a href={`/blog/${article.slug}`}>{article.title}</a></h3>
                    <p>{article.description}</p>
                    <a class="read-link" href={`/blog/${article.slug}`} aria-label={`Read ${article.title}`}>Read article <span aria-hidden="true">→</span></a>
                </article>
            ))}
        </section>
        <aside><strong>Our editorial approach</strong><p>We publish explanatory material independently. Provider names are used for identification; coverage is not sponsored, and benchmark results are not endorsements.</p></aside>
    </main>
</Layout>

<style>

.blog-page { max-width: 64rem; margin: auto; padding: 2.75rem 1.5rem 4rem; }header{max-width:46rem;margin-bottom:2.5rem}
.eyebrow{color:var(--muted);font-size:.8rem;margin-bottom:.5rem}h1{margin:0 0 .8rem;font-size:clamp(1.85rem,4vw,2.6rem)}h1 span{color:inherit}.intro{color:var(--muted);line-height:1.75}
.article-grid>h2{font-size:1.2rem}.article-grid article{padding:1.5rem 0;border-top:1px solid var(--line)}
.article-meta{display:flex;flex-wrap:wrap;gap:1rem;color:var(--muted);font-size:.8rem}h3{margin:.5rem 0;font-size:1.3rem}h3 a{color:var(--text);text-decoration:none}h3 a:hover{text-decoration:underline}
article p{max-width:46rem;margin:.5rem 0;color:var(--muted);line-height:1.75}.read-link{display:inline-block;margin-top:.5rem;font-size:.85rem}
aside{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem}aside p{margin:.4rem 0;line-height:1.75}aside strong{color:var(--text)}
@media(max-width:640px){.blog-page{padding:1.75rem 1rem 3rem}}

</style>
