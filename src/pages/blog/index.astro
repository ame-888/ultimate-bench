---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';
---

<Layout title="AI Benchmark Articles | Ultimate Bench" description="Editorial field notes about reading AI benchmarks, comparing model costs, and building evaluations for real-world decisions.">
    <main class="blog-page">
        <header>
            <p class="eyebrow">From the workbench</p>
            <h1>Articles</h1>
            <p class="intro">Longer editorial notes on benchmark literacy and private evaluation. New here? Start with the <a href="/guide">practical Ultimate Bench Guide</a>.</p>
        </header>
        <section class="article-grid" aria-labelledby="latest-title">
            <h2 id="latest-title">Latest articles</h2>
            {articles.map((article, index) => (
                <article class:list={{ featured: index === 0 }}>
                    <div class="article-meta">
                        <time datetime={article.date}>
                            {new Date(`${article.date}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
                        </time>
                        <span>{article.readingTime}</span>
                    </div>
                    <h3><a href={`/blog/${article.slug}`}>{article.title}</a></h3>
                    <p>{article.description}</p>
                    <a class="read-link" href={`/blog/${article.slug}`} aria-label={`Read ${article.title}`}>
                        Read article <span aria-hidden="true">→</span>
                    </a>
                </article>
            ))}
        </section>
        <aside>
            <strong>Our editorial approach</strong>
            <p>We publish explanatory material independently. Provider names are used for identification; coverage is not sponsored, and benchmark results are not endorsements.</p>
        </aside>
    </main>
</Layout>

<style>
.blog-page {
    max-width: 64rem;
    margin: auto;
    padding: 2.75rem 1.5rem 4.25rem;
}

header {
    max-width: 48rem;
    margin-bottom: 2.5rem;
}

.eyebrow {
    margin: 0 0 0.5rem;
    color: var(--link);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4.4vw, 3.05rem);
    letter-spacing: -0.03em;
}

.intro {
    color: var(--muted);
    line-height: 1.75;
}

.article-grid > h2 {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.article-grid article {
    padding: 1.5rem 1.6rem;
    margin-bottom: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #101c31 0%, #0d1728 100%);
    box-shadow: var(--surface-highlight);
    transition: border-color var(--transition-fast);
}

.article-grid article.featured {
    border-left: 3px solid var(--accent);
}

.article-grid article:hover {
    border-color: var(--line-strong);
}

.article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    color: var(--subtle);
    font-size: 0.78rem;
}

h3 {
    margin: 0.5rem 0 0.55rem;
    font-size: 1.32rem;
}

h3 a {
    color: var(--text);
    text-decoration: none;
}

h3 a:hover {
    color: var(--link);
    text-decoration: underline;
}

article p {
    max-width: 48rem;
    margin: 0.5rem 0;
    color: var(--muted);
    line-height: 1.75;
}

.read-link {
    display: inline-block;
    margin-top: 0.65rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
}

.read-link:hover {
    text-decoration: underline;
}

aside {
    margin-top: 2.25rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.88rem;
}

aside p {
    margin: 0.4rem 0 0;
    line-height: 1.72;
}

aside strong {
    color: var(--text);
}

@media (max-width: 640px) {
    .blog-page {
        padding: 1.75rem 1rem 3rem;
    }

    .article-grid article {
        padding: 1.25rem;
    }
}
</style>
