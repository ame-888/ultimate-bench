---
import Layout from '../layouts/Layout.astro';
import '../styles/explorer-pages.css';

const missions = [
    { icon: '01', title: 'Name the actual job', copy: 'Replace “best model” with a verb: extract, reason, draft, classify, inspect, or plan. A concrete job makes evidence relevant.' },
    { icon: '02', title: 'Set your guardrails', copy: 'Write down must-haves before testing: accuracy floor, budget, response time, context size, privacy needs, and human-review capacity.' },
    { icon: '03', title: 'Build a tiny trial', copy: 'Collect 10–20 representative cases, including messy inputs and expensive failure modes. Keep the rubric short enough to apply consistently.' },
    { icon: '04', title: 'Shortlist by shape', copy: 'Use benchmark categories to find models whose strengths resemble your task. Prefer relevant capability over an unrelated overall lead.' },
    { icon: '05', title: 'Test blind, then inspect', copy: 'Score outputs without model names when possible. Afterward, inspect errors—not just averages—to learn which failures you can tolerate.' },
    { icon: '06', title: 'Recheck the winner', copy: 'Run the finalist on fresh cases and monitor it after launch. Models, prompts, and real-world inputs all drift over time.' },
];
---

<Layout title="Field Guide | Ultimate Bench" description="A six-step field guide for turning AI benchmark results into a practical, responsible model choice.">
    <main class="explorer-page guide-page">
        <header class="explorer-hero">
            <p class="explorer-kicker">Pack before you pick</p>
            <h1>From leaderboard<br />to <em>real-world fit.</em></h1>
            <p class="explorer-deck">The top-ranked model is not automatically your best tool. This compact field guide helps you turn public evidence into a small, honest evaluation built around the work you actually need done.</p>
            <div class="explorer-meta" aria-label="Guide qualities"><span>6 practical steps</span><span>No special tooling</span><span>Built for small teams</span></div>
        </header>

        <section aria-labelledby="guide-title">
            <div class="section-head">
                <div><small>Your expedition plan</small><h2 id="guide-title">Choose with evidence, not altitude.</h2></div>
                <p>Start with the mission, use benchmarks to scout, and finish with your own trial. The process matters more than finding one universal winner.</p>
            </div>
            <ol class="explorer-grid guide-grid">
                {missions.map((mission) => <li class="explorer-card"><span class="icon" aria-hidden="true">{mission.icon}</span><h3>{mission.title}</h3><p>{mission.copy}</p></li>)}
            </ol>
        </section>

        <aside class="callout">
            <div><small>Pocket rule</small><h2>Benchmark broadly. Validate narrowly.</h2><p>A public score earns a model a place in your trial—not a permanent place in your stack.</p></div>
            <a href="/methodology">See our method →</a>
        </aside>
    </main>
</Layout>

<style>
    .guide-page { --accent: #bef264; --accent-rgb: 190, 242, 100; }
    .guide-grid { margin: 0; padding: 0; list-style: none; counter-reset: guide; }
    .guide-grid .icon { width: auto; padding: 0 .7rem; font: 800 .72rem var(--font-body); letter-spacing: .12em; }
</style>
