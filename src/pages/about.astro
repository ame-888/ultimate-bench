---
import Layout from '../layouts/Layout.astro';

const principles = [
    {
        number: '01',
        title: 'Curiosity first',
        copy: 'Each evaluation starts with a focused question and an experiment that lets the results do the talking.',
        icon: '◇',
    },
    {
        number: '02',
        title: 'Context included',
        copy: 'A score without a story is just a number wearing a tiny hat. Ultimate Bench shows the method and the limits.',
        icon: '≋',
    },
    {
        number: '03',
        title: 'Independently minded',
        copy: 'No model gets the home-team treatment. Every system meets the same task and the same rubric.',
        icon: '↗',
    },
];
---

<Layout title="About | Ultimate Bench" description="Learn about Ultimate Bench, its independent operator, evaluation principles, and content rights.">
    <main class="about-page">
        <div class="ambient ambient-one" aria-hidden="true"></div>
        <div class="ambient ambient-two" aria-hidden="true"></div>

        <section class="hero" aria-labelledby="about-title">
            <div class="eyebrow"><span class="status-dot"></span> Independent by design</div>
            <h1 id="about-title">About Ultimate Bench</h1>
            <p class="hero-copy" id="about-desc1">Ultimate Bench is an independent experimental benchmark comparing AI model results across visual, data retrieval, and chess tasks.</p>
            <div class="hero-actions">
                <a class="primary-link" href="/methodology">Inspect the method</a>
                <a class="text-link" href="/">See the leaderboard</a>
            </div>
        </section>

        <section class="transparency" aria-labelledby="rights-title">
            <div class="transparency-heading"><p>SOURCE &amp; RIGHTS</p><h2 id="rights-title">Open code, protected content.</h2></div>
            <div class="transparency-content"><p>The repository's original software code is available under the MIT License, so it may be inspected, forked, modified, and redistributed under those terms. Benchmark datasets and results, protocols and prompts, protected test material, branding, editorial text, and non-code assets remain all rights reserved unless a file says otherwise.</p><p>Public results may be referenced or quoted with attribution, but there is no general open-data license. See the repository <a href="https://github.com/ame-888/ultimate-bench/blob/main/LICENSE">LICENSE</a> and <a href="https://github.com/ame-888/ultimate-bench/blob/main/RIGHTS-NOTICE.md">rights notice</a>.</p></div>
        </section>

        <section class="manifesto" aria-labelledby="about-welcome">
            <div class="manifesto-label"><span>THE SHORT VERSION</span><span class="squiggle" aria-hidden="true">⌁⌁⌁</span></div>
            <div class="manifesto-copy">
                <h2 id="about-welcome">Why this project exists</h2>
                <p id="about-desc2">Ultimate Bench presents practical evaluations that make model capabilities—and their awkward edges—easier to understand. The goal is not to crown a permanent champion. It is to offer a useful snapshot, explain how it was made, and leave enough breadcrumbs for you to challenge it.</p>
            </div>
        </section>

        <section class="principles" aria-labelledby="principles-title">
            <div class="section-heading">
                <p>HOUSE RULES</p>
                <h2 id="principles-title">Project principles</h2>
            </div>
            <div class="principle-grid">
                {principles.map((principle) => (
                    <article class="principle-card">
                        <div class="card-top">
                            <span class="card-number">{principle.number}</span>
                            <span class="card-icon" aria-hidden="true">{principle.icon}</span>
                        </div>
                        <h3>{principle.title}</h3>
                        <p>{principle.copy}</p>
                    </article>
                ))}
            </div>
        </section>

        <section class="transparency" aria-labelledby="transparency-title">
            <div class="transparency-heading">
                <p>BEHIND THE BENCH</p>
                <h2 id="transparency-title">Operator &amp; Transparency</h2>
            </div>
            <div class="transparency-content">
                <p><strong>Ultimate Bench is an independent benchmark project created and maintained by <a href="https://github.com/ame-888" target="_blank" rel="noopener noreferrer">Ame-888</a>.</strong> It is currently a solo project with no affiliation, sponsorship, or funding from any AI model provider.</p>
                <p>Ame-888 designs and maintains the project. Its methodology and limitations are publicly documented, and corrections are welcomed through <a href="/contact">Contact</a>. No AI model provider controls benchmark scoring or ranking. Advertising, if displayed, does not influence benchmark results or editorial conclusions.</p>
                <div class="transparency-links" aria-label="Operator and project links">
                    <a href="https://github.com/ame-888" target="_blank" rel="noopener noreferrer">View Ame-888 on GitHub<span class="sr-only"> (opens in a new tab)</span></a>
                    <a href="https://github.com/ame-888/ultimate-bench" target="_blank" rel="noopener noreferrer">View the Ultimate Bench source code<span class="sr-only"> (opens in a new tab)</span></a>
                    <a href="/contact">Report an error or suggest a correction</a>
                </div>
            </div>
        </section>

        <aside class="field-note" aria-label="A note from the bench">
            <div class="note-tab">FIELD NOTE № 001</div>
            <p>Good evaluation is a practice, not a finish line.</p>
            <span id="secret-hint">Corrections and methodological criticism are welcome.</span>
        </aside>
    </main>
</Layout>

<style>

.about-page { max-width: 68rem; margin: auto; padding: 2.75rem 1.5rem 4rem; color: var(--muted); }
.ambient, .status-dot, .squiggle, .card-icon { display: none; }
.hero { max-width: 48rem; margin-bottom: 2.5rem; }
.eyebrow { color: #a5b4fc; font-weight: 700; letter-spacing: .06em; font-size: .75rem; margin-bottom: .5rem; }
h1 { margin: 0 0 .75rem; font-size: clamp(2rem, 4.5vw, 3.1rem); letter-spacing: -.035em; }
.hero-copy { line-height: 1.75; }
.hero-actions { display: flex; flex-wrap: wrap; gap: 1.25rem; margin-top: 1rem; font-size: .9rem; }
.hero-actions a { color: var(--link); }.hero-actions .primary-link { padding: .55rem .85rem; border: 1px solid #526397; border-radius: 8px; background: #222d4d; color: #d5dcff; text-decoration: none; }.hero-actions { align-items: center; }
.transparency, .manifesto, .principles { padding: 2rem 0; border-top: 1px solid var(--line); }
.transparency { padding: 1.5rem; margin-bottom: 1.25rem; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); display: grid; grid-template-columns: 15rem minmax(0,1fr); gap: 2rem; }
.transparency h2, .section-heading h2, .manifesto h2 { margin: .4rem 0 1rem; font-size: 1.4rem; }
.transparency-heading > p, .section-heading > p, .manifesto-label { color: var(--muted); font-size: .78rem; }
.transparency-content p, .manifesto-copy p, .principle-card p { margin-top: 0; line-height: 1.75; }
.transparency-links { display: flex; flex-direction: column; align-items: flex-start; gap: .6rem; font-size: .85rem; }
.manifesto-copy { max-width: 46rem; }.manifesto-copy em { color: inherit; font-style: normal; }
.principle-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 2rem; }
.principle-card { padding: 1.25rem; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }.card-number { color: #a5b4fc; font-size: .8rem; font-weight: 700; }
.principle-card h3 { margin: .5rem 0; font-size: 1.05rem; }.principle-card p { font-size: .9rem; }
.field-note { margin-top: 1rem; padding: 1rem 1.25rem; border-left: 3px solid #a5b4fc; border-radius: 0 10px 10px 0; background: var(--panel); font-size: .85rem; }.note-tab { display: none; }.field-note p { color: var(--text); }
@media(max-width:700px){.about-page{padding:1.75rem 1rem 3rem}.transparency,.principle-grid{grid-template-columns:1fr;gap:.75rem}}

</style>
