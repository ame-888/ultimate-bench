---
import Layout from '../layouts/Layout.astro';

const principles = [
    {
        number: '01',
        title: 'Curiosity first',
        copy: 'We ask focused questions, then build experiments that let the results do the talking.',
        icon: '?',
    },
    {
        number: '02',
        title: 'Context included',
        copy: 'A score without a story is just a number wearing a tiny hat. We show the method and the limits.',
        icon: '≋',
    },
    {
        number: '03',
        title: 'Independently minded',
        copy: 'No model gets the home-team treatment. Every system meets the same task and the same rubric.',
        icon: '↗',
    },
];
---

<Layout title="About | Ultimate Bench" description="Meet Ultimate Bench: an independent experimental benchmark built to make AI model comparisons clearer, more useful, and a little less beige.">
    <main class="about-page">
        <div class="ambient ambient-one" aria-hidden="true"></div>
        <div class="ambient ambient-two" aria-hidden="true"></div>

        <section class="hero" aria-labelledby="about-title">
            <div class="eyebrow"><span class="status-dot"></span> Independent by design</div>
            <h1 id="about-title">We put AI models<br />on the <span>workbench.</span></h1>
            <p class="hero-copy" id="about-desc1">Ultimate Bench is an independent experimental benchmark for AI models—built for people who want more than a shiny score and a victory lap.</p>
            <div class="hero-actions">
                <a class="primary-link" href="/methodology">Inspect the method <span aria-hidden="true">↗</span></a>
                <a class="text-link" href="/">See the leaderboard <span aria-hidden="true">→</span></a>
            </div>
        </section>

        <section class="manifesto" aria-labelledby="about-welcome">
            <div class="manifesto-label"><span>THE SHORT VERSION</span><span class="squiggle" aria-hidden="true">⌁⌁⌁</span></div>
            <div class="manifesto-copy">
                <h2 id="about-welcome">Benchmarks should illuminate,<br /><em>not decorate.</em></h2>
                <p id="about-desc2">We design practical evaluations that make model capabilities—and their awkward edges—easier to understand. The goal is not to crown a permanent champion. It is to offer a useful snapshot, explain how we made it, and leave enough breadcrumbs for you to challenge it.</p>
            </div>
        </section>

        <section class="principles" aria-labelledby="principles-title">
            <div class="section-heading">
                <p>HOUSE RULES</p>
                <h2 id="principles-title">How we keep the bolts tight.</h2>
            </div>
            <div class="principle-grid">
                {principles.map((principle) => (
                    <article class="principle-card">
                        <div class="card-top">
                            <span class="card-number">{principle.number}</span>
                            <span class="card-icon" aria-hidden="true">{principle.icon}</span>
                        </div>
                        <h3>{principle.title}</h3>
                        <p>{principle.copy}</p>
                    </article>
                ))}
            </div>
        </section>

        <aside class="field-note" aria-label="A note from the bench">
            <div class="note-tab">FIELD NOTE № 001</div>
            <p>Good evaluation is a practice, not a finish line.</p>
            <span id="secret-hint">Keep exploring. The lab has a few loose floorboards.</span>
        </aside>
    </main>
</Layout>

<style>
    .about-page {
        --ink: #f4f1e8;
        --muted: #a9b0bd;
        --orange: #ff7a45;
        --lime: #c7f36b;
        position: relative;
        overflow: hidden;
        max-width: 78rem;
        margin: 0 auto;
        padding: clamp(5rem, 10vw, 8.5rem) 1.5rem 8rem;
    }

    .ambient { position: absolute; border-radius: 50%; filter: blur(1px); pointer-events: none; }
    .ambient-one { width: 32rem; height: 32rem; top: -13rem; right: -12rem; background: radial-gradient(circle, rgba(255, 122, 69, .13), transparent 68%); }
    .ambient-two { width: 30rem; height: 30rem; top: 37rem; left: -18rem; background: radial-gradient(circle, rgba(199, 243, 107, .08), transparent 68%); }

    .hero { position: relative; max-width: 63rem; padding-bottom: clamp(5rem, 10vw, 9rem); }
    .eyebrow { display: inline-flex; align-items: center; gap: .65rem; margin-bottom: 1.75rem; color: #cbd1dc; font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
    .status-dot { width: .55rem; height: .55rem; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 5px rgba(199, 243, 107, .1); }
    h1 { margin: 0; color: var(--ink); font-size: clamp(3.6rem, 9vw, 7.5rem); line-height: .94; letter-spacing: -.07em; }
    h1 span { position: relative; color: var(--orange); font-style: italic; font-weight: 600; }
    h1 span::after { content: ''; position: absolute; left: 2%; right: -2%; bottom: -.08em; height: .08em; border-radius: 50%; background: var(--orange); transform: rotate(-1deg); opacity: .65; }
    .hero-copy { max-width: 43rem; margin: 2.4rem 0 0; color: var(--muted); font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.75; }
    .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.75rem; margin-top: 2.3rem; }
    .hero-actions a { font-weight: 700; text-decoration: none; }
    .primary-link { display: inline-flex; align-items: center; gap: 1.25rem; padding: .9rem 1.1rem .9rem 1.25rem; border-radius: .45rem; color: #111827; background: var(--lime); box-shadow: 5px 5px 0 rgba(199, 243, 107, .17); transition: transform .2s ease, box-shadow .2s ease; }
    .primary-link:hover { transform: translate(-2px, -2px); box-shadow: 7px 7px 0 rgba(199, 243, 107, .2); }
    .primary-link span { font-size: 1.2rem; }
    .text-link { color: var(--ink); border-bottom: 1px solid #5d6572; padding-bottom: .3rem; transition: color .2s ease, border-color .2s ease; }
    .text-link:hover { color: var(--orange); border-color: var(--orange); }

    .manifesto { display: grid; grid-template-columns: minmax(9rem, .6fr) 2fr; gap: clamp(2rem, 7vw, 7rem); padding: clamp(3rem, 7vw, 5rem) 0; border-top: 1px solid #303846; border-bottom: 1px solid #303846; }
    .manifesto-label { display: flex; flex-direction: column; gap: .75rem; color: var(--orange); font-size: .68rem; font-weight: 800; letter-spacing: .16em; }
    .squiggle { font-size: 1.5rem; letter-spacing: -.15em; }
    .manifesto-copy h2 { margin: 0 0 2rem; color: var(--ink); font-size: clamp(2rem, 5vw, 4.1rem); line-height: 1.07; letter-spacing: -.055em; }
    .manifesto-copy h2 em { color: var(--lime); font-weight: 600; }
    .manifesto-copy p { max-width: 47rem; margin: 0; color: var(--muted); font-size: 1.05rem; line-height: 1.85; }

    .principles { padding: clamp(5rem, 9vw, 8rem) 0; }
    .section-heading p { margin: 0 0 .8rem; color: var(--orange); font-size: .68rem; font-weight: 800; letter-spacing: .18em; }
    .section-heading h2 { margin: 0 0 2.5rem; color: var(--ink); font-size: clamp(2rem, 4vw, 3.4rem); letter-spacing: -.045em; }
    .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .principle-card { min-height: 17rem; padding: 1.6rem; border: 1px solid #333c4b; border-radius: .75rem; background: rgba(23, 32, 47, .68); box-shadow: inset 0 1px rgba(255,255,255,.03); transition: border-color .25s ease, transform .25s ease; }
    .principle-card:hover { transform: translateY(-4px) rotate(-.25deg); border-color: rgba(199, 243, 107, .55); }
    .card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 3.5rem; }
    .card-number { color: #737d8d; font-family: monospace; font-size: .8rem; }
    .card-icon { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 1px solid #455064; border-radius: 50%; color: var(--lime); font-size: 1.15rem; }
    .principle-card h3 { margin: 0 0 .8rem; color: var(--ink); font-size: 1.25rem; }
    .principle-card p { margin: 0; color: var(--muted); font-size: .92rem; line-height: 1.7; }

    .field-note { position: relative; margin: 0 0 1rem auto; max-width: 45rem; padding: 2.75rem clamp(1.5rem, 5vw, 3.5rem) 2rem; border: 1px solid rgba(255, 122, 69, .45); background: linear-gradient(105deg, rgba(255, 122, 69, .08), rgba(199, 243, 107, .04)); transform: rotate(-.6deg); }
    .note-tab { position: absolute; top: 0; left: 1.5rem; padding: .4rem .7rem; color: #111827; background: var(--orange); font-size: .62rem; font-weight: 900; letter-spacing: .12em; transform: translateY(-50%); }
    .field-note p { margin: 0 0 .55rem; color: var(--ink); font-family: var(--font-heading); font-size: clamp(1.2rem, 3vw, 1.75rem); font-weight: 700; }
    .field-note span { color: #929baa; font-size: .85rem; font-style: italic; }

    @media (max-width: 760px) {
        .about-page { padding-top: 4rem; }
        .manifesto { grid-template-columns: 1fr; gap: 1.5rem; }
        .manifesto-label { flex-direction: row; align-items: center; }
        .principle-grid { grid-template-columns: 1fr; }
        .principle-card { min-height: auto; }
        .card-top { margin-bottom: 2rem; }
    }

    @media (prefers-reduced-motion: reduce) {
        .primary-link, .principle-card { transition: none; }
    }
</style>
