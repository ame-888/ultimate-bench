---
import Layout from '../layouts/Layout.astro';
import '../styles/content-pages.css';
---

<Layout title="Contact | Ultimate Bench" description="Contact Ultimate Bench with questions, concerns, or feedback about the benchmark and website.">
    <main class="content-page contact-page" style="--page-accent: #34d399; --page-accent-rgb: 52, 211, 153;">
        <header class="page-heading">
            <span class="page-kicker">A direct line to the project</span>
            <h1 id="contact-title">Contact Ultimate Bench</h1>
            <p>Questions, corrections, or feedback can help make the benchmark better.</p>
        </header>
        <section class="content-card contact-container">
            <p>Ultimate Bench is independently maintained under the public pseudonym Ame-888. Messages concerning corrections, methodology, reproducibility, or collaboration are welcome.</p>

            <div class="contact-methods">
                <div class="contact-method">
                    <div class="mail-icon" aria-hidden="true">✦</div>
                    <span class="method-label">General contact</span>
                    <h2>Email Ultimate Bench</h2>
                    <p>For benchmark corrections, methodology criticism, reproducibility questions, data issues, collaboration inquiries, or website problems:</p>
                    <a href="mailto:ultimatebench.contact@gmail.com" class="email-link">ultimatebench.contact@gmail.com</a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>

.contact-methods { margin-top: 2rem; }.contact-method { max-width: 40rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: 12px; background: var(--color-bg); }.mail-icon { display: none; }
.method-label { color: #6ee7b7; font-size: .75rem; font-weight: 700; letter-spacing: .06em; }.contact-method h2 { margin: .4rem 0 .75rem; }
.email-link { display: inline-block; overflow-wrap: anywhere; margin-top: .4rem; color: #6ee7b7; font-size: 1rem; font-weight: 600; }

</style>
