---
import Layout from '../layouts/Layout.astro';
import '../styles/content-pages.css';
---

<Layout title="Contact | Ultimate Bench" description="Contact Ultimate Bench with questions, concerns, or feedback about the benchmark and website.">
    <main class="content-page contact-page" style="--page-accent: #34d399; --page-accent-rgb: 52, 211, 153;">
        <header class="page-heading">
            <span class="page-kicker">A direct line to the project</span>
            <h1 id="contact-title">Contact Ultimate Bench</h1>
            <p>Questions, corrections, or feedback can help make the benchmark better.</p>
        </header>
        <section class="content-card contact-container">
            <p>Ultimate Bench is independently maintained under the public pseudonym Ame-888. Messages concerning corrections, methodology, reproducibility, or collaboration are welcome.</p>

            <div class="contact-methods">
                <div class="contact-method">
                    <div class="mail-icon" aria-hidden="true">✦</div>
                    <span class="method-label">General contact</span>
                    <h2>Email Ultimate Bench</h2>
                    <p>For benchmark corrections, methodology criticism, reproducibility questions, data issues, collaboration inquiries, or website problems:</p>
                    <a href="mailto:ultimatebench.contact@gmail.com" class="email-link">ultimatebench.contact@gmail.com</a>
                </div>
            </div>
        </section>
    </main>
</Layout>

<style>
    .contact-container {
        text-align: center;
    }

    .contact-methods {
        margin-top: 2rem;
        display: flex;
        justify-content: center;
    }

    .contact-method {
        width: min(32rem, 100%);
        padding: clamp(1.75rem, 5vw, 3rem);
        border: 1px solid rgba(52, 211, 153, .24);
        border-radius: 1.25rem;
        background: linear-gradient(145deg, rgba(15, 23, 42, .8), rgba(16, 38, 43, .55));
        box-shadow: 0 18px 45px rgba(0, 0, 0, .2), inset 0 1px rgba(255, 255, 255, .04);
    }

    .mail-icon {
        display: grid;
        place-items: center;
        width: 3.25rem;
        height: 3.25rem;
        margin: 0 auto 1rem;
        border: 1px solid rgba(52, 211, 153, .35);
        border-radius: 1rem;
        color: #6ee7b7;
        background: rgba(52, 211, 153, .08);
        box-shadow: 0 0 28px rgba(52, 211, 153, .12);
    }

    .method-label {
        color: #6ee7b7;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .contact-method h2 {
        font-size: 1.5rem;
        color: #fff;
        margin-top: .35rem;
        margin-bottom: 1rem;
        font-weight: 700;
    }

    .email-link {
        display: inline-block;
        overflow-wrap: anywhere;
        margin-top: 1rem;
        font-size: 1.25rem;
        font-weight: 600;
        color: #6ee7b7;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .email-link:hover {
        color: #d1fae5;
        text-decoration: underline;
    }
</style>
