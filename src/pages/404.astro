---
import Layout from '../layouts/Layout.astro';
import '../styles/content-pages.css';
---
<Layout title="Page not found | Ultimate Bench" description="Find the Ultimate Bench leaderboard, methodology, and practical guide." robots="noindex">
    <main class="content-page">
        <header class="page-heading">
            <p class="page-kicker">404 · Page not found</p>
            <h1>Find your next step.</h1>
            <p>This address does not match a page on Ultimate Bench.</p>
        </header>
        <section class="content-card not-found-links" aria-label="Continue exploring">
            <p><a href="/">Explore the leaderboard</a></p>
            <p><a href="/methodology/">Read the methodology</a></p>
            <p><a href="/guide/">Open the practical guide</a></p>
        </section>
    </main>
</Layout>

<style>
.not-found-links {
    display: grid;
    gap: 0.75rem;
}

.not-found-links p {
    margin: 0;
}

.not-found-links a {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
}

.not-found-links a:hover {
    border-color: var(--link);
    background: var(--panel-elevated);
}
</style>
