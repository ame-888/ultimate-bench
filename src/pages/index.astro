                                                        </div>
                                                    </div>
                                                </div>
                                            )}
                                        </div>

                                        {/* Challenge Columns */}
                                        <div class="benchmark-cell score-cell worm-score" style="flex: 1;"><span class={` ${item.worm === 0 || item.worm === 'INVALID' ? 'zero-score-glow' : ''} ${item.worm === bestDataAiScores.worm && item.worm > 0 ? 'best-score-glow' : ''}`}>{item.worm !== undefined ? (typeof item.worm === 'string' ? item.worm : `${item.worm}%`) : ''}</span></div>
                                        <div class="benchmark-cell score-cell koala-score" style="flex: 1;"><span class={` ${item.koala === 0 || item.koala === 'INVALID' ? 'zero-score-glow' : ''} ${item.koala === bestDataAiScores.koala && item.koala > 0 ? 'best-score-glow' : ''}`}>{item.koala !== undefined ? (typeof item.koala === 'string' ? <span style="color: #9CA3AF; font-size: 0.75rem;">{item.koala}</span> : `${item.koala}%`) : ''}</span></div>
                                        <div class="benchmark-cell score-cell crow-score" style="flex: 1;"><span class={` ${item.crow === 0 || item.crow === 'INVALID' ? 'zero-score-glow' : ''} ${item.crow === bestDataAiScores.crow && item.crow > 0 ? 'best-score-glow' : ''}`}>{item.crow !== undefined ? (typeof item.crow === 'string' ? <span style="color: #9CA3AF; font-size: 0.75rem;">{item.crow}</span> : `${item.crow}%`) : ''}</span></div>
                                        <div class="benchmark-cell score-cell octopus-score" style="flex: 1;"><span class={` ${item.octopus === 0 || item.octopus === 'INVALID' ? 'zero-score-glow' : ''} ${item.octopus === bestDataAiScores.octopus && item.octopus > 0 ? 'best-score-glow' : ''}`}>{item.octopus !== undefined ? (typeof item.octopus === 'string' ? <span style="color: #9CA3AF; font-size: 0.75rem;">{item.octopus}</span> : `${item.octopus}%`) : ''}</span></div>
                                        <div class="benchmark-cell score-cell raven-score" style="flex: 1;"><span class="raven-text">?</span></div>
                                        <div class="benchmark-cell score-cell athena-score" style="flex: 1;"><span class="athena-text">?</span></div>
                                    </div>
                                );
                                })}
                            </div>
                            <p class="disclaimer">INVALID: The model was unable to consistently answer the test, even if incorrectly.<br>UNAVAILABLE: The model was unavailable for testing, and therefore the score couldn't be measured.</p>
                            <p class="disclaimer" style="padding-bottom: 2rem;">Claude 5 Fable (high): Incomplete testing due to low limits. That being said, the final score should not be much different.</p>
