                        .sota-node-dot i { width:5px; height:5px; border-radius:50%; background:#64748B; }
                        .sota-node-label { position:absolute; right:calc(50% + 24px); display:flex; align-items:center; gap:.55rem; transform:translateY(-50%); white-space:nowrap; transition:.25s ease; }
                        .sota-node-label b { color:#94A3B8; font-size:.72rem; letter-spacing:.1em; }
                        .sota-node-label small { order:-1; color:#64748B; font:600 .65rem monospace; }
