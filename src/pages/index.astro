    /* Showpiece leaderboard — editorial, high-contrast, and built around the result. */
    .ultimate-bench-section { max-width: 86rem; margin-inline: auto; }
    .ultimate-bench-section .ultimate-title-container {
        display: flex; flex-direction: column; align-items: center; min-height: 30rem;
        margin-bottom: 0 !important; padding: clamp(3rem, 7vw, 6.5rem) clamp(1.25rem, 5vw, 5rem) 2rem;
        border: 1px solid rgba(251,191,36,.24); border-radius: 28px 28px 0 0; overflow: hidden;
        background: radial-gradient(circle at 50% 35%, rgba(245,158,11,.19), transparent 31%),
                    radial-gradient(circle at 10% 0%, rgba(56,189,248,.08), transparent 25%), #080d17;
    }
    .ultimate-bench-section .ultimate-title-container::before { width: 70rem; height: 70rem; opacity: .34; }
    .ultimate-sigil { position: relative; z-index: 2; display: grid; place-items: center; width: 4.25rem; height: 4.25rem; margin-bottom: 1.75rem; transform: rotate(45deg); border: 1px solid #fbbf24; background: #111827; box-shadow: 0 0 0 8px rgba(251,191,36,.05), 0 0 40px rgba(245,158,11,.2); }
