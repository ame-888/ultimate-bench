                        .journey-mini-track span { display:block; height:100%; border-radius:inherit; background:linear-gradient(90deg,#8B5CF6,#38BDF8); box-shadow:0 0 12px #60A5FA; animation:growBar 1.2s ease-out both; }
                        .journey-stat-foot { display:flex; justify-content:space-between; margin-top:.55rem; color:#475569; font-size:.55rem; text-transform:uppercase; }
                        .sota-loading-container { position:relative; height:550px; }
                        .sota-bar-track { position:absolute; left:50%; width:8px; height:100%; transform:translateX(-50%); border:1px solid #263855; border-radius:10px; background:#071224; box-shadow:inset 0 0 8px #000; }
                        .sota-bar-fill { position:absolute; bottom:0; left:-1px; width:calc(100% + 2px); border-radius:10px; background:linear-gradient(to top,#2563EB,#A855F7,#F59E0B); box-shadow:0 0 22px rgba(168,85,247,.6); animation:growUp 1.4s cubic-bezier(.2,.8,.2,1) both; }
                        .sota-rocket-indicator { position:absolute; top:0; left:50%; display:grid; place-items:center; width:54px; height:54px; transform:translate(-50%,-50%); border:1px solid rgba(96,165,250,.5); border-radius:50%; background:rgba(8,18,36,.88); box-shadow:0 0 0 7px rgba(59,130,246,.07),0 0 30px rgba(96,165,250,.45); }
                        .sota-rocket-indicator svg { transform:rotate(-43deg); filter:drop-shadow(0 0 5px rgba(255,255,255,.5)); }
                        .rocket-orbit { position:absolute; inset:-8px; border:1px dashed rgba(147,197,253,.3); border-radius:50%; animation:orbit 9s linear infinite; }
                        .sota-nodes-container { position:absolute; inset:0; pointer-events:none; }
