        <div class="leaderboard-grid">
            <!-- Benchmarks Section -->
            <section class="leaderboard-section full-width">

                <!-- Modal Container -->
                <div id="benchmark-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-label="Arena details">
                    <div class="modal-content">
                        <button id="benchmark-modal-close" class="modal-close-btn" aria-label="Close arena details">&times;</button>
                        <div id="benchmark-modal-body"></div>
                    </div>
                </div>

                <!-- Achievements Modal Container -->
                <div id="achievements-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="achievements-title">
                    <div class="modal-content achievements-content glass-panel">
                        <button id="achievements-modal-close" class="modal-close-btn" aria-label="Close achievements">&times;</button>
                        <div class="achievements-eyebrow"><span></span> LIVE LEADERBOARD HONORS <span></span></div>
                        <h2 class="achievements-title" id="achievements-title">Hall of Achievements</h2>
                        <p class="achievements-subtitle">Records, rivalries, and remarkable benchmark runs.</p>
                        <div class="achievements-summary" aria-label="Achievement summary">
                            <div><strong>10</strong><span>awards</span></div>
                            <div><strong>3</strong><span>arenas</span></div>
                            <div><strong>Live</strong><span>rankings</span></div>
                        </div>

                        <div class="achievements-grid">
                            <div class="achievement-card sota-card">
                                <div class="ach-ribbon">THE CROWN</div><div class="ach-icon">♛</div>
                                <h3>Current Ultimate Bench leader</h3>
                                <p>Highest Overall score in the current published dataset.</p>
