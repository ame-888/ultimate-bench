                                        <button
                                            class:list={['sota-node', 'sota-node-interactive', { reached: sotaScore >= milestone.score, current: milestone.score === 20 }]}
                                            style={`--top:${100 - milestone.score}%;--milestone:${milestone.color}`}
                                            data-milestone={milestone.name}
                                            type="button"
                                            aria-label={`Explore ${milestone.name}, ${milestone.score}% milestone`}
