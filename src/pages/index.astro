        max-width: 800px;
        margin: 0 auto 2rem auto;
        color: #D1D5DB;
        line-height: 1.6;
        font-size: 1.05rem;
        text-align: left;
        background: rgba(31, 41, 55, 0.4);
        padding: 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .benchmark-description p {
        margin-bottom: 1rem;
    }

    .benchmark-description p:last-child {
        margin-bottom: 0;
    }

    .benchmark-description ul {
        list-style-type: disc;
        margin-left: 2rem;
        margin-bottom: 1rem;
        color: #9CA3AF;
    }

    .benchmark-description li {
        margin-bottom: 0.25rem;
    }

    /* Ranking Controls Styles */
    .ranking-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        color: #D1D5DB;
        font-size: 0.95rem;
    }

    .ranking-select {
        background: rgba(31, 41, 55, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #fff;
        padding: 0.4rem 0.8rem;
        border-radius: 0.375rem;
        font-size: 0.95rem;
        cursor: pointer;
        outline: none;
    }

    .ranking-select:hover, .ranking-select:focus {
        border-color: #F59E0B;
    }

    .tooltip-container {
        position: relative;
        display: inline-flex;
        align-items: center;
        cursor: help;
    }

    .tooltip-icon {
        font-size: 1.1rem;
        opacity: 0.8;
    }

    .tooltip-icon:hover {
        opacity: 1;
    }

    .tooltip-text {
        visibility: hidden;
        width: 260px;
        max-width: 80vw;
        background-color: #1F2937;
        color: #F3F4F6;
        text-align: center;
        border-radius: 0.375rem;
        padding: 0.75rem;
        position: absolute;
        z-index: 10000;
        bottom: 125%;
        left: 50%;
        margin-left: -130px;
        opacity: 0;
        transition: opacity 0.3s;
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
        font-size: 0.85rem;
        line-height: 1.4;
    }

    .tooltip-text::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: #1F2937 transparent transparent transparent;
    }


    /* Prevent tooltips from overflowing on right edge */
    @media (max-width: 768px) {
        .col-header:nth-last-child(1) .tooltip-text,
        .col-header:nth-last-child(2) .tooltip-text {
            left: auto;
            right: -10px;
            margin-left: 0;
            transform: none;
        }
        .col-header:nth-last-child(1) .tooltip-text::after,
        .col-header:nth-last-child(2) .tooltip-text::after {
            left: auto;
            right: 15px;
            margin-left: 0;
        }
    }

    .tooltip-container:hover .tooltip-text {
        visibility: visible;
        opacity: 1;
        transition-delay: 200ms;
    }

    /* Data Benchmark Layout */
    .data-benchmark-layout {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        align-items: center;
    }

    @media (min-width: 1024px) {
        .data-benchmark-layout {
            flex-direction: row;
            align-items: flex-start;
            justify-content: center;
        }
        .data-table-wrapper {
            flex: 1;
            max-width: 1000px;
        }
        .data-warning-container {
            flex: 0 0 300px;
            margin-top: 0;
        }
    }

    /* Ultimate Bench Styles */
    .leaderboard-kicker {
        display: block;
        margin-bottom: .35rem;
        color: #fbbf24;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .18em;
        text-align: center;
        text-transform: uppercase;
    }
    .leaderboard-subtitle {
        margin: .35rem 0 0;
        color: #94a3b8;
        font-size: .9rem;
        text-align: center;
    }
    .ultimate-title-container::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 200%;
        background: radial-gradient(ellipse at center, rgba(245, 158, 11, 0.15) 0%, rgba(17, 24, 39, 0) 70%);
        z-index: -1;
        pointer-events: none;
    }
    #ultimate-sort-btn:hover {
        opacity: 0.8;
    }

    .ultimate-title {
        font-size: 2.5rem;
        font-weight: 900;
        text-align: center;
        letter-spacing: 0.15em;
        margin: 0;
        background: linear-gradient(to right, #FCD34D, #F59E0B, #B45309, #F59E0B, #FCD34D);
        background-size: 200% auto;
        color: #fff;
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: shine 4s linear infinite;
        text-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
        padding: 0.5rem 0;
    }

    @keyframes shine {
        to {
            background-position: 200% center;
        }
    }

    @keyframes subtle-gold-pulse {
        0% { box-shadow: 0 0 15px rgba(245, 158, 11, 0.1), 0 0 30px rgba(245, 158, 11, 0.05); border-color: rgba(245, 158, 11, 0.4); }
        50% { box-shadow: 0 0 20px rgba(245, 158, 11, 0.2), 0 0 40px rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.7); }
        100% { box-shadow: 0 0 15px rgba(245, 158, 11, 0.1), 0 0 30px rgba(245, 158, 11, 0.05); border-color: rgba(245, 158, 11, 0.4); }
    }

    .ultimate-modern-container {
        overflow: hidden;
        padding: 0;
        background: linear-gradient(145deg, rgba(17,24,39,.98), rgba(15,23,42,.95));
        border: 1px solid rgba(245, 158, 11, 0.35);
        border-radius: 18px;
        position: relative;
        z-index: 1;
        margin-bottom: 2rem;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
    }

    .ultimate-row-hover {
        transition: all 0.25s ease-out;
        position: relative;
        cursor: pointer;
    }

    .ultimate-row-hover:nth-child(odd) { background: rgba(255,255,255,.018); }

    @media (max-width: 800px) {
        .ultimate-container { overflow-x: auto; padding-bottom: .5rem; }
        .ultimate-modern-container { min-width: 760px; }
        .ultimate-title { font-size: clamp(1.55rem, 8vw, 2.5rem); letter-spacing: .08em; }
        .model-info::before { min-width: 0; }
    }

    .ultimate-row-hover:hover {
        transform: scale(1.01) translateY(-2px);
        background: linear-gradient(90deg, rgba(31, 41, 55, 0.8) 0%, rgba(55, 65, 81, 0.6) 50%, rgba(31, 41, 55, 0.8) 100%) !important;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3), inset 0 0 10px rgba(245, 158, 11, 0.1);
        z-index: 10;
        border-radius: 8px;
        border-bottom: 1px solid transparent !important;
    }

    .ultimate-row-hover:hover .score-cell {
        color: #E5E7EB !important;
        transition: color 0.2s ease;
    }

    .ultimate-row-hover:hover .ultimate-score-cell {
        transform: scale(1.08);
        color: #FCD34D !important;
        text-shadow: 0 0 12px rgba(245, 158, 11, 0.8);
        transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .ultimate-row-hover:hover .model-name {
        font-weight: 900;
        text-shadow: 0 0 8px rgba(245, 158, 11, 0.4);
        transition: all 0.2s ease;
    }

    .ultimate-row-hover:hover .rank {
        transform: scale(1.1);
        transition: all 0.2s ease;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
    }
    .ultimate-header-glass {
        background: rgba(31, 41, 55, 0.7) !important;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 2px solid rgba(255, 255, 255, 0.1) !important;
    }

    /* Rocket Propulsion Animation */
    .propulsion-main {
        transform-origin: 12px 18px;
        animation: propulse 0.6s infinite alternate ease-in-out;
    }
    .propulsion-left {
        transform-origin: 9px 18px;
        animation: propulse 0.6s infinite alternate ease-in-out;
        animation-delay: 0.2s;
    }
    .propulsion-right {
        transform-origin: 15px 18px;
        animation: propulse 0.6s infinite alternate ease-in-out;
        animation-delay: 0.4s;
    }

    @keyframes propulse {
        0% {
            transform: scaleY(0.5);
            opacity: 0.6;
        }
        100% {
            transform: scaleY(1.5);
            opacity: 1;
        }
    }

    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .modal-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    .modal-content {
        background: rgba(17, 24, 39, 0.95);
        border: 1px solid rgba(55, 65, 81, 0.5);
        border-radius: 12px;
        width: 90%;
        max-width: 1200px;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        padding: 2rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        transform: scale(0.95);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .modal-overlay.active .modal-content {
        transform: scale(1);
    }

    .modal-close-btn {
        position: absolute;
        top: 1rem;
        right: 1rem;
        background: #EF4444;
        color: white;
        border: none;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        font-size: 1.2rem;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
        transition: all 0.2s ease;
        z-index: 10;
    }

    .modal-close-btn:hover {
        background: #DC2626;
        transform: scale(1.1);
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.8);
    }

    /* Achievements Modal Styling */
    .achievements-content {
        background: radial-gradient(circle at 50% -10%, rgba(245, 158, 11, .13), transparent 32%), #0b1220;
        border: 1px solid rgba(148, 163, 184, 0.18);
        box-shadow: 0 32px 90px rgba(0, 0, 0, .65);
        max-width: 1120px;
        text-align: center;
        padding: 2.75rem;
    }

    .achievements-title {
        font-size: clamp(2rem, 5vw, 3.25rem);
        font-weight: 900;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #FCD34D 0%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -.04em;
    }

    .achievements-eyebrow { display:flex; align-items:center; justify-content:center; gap:.75rem; color:#FBBF24; font-size:.7rem; font-weight:900; letter-spacing:.18em; }
    .achievements-eyebrow span { width:34px; height:1px; background:linear-gradient(90deg, transparent, #F59E0B); }
    .achievements-eyebrow span:last-child { transform:rotate(180deg); }

    .achievements-subtitle {
        color: #9CA3AF;
        font-size: 1.1rem;
        margin-bottom: 1.25rem;
    }
    .achievements-summary { width:min(440px,100%); margin:0 auto 2rem; padding:.75rem 1rem; display:flex; justify-content:space-around; background:rgba(15,23,42,.72); border:1px solid rgba(148,163,184,.13); border-radius:999px; }
    .achievements-summary div { display:flex; gap:.4rem; align-items:baseline; }
    .achievements-summary strong { color:#F8FAFC; font-size:.95rem; }
    .achievements-summary span { color:#64748B; font-size:.7rem; text-transform:uppercase; letter-spacing:.08em; }

    .achievements-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1rem;
    }

    .achievement-card {
        background: linear-gradient(145deg, rgba(30,41,59,.72), rgba(8,15,27,.92));
        border: 1px solid rgba(148, 163, 184, 0.13);
        border-radius: .9rem;
        padding: 1.25rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .achievement-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 3px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
        opacity: 0.55;
    }

    .achievement-card:hover {
        transform: translateY(-5px);
        background: rgba(0, 0, 0, 0.4);
    }

    .sota-card:hover { box-shadow: 0 10px 20px rgba(245, 158, 11, 0.2); border-color: rgba(245, 158, 11, 0.4); }
    .vis-card:hover { box-shadow: 0 10px 20px rgba(96, 165, 250, 0.2); border-color: rgba(96, 165, 250, 0.4); }
    .dat-card:hover { box-shadow: 0 10px 20px rgba(16, 185, 129, 0.2); border-color: rgba(16, 185, 129, 0.4); }
    .che-card:hover { box-shadow: 0 10px 20px rgba(167, 139, 250, 0.2); border-color: rgba(167, 139, 250, 0.4); }
    .eff-card:hover { box-shadow: 0 10px 20px rgba(236, 72, 153, 0.2); border-color: rgba(236, 72, 153, 0.4); }
    .gli-card:hover { box-shadow: 0 10px 20px rgba(16, 185, 129, 0.2); border-color: #10B981; }


    .ach-icon {
        font-size: 1.65rem;
        width:3.25rem; height:3.25rem; display:grid; place-items:center;
        margin: .65rem auto 0.75rem;
        border-radius:50%; background:rgba(245,158,11,.1); border:1px solid rgba(245,158,11,.24); color:#FBBF24;
        filter: drop-shadow(0 0 10px rgba(255,255,255,0.2));
    }
    .ach-ribbon { color:#64748B; font-size:.62rem; font-weight:900; letter-spacing:.15em; }

    .achievement-card h3 {
        font-size: 1.2rem;
        color: #F3F4F6;
        margin: 0 0 0.25rem 0;
    }

    .achievement-card p {
        font-size: 0.85rem;
        color: #9CA3AF;
        margin: 0 0 1rem 0;
    }

    .ach-model {
        margin-top: auto;
        font-weight: 700;
        color: #FCD34D;
        background: rgba(245, 158, 11, 0.1);
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        border: 1px solid rgba(245, 158, 11, 0.2);
        width: 100%;
        box-sizing: border-box;
        text-align: center;
        word-wrap: break-word;
    }

    .vis-card .ach-model { color: #93C5FD; background: rgba(96, 165, 250, 0.1); border-color: rgba(96, 165, 250, 0.2); }
    .dat-card .ach-model { color: #6EE7B7; background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.2); }
    .che-card .ach-model { color: #C4B5FD; background: rgba(167, 139, 250, 0.1); border-color: rgba(167, 139, 250, 0.2); }
    .eff-card .ach-model { color: #F9A8D4; background: rgba(236, 72, 153, 0.1); border-color: rgba(236, 72, 153, 0.2); }
    .gli-card .ach-model { color: #10B981; background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.3); font-family: 'Courier New', monospace; font-weight: bold;}
    .runner-card .ach-model, .balance-card .ach-model, .specialist-card .ach-model, .depth-card .ach-model { color:#BAE6FD; background:rgba(14,165,233,.08); border-color:rgba(14,165,233,.2); }
    .runner-card:hover, .balance-card:hover, .specialist-card:hover, .depth-card:hover { border-color:rgba(56,189,248,.35); box-shadow:0 10px 24px rgba(14,165,233,.1); }
    @media (max-width: 640px) { .achievements-content { padding:2.5rem 1rem 1rem; } .achievements-summary span { display:none; } }

    /* Homepage refresh: a quieter, clearer frame for the benchmark data. */
    #home-wrapper > .benchmark-description { max-width: 750px; margin: 0 auto 1.3rem; padding: 0; border: 0; background: transparent; text-align: center; }
    #home-wrapper > .benchmark-description p { color: #8493a8; line-height: 1.65; }
    .ultimate-bench-section { scroll-margin-top: 6rem; }
    .ultimate-title-container {
        position: relative;
        isolation: isolate;
        justify-content: center;
        margin-bottom: 2.25rem !important;
        border: 1px solid rgba(251, 191, 36, .2);
        border-radius: 24px;
        padding: clamp(2.25rem, 6vw, 4.5rem) clamp(1rem, 4vw, 3rem);
        overflow: hidden;
        background:
            radial-gradient(circle at 50% 0%, rgba(251, 191, 36, .2), transparent 42%),
            linear-gradient(135deg, rgba(30, 41, 59, .7), rgba(7, 13, 25, .92));
        box-shadow: 0 24px 70px rgba(2, 6, 23, .38), inset 0 1px rgba(255, 255, 255, .06);
    }
    .ultimate-title-container::before {
        display: block;
        top: 50%;
        width: min(60rem, 100%);
        height: 26rem;
        background: repeating-conic-gradient(from 0deg, rgba(251, 191, 36, .07) 0deg 2deg, transparent 2deg 18deg);
        opacity: .55;
        mask-image: radial-gradient(circle, #000 0%, transparent 68%);
