                            <article class="home-column" data-arena-card>
                                <div class="home-column-header"><h2>{arena.title}</h2><button class="expand-btn" data-target={arena.id} aria-expanded="false" aria-controls={`${arena.id === 'data' ? 'data' : arena.id}-bench-full`}>VIEW DETAILS</button></div>
