    .ultimate-heading-copy { position: relative; z-index: 1; }
    .ultimate-title {
        margin: .25rem 0 .65rem;
        padding: 0;
        font-size: clamp(2.6rem, 7vw, 6.6rem);
        line-height: .94;
        letter-spacing: -.055em;
        background: linear-gradient(100deg, #fff7d6 5%, #fbbf24 38%, #fff 50%, #f59e0b 72%, #fff7d6 95%);
        background-size: 220% auto;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 8px 40px rgba(245, 158, 11, .2);
        animation: shine 5s linear infinite;
    }
    .ultimate-title span { display: block; font-size: .34em; line-height: 1.3; letter-spacing: .48em; margin-right: -.48em; }
    .ultimate-title-container .leaderboard-kicker { margin-bottom: .65rem; font-size: clamp(.68rem, 1.2vw, .82rem); color: #fde68a; }
    .ultimate-title-container .leaderboard-kicker span { margin: 0 .5rem; color: #f59e0b; }
    .ultimate-title-container .leaderboard-subtitle { margin-top: 1rem; color: #b8c5d6; font-size: clamp(.88rem, 1.5vw, 1.05rem); }
    .ultimate-orbit { position: absolute; top: 50%; width: clamp(3rem, 11vw, 10rem); height: 1px; background: linear-gradient(90deg, transparent, rgba(251, 191, 36, .7)); }
    .ultimate-orbit::after { content: ''; position: absolute; top: -3px; right: 0; width: 7px; height: 7px; border-radius: 50%; background: #fbbf24; box-shadow: 0 0 16px 3px rgba(251, 191, 36, .65); }
    .ultimate-orbit-left { left: 2%; }
    .ultimate-orbit-right { right: 2%; transform: rotate(180deg); }
    @keyframes ultimate-rays { to { transform: translate(-50%, -50%) rotate(360deg); } }
    .ultimate-modern-container { padding: .65rem; border: 1px solid #26344c; border-radius: 14px; background: #0d1728; box-shadow: 0 20px 50px rgba(2, 6, 23, .28); animation: none; }
