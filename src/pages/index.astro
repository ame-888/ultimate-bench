                                <div class="journey-mini-track"><span style={`width:${sotaScore}%`}></span></div>
                                <div class="journey-stat-foot"><span>0%</span><span>100%</span></div>
                            </aside>

                            <div class="sota-loading-container">
                                <div class="sota-bar-track" aria-hidden="true">
                                    <div class="sota-bar-fill" style={`height:${sotaScore}%`}>
                                        <div class="sota-rocket-indicator">
                                            <span class="rocket-orbit"></span>
                                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M13.2 3.3c2.3-2 5.1-1.7 7.5-1.7.1 2.4.3 5.2-1.7 7.5l-5.8 5.8-4.1-4.1 4.1-7.5Z" fill="url(#rocketGrad)" stroke="#fff" stroke-width=".8"/>
                                                <path d="m9.5 10.5-4.2.8-2.5 2.5 5.5.2m5.2-2.2.2 5.5-2.5 2.5-.8-4.2" fill="#60A5FA" stroke="#fff" stroke-width=".7"/>
                                                <circle cx="15.8" cy="6.5" r="1.7" fill="#071224" stroke="#93C5FD"/>
                                                <path d="M7.7 15.3c-1.8.3-3 1.5-3.4 3.5 2-.4 3.2-1.5 3.5-3.4" fill="#F59E0B"/>
                                                <defs><linearGradient id="rocketGrad" x1="8" y1="16" x2="20" y2="2"><stop stop-color="#93C5FD"/><stop offset="1" stop-color="#fff"/></linearGradient></defs>
                                            </svg>
                                        </div>
                                    </div>
                                </div>

                                <div class="sota-nodes-container">
                                    {[
                                        { name: '100% MARKER', score: 100, color: '#FBBF24' },
                                        { name: 'EVENT HORIZON', score: 80, color: '#38BDF8' },
                                        { name: 'SUPERNOVA', score: 60, color: '#F97316' },
                                        { name: 'STAR', score: 40, color: '#FB7185' },
                                        { name: 'NEBULA', score: 20, color: '#A855F7' },
                                        { name: 'INCEPTION', score: 0, color: '#94A3B8' }
