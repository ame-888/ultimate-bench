                        .sota-node-dot { position:absolute; left:50%; display:grid; place-items:center; width:18px; height:18px; transform:translate(-50%,-50%); border:2px solid #334155; border-radius:50%; background:#132038; transition:.25s ease; }
                        .sota-node-dot i { width:5px; height:5px; border-radius:50%; background:#64748B; }
                        .sota-node-label { position:absolute; right:calc(50% + 24px); display:flex; align-items:center; gap:.55rem; transform:translateY(-50%); white-space:nowrap; transition:.25s ease; }
                        .sota-node-label b { color:#94A3B8; font-size:.72rem; letter-spacing:.1em; }
                        .sota-node-label small { order:-1; color:#64748B; font:600 .65rem monospace; }
                        .sota-node.reached .sota-node-dot { border-color:var(--milestone); box-shadow:0 0 16px color-mix(in srgb,var(--milestone) 65%,transparent); }
                        .sota-node.reached .sota-node-dot i { background:var(--milestone); }
                        .sota-node.current .sota-node-dot { box-shadow:0 0 0 7px color-mix(in srgb,var(--milestone) 12%,transparent),0 0 18px var(--milestone); }
                        .sota-node:hover .sota-node-dot,.sota-node:focus-visible .sota-node-dot,.sota-node.selected .sota-node-dot { transform:translate(-50%,-50%) scale(1.35); border-color:var(--milestone); background:color-mix(in srgb,var(--milestone) 25%,#132038); }
                        .sota-node:hover .sota-node-label,.sota-node:focus-visible .sota-node-label,.sota-node.selected .sota-node-label { transform:translateY(-50%) translateX(-5px); }
                        .sota-node:hover .sota-node-label b,.sota-node.selected .sota-node-label b { color:var(--milestone); }
                        .sota-node:focus-visible { outline:2px solid #60A5FA; outline-offset:14px; }
                        .milestone-details-panel { min-height:220px; transition:border-color .3s,transform .3s; }
                        .milestone-panel-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; }
                        .milestone-icon { display:grid; place-items:center; width:40px; height:40px; border:1px solid #A855F7; border-radius:12px; background:rgba(168,85,247,.1); box-shadow:0 0 20px rgba(168,85,247,.18); }
                        .milestone-icon span { width:9px; height:9px; border-radius:50%; background:currentColor; box-shadow:0 0 12px currentColor; }
                        .milestone-score { color:#A855F7; font:800 1rem monospace; }
                        .milestone-details-panel h3 { margin:.4rem 0 .7rem; color:#F8FAFC; font-size:1.4rem; letter-spacing:.04em; text-transform:uppercase; }
                        .milestone-details-panel p { min-height:6em; margin:0; color:#94A3B8; font-size:.82rem; line-height:1.6; }
                        .milestone-hint { margin-top:1rem; color:#475569; font-size:.65rem; }
                        .milestone-hint kbd { padding:.15rem .35rem; border:1px solid #334155; border-radius:4px; color:#94A3B8; background:#0F172A; font:inherit; }
                        .ripple-effect { position:absolute; top:50%; left:50%; width:18px; height:18px; border:1px solid var(--milestone); border-radius:50%; transform:translate(-50%,-50%); animation:rippleAnim .7s ease-out forwards; pointer-events:none; }
                        @keyframes starTwinkle { to { opacity:.2; transform:scale(.55); } }
                        @keyframes orbit { to { transform:rotate(360deg); } }
                        @keyframes growUp { from { height:0; } }
                        @keyframes growBar { from { width:0; } }
                        @keyframes rippleAnim { to { width:75px; height:75px; opacity:0; } }
                        @media (max-width:800px) { .journey-dashboard { grid-template-columns:1fr 1fr; } .sota-loading-container { grid-row:1 / span 2; height:500px; } .journey-stat-card,.milestone-details-panel { grid-column:2; } }
                        @media (max-width:580px) { .singularity-journey-section { padding:2.5rem 1rem; border-radius:22px; } .journey-dashboard { display:block; } .journey-stat-card { max-width:250px; margin:0 auto 2rem; text-align:center; } .sota-loading-container { width:260px; height:470px; margin:auto; transform:translateX(25px); } .milestone-details-panel { margin-top:2rem; } .sota-node-label b { font-size:.62rem; } }
                        @media (prefers-reduced-motion:reduce) { .journey-stars i,.rocket-orbit,.sota-bar-fill,.journey-mini-track span { animation:none; } }
                    </style>

