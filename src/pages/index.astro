---
import Layout from '../layouts/Layout.astro';
import { benchmarks } from '../data/benchmarks';
import { ARENAS } from '../data/benchmarkSpec';
import { buildLeaderboard } from '../data/leaderboard';
import { validateBenchmarkRecords } from '../data/scoring';
import { createParetoChartDomain, modelPricing, PRICING_CHECKED_ON, validatePricing } from '../data/modelPricing';
import CreatureIcon from '../components/CreatureIcon.astro';
import { getSimulatedDate, TIME_OFFSET } from '../scripts/TimeUtils';



validateBenchmarkRecords(benchmarks);
const canonicalLeaderboard = buildLeaderboard(benchmarks);

// --- Simulated Time for Context ---
const SIMULATED_NOW = getSimulatedDate();

function isNew(dateStr) {
    if (!dateStr) return false;
    const release = new Date(dateStr);
    const now = new Date(SIMULATED_NOW);
    // Reset hours to compare just dates
    release.setHours(0,0,0,0);
    now.setHours(0,0,0,0);

    const diffTime = now.getTime() - release.getTime();
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    // Show new for items released in the last 30 days
    return diffDays >= -1 && diffDays <= 30;
}

function formatReleaseDate(dateStr) {
    if (!dateStr) return 'Not recorded';
    return new Intl.DateTimeFormat('en-US', {
        day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC'
    }).format(new Date(`${dateStr}T00:00:00Z`));
}

function formatTimeAgo(dateStr, now = SIMULATED_NOW) {
    if (!dateStr) return '';
    const release = new Date(`${dateStr}T00:00:00Z`);
    const today = new Date(now);
    const days = Math.max(0, Math.floor((today.getTime() - release.getTime()) / 86_400_000));
    if (days === 0) return 'today';
    if (days === 1) return '1 day ago';
    if (days < 30) return `${days} days ago`;
    const months = Math.floor(days / 30.4375);
    if (months === 1) return '1 month ago';
    if (months < 12) return `${months} months ago`;
    const years = Math.floor(months / 12);
    return `${years} ${years === 1 ? 'year' : 'years'} ago`;
}

const modelProviders = [
    { match: 'gemini', name: 'Google', slug: 'google' },
    { match: 'muse', name: 'Meta AI', slug: 'meta' },
    { match: 'gpt', name: 'OpenAI', slug: 'openai' },
    { match: 'grok', name: 'xAI', slug: 'xai' },
    { match: 'claude', name: 'Anthropic', slug: 'anthropic' }
];

function getModelProvider(name) {
    const provider = modelProviders.find(({ match }) => name.toLowerCase().includes(match));
    return provider || { name: 'Other', slug: 'other' };
}

function getModelColorClass(name) {
    return `model-bg-${getModelProvider(name).slug}`;
}

// --- Ranking Logic ---
function computeRanks(items, scoreKeys) {
    const keys = Array.isArray(scoreKeys) ? scoreKeys : [scoreKeys];

    // 1. Sort
    let sorted = [...items].sort((a, b) => {
        for (const key of keys) {
            const valA = typeof a[key] === 'number' ? a[key] : 0;
            const valB = typeof b[key] === 'number' ? b[key] : 0;
            if (valB !== valA) {
                return valB - valA;
            }
        }
        return 0;
    });

    // 3. Assign ranks
    let currentRank = 1;
    let previousItem = null;
    let rankedItems = [];

    sorted.forEach((item) => {
        if (previousItem !== null) {
            let isWorse = false;
            for (const key of keys) {
                const itemVal = typeof item[key] === 'number' ? item[key] : 0;
                const prevVal = typeof previousItem[key] === 'number' ? previousItem[key] : 0;
                if (itemVal < prevVal) {
                    isWorse = true;
                    break;
                } else if (itemVal > prevVal) {
                    break;
                }
            }
            if (isWorse) {
                currentRank++;
            }
        }

        rankedItems.push({ ...item, rank: currentRank, isFail: false });
        previousItem = item;
    });

    return rankedItems;
}


// --- Unify Benchmark Data for Visual Mode ---
const unifiedDataMap = new Map();
const releaseDateByModel = new Map(
    benchmarks.models.map(model => [model.name, model.releaseDate])
);

benchmarks.models.forEach(m => {
    unifiedDataMap.set(m.name, {
        name: m.name,
        releaseDate: m.releaseDate,
        lvl1: m.scores.lvl1,
        lvl2: m.scores.lvl2,
        lvl3: m.scores.lvl3,
        lvl4: m.scores.lvl4,
        lvl5: m.scores.lvl5,
        lvl6: 'PLANNED'
    });
});



const unifiedRawList = Array.from(unifiedDataMap.values()).map(m => {
    let total = m.lvl1 + m.lvl2 + m.lvl3 + m.lvl4 + m.lvl5;
    // Average removed in favor of level-by-level fallback ranking

    return m;
});

const visualArenaRows = canonicalLeaderboard.arenaRows.visual;
const unifiedList = visualArenaRows.map(row => ({ ...unifiedRawList.find(item => item.name === row.name), rank: row.rank, canonicalScore: row.score, canonicalRank: row.rank, rankEligible: row.canonical.rankEligible, coverage: row.canonical.coverage, weightCoverage: row.canonical.weightCoverage }));

// Calculate best AI scores for each column to apply the golden aura
const bestAiScores = { lvl1: -1, lvl2: -1, lvl3: -1, lvl4: -1, lvl5: -1 };
unifiedList.forEach(item => {
            if (item.lvl1 !== undefined && item.lvl1 > bestAiScores.lvl1 && typeof item.lvl1 === 'number') bestAiScores.lvl1 = item.lvl1;
        if (item.lvl2 !== undefined && item.lvl2 > bestAiScores.lvl2 && typeof item.lvl2 === 'number') bestAiScores.lvl2 = item.lvl2;
        if (item.lvl3 !== undefined && item.lvl3 > bestAiScores.lvl3 && typeof item.lvl3 === 'number') bestAiScores.lvl3 = item.lvl3;
        if (item.lvl4 !== undefined && item.lvl4 > bestAiScores.lvl4 && typeof item.lvl4 === 'number') bestAiScores.lvl4 = item.lvl4;
        if (item.lvl5 !== undefined && item.lvl5 > bestAiScores.lvl5 && typeof item.lvl5 === 'number') bestAiScores.lvl5 = item.lvl5;
});

const rows = Array.from({ length: unifiedList.length }, (_, i) => i);

// Data Retrieval Logic
const dataDataMap = new Map();

(benchmarks.dataRetrieval || []).forEach(m => {
    dataDataMap.set(m.name, {
        name: m.name,
        releaseDate: m.releaseDate ?? releaseDateByModel.get(m.name),
        worm: m.scores?.worm,
        koala: m.scores?.koala,
        crow: m.scores?.crow,
        octopus: m.scores?.octopus,
        raven: 'PLANNED',
        athena: 'PLANNED'
    });
});

const dataRawList = Array.from(dataDataMap.values()).map(m => {
    const wormScore = typeof m.worm === 'number' ? m.worm : 0;
    const koalaScore = typeof m.koala === 'number' ? m.koala : 0;
    const crowScore = typeof m.crow === 'number' ? m.crow : 0;
    const octopusScore = typeof m.octopus === 'number' ? m.octopus : 0;
    return m;
});

const dataList = canonicalLeaderboard.arenaRows['data-retrieval'].map(row => ({ ...dataRawList.find(item => item.name === row.name), rank: row.rank, canonicalScore: row.score, canonicalRank: row.rank, rankEligible: row.canonical.rankEligible, coverage: row.canonical.coverage, weightCoverage: row.canonical.weightCoverage }));

const bestDataAiScores = { worm: -1, koala: -1, crow: -1, octopus: -1 };
dataList.forEach(item => {
            if (typeof item.worm === 'number' && item.worm > bestDataAiScores.worm) bestDataAiScores.worm = item.worm;
        if (typeof item.koala === 'number' && item.koala > bestDataAiScores.koala) bestDataAiScores.koala = item.koala;
        if (typeof item.crow === 'number' && item.crow > bestDataAiScores.crow) bestDataAiScores.crow = item.crow;
        if (typeof item.octopus === 'number' && item.octopus > bestDataAiScores.octopus) bestDataAiScores.octopus = item.octopus;
});

const dataArenaRows = canonicalLeaderboard.arenaRows['data-retrieval'];

const rowsData = Array.from({ length: dataList.length }, (_, i) => i);

// Chess Benchmark Logic
const chessDataMap = new Map();

(benchmarks.chessModels || []).forEach(m => {
    chessDataMap.set(m.name, {
        name: m.name,
        releaseDate: m.releaseDate ?? releaseDateByModel.get(m.name),
        mouse: m.scores?.mouse,
        spider: m.scores?.spider,
        wolf: m.scores?.wolf,
        hawk: m.scores?.hawk,
        python: m.scores?.python,
        origins: m.origins ?? {}
    });
});

const chessRawList = Array.from(chessDataMap.values()).map(m => {
    const mouseScore = typeof m.mouse === 'number' ? m.mouse : 0;
    const spiderScore = typeof m.spider === 'number' ? m.spider : 0;
    const wolfScore = typeof m.wolf === 'number' ? m.wolf : 0;
    const hawkScore = typeof m.hawk === 'number' ? m.hawk : 0;
    const pythonScore = typeof m.python === 'number' ? m.python : 0;
    return m;
});

const chessList = canonicalLeaderboard.arenaRows.chess.map(row => ({ ...chessRawList.find(item => item.name === row.name), rank: row.rank, canonicalScore: row.score, canonicalRank: row.rank, rankEligible: row.canonical.rankEligible, coverage: row.canonical.coverage, weightCoverage: row.canonical.weightCoverage }));

const bestChessAiScores = { mouse: -1, spider: -1, wolf: -1, hawk: -1, python: -1, hydra: -1 };
chessList.forEach(item => {
    if (typeof item.mouse === 'number' && item.mouse > bestChessAiScores.mouse) bestChessAiScores.mouse = item.mouse;
    if (typeof item.spider === 'number' && item.spider > bestChessAiScores.spider) bestChessAiScores.spider = item.spider;
    if (typeof item.wolf === 'number' && item.wolf > bestChessAiScores.wolf) bestChessAiScores.wolf = item.wolf;
    if (typeof item.hawk === 'number' && item.hawk > bestChessAiScores.hawk) bestChessAiScores.hawk = item.hawk;
    if (typeof item.python === 'number' && item.python > bestChessAiScores.python) bestChessAiScores.python = item.python;
    if (typeof item.hydra === 'number' && item.hydra > bestChessAiScores.hydra) bestChessAiScores.hydra = item.hydra;
});

const chessArenaRows = canonicalLeaderboard.arenaRows.chess;

// Homepage arena summaries intentionally show only officially ranked results.
// Incomplete, computable results remain visible separately for transparency.
const ARENA_PREVIEW_ROWS = 10;
const provisionalArenaRows = canonicalLeaderboard.arenaRows['data-retrieval'].filter(row => row.rank === null);

const rowsChess = Array.from({ length: chessList.length }, (_, i) => i);


function getPixelMedal(rank) {
    let color1, color2, color3;
    if (rank === 1) { color1 = '#FFD700'; color2 = '#DAA520'; color3 = '#B8860B'; } // Gold
    else if (rank === 2) { color1 = '#E0E0E0'; color2 = '#C0C0C0'; color3 = '#A9A9A9'; } // Silver
    else if (rank === 3) { color1 = '#CD7F32'; color2 = '#A0522D'; color3 = '#8B4513'; } // Bronze

    return `<svg width="24" height="24" viewBox="0 0 16 16" style="display:inline-block; vertical-align:middle; filter:drop-shadow(0 2px 2px rgba(0,0,0,0.5));">
        <path d="M4 2 h8 v2 h-8 z" fill="${color3}"/>
        <path d="M3 4 h10 v8 h-10 z" fill="${color2}"/>
        <path d="M4 5 h8 v6 h-8 z" fill="${color1}"/>
        <path d="M5 6 h6 v4 h-6 z" fill="#FFFFFF" fill-opacity="0.3"/>
        <path d="M4 12 h8 v2 h-8 z" fill="${color3}"/>
        <text x="8" y="9" font-family="monospace" font-size="6" font-weight="bold" fill="${color3}" text-anchor="middle" dominant-baseline="central">${rank}</text>
    </svg>`;
}


// --- Global Ultimate Bench Logic: shared canonical utilities ---
const canonicalModels = canonicalLeaderboard.rows.map(item => ({
    name: item.name, releaseDate: releaseDateByModel.get(item.name),
    visualScore: item.scores.visual, dataScore: item.scores['data-retrieval'], chessScore: item.scores.chess,
    ultimateScore: item.score, rank: item.rank, coverage: item.results
}));
const pricingDiagnostics = [];
const pricedModels = canonicalModels.flatMap(item => {
    const result = validatePricing(modelPricing[item.name]);
    if (!result.valid) { pricingDiagnostics.push(`${item.name}: ${result.diagnostic}`); return []; }
    return [{ ...item, blendedCost: result.value.blendedCost, pricingSource: result.value.source }];
});
const omittedPricingCount = canonicalModels.length - pricedModels.length;
const paretoModels = pricedModels.filter(item => !pricedModels.some(other =>
    other !== item && other.blendedCost <= item.blendedCost && other.ultimateScore >= item.ultimateScore &&
    (other.blendedCost < item.blendedCost || other.ultimateScore > item.ultimateScore)
));
const paretoNames = new Set(paretoModels.map(item => item.name));
const sotaScore = Math.max(0, ...canonicalModels.map(item => item.ultimateScore));
const sotaModelName = canonicalModels.find(item => item.ultimateScore === sotaScore)?.name ?? "None";
const chartWidth = 1200, chartHeight = 640;
const chartPad = { left: 82, right: 42, top: 72, bottom: 72 };
const chartDomain = createParetoChartDomain(pricedModels.map(item => item.blendedCost));
const { minPower: minCostPower, maxPower: maxCostPower } = chartDomain;
const costTicks = Array.from({ length: maxCostPower - minCostPower + 1 }, (_, index) => 10 ** (minCostPower + index));
const scoreDomainMax = sotaScore > 0 ? sotaScore : 1;
const scoreTicks = Array.from({ length: 5 }, (_, index) => (scoreDomainMax * index) / 4);
const chartX = (cost) => chartPad.left + chartDomain.x(cost) * (chartWidth - chartPad.left - chartPad.right);
const chartY = (score) => chartPad.top + ((scoreDomainMax - score) / scoreDomainMax) * (chartHeight - chartPad.top - chartPad.bottom);
const frontierPoints = [...paretoModels].sort((a, b) => a.blendedCost - b.blendedCost).map(item => `${chartX(item.blendedCost)},${chartY(item.ultimateScore)}`).join(' ');

function getRankDisplay(rank) {

    if (rank === null) return '—';
    if (rank === 'INVALID') return `<span class="zero-score-glow">INVALID</span>`;
    return `${rank}`;
}

