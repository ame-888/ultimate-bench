---
import Layout from '../layouts/Layout.astro';
import { benchmarks } from '../data/benchmarks';
import { buildLeaderboard } from '../data/leaderboard';
import { validateBenchmarkRecords } from '../data/scoring';
type LevelValue = number | string | undefined;
import { formatAggregateScore } from '../data/formatting';
import { createParetoChartDomain, modelPricing, PRICING_CHECKED_ON, validatePricing } from '../data/modelPricing';
import { buildCapabilitySeries, resolveReleaseDate } from '../data/progression';
import CapabilityTimeline from '../components/CapabilityTimeline.astro';
import CreatureIcon from '../components/CreatureIcon.astro';
import { getSiteNow, isNewRelease, formatRelativeReleaseDate } from '../scripts/TimeUtils';
import { getModelReleaseDate, validateModelMetadata } from '../data/modelMetadata';

validateBenchmarkRecords(benchmarks);
const canonicalLeaderboard = buildLeaderboard(benchmarks);

const BUILD_NOW = getSiteNow();
const isNew = (dateStr: string | undefined) => isNewRelease(dateStr, BUILD_NOW);

function formatReleaseDate(dateStr: string | undefined): string {
    if (!dateStr) return 'Not recorded';
    return new Intl.DateTimeFormat('en-US', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
    }).format(new Date(`${dateStr}T00:00:00Z`));
}

const formatTimeAgo = (dateStr: string | undefined) => formatRelativeReleaseDate(dateStr, BUILD_NOW);

const modelProviders = [
    { match: 'gemini', name: 'Google', slug: 'google' },
    { match: 'muse', name: 'Meta AI', slug: 'meta' },
    { match: 'gpt', name: 'OpenAI', slug: 'openai' },
    { match: 'grok', name: 'xAI', slug: 'xai' },
    { match: 'claude', name: 'Anthropic', slug: 'anthropic' },
] as const;

function getModelProvider(name: string): { readonly name: string; readonly slug: string };
// @ts-expect-error -- overload signature above types `name` while preserving the exact declaration expected by layout tests.
function getModelProvider(name) {
    const provider = modelProviders.find(({ match }) => String(name).toLowerCase().includes(match));
    return provider || { name: 'Other', slug: 'other' };
}

function getModelColorClass(name: string): string {
    return `model-bg-${getModelProvider(name).slug}`;
}

function computeBestScores<T extends Record<string, unknown>, K extends keyof T & string>(
    list: T[],
    keys: readonly K[],
): Record<K, number> {
    const best = Object.fromEntries(keys.map((key) => [key, -1])) as Record<K, number>;
    for (const item of list) {
        for (const key of keys) {
            const value = item[key];
            if (typeof value === 'number' && value > best[key]) {
                best[key] = value;
            }
        }
    }
    return best;
}

function getRankDisplay(rank: number | string | null): string {
    if (rank === null) return '—';
    if (rank === 'INVALID') return `<span class="zero-score-glow">INVALID</span>`;
    return `${rank}`;
}

// --- Validate canonical model release metadata ---
const benchmarkModelNames = [
    ...new Set([benchmarks.models, benchmarks.dataRetrieval, benchmarks.chessModels].flat().map((model) => model.name)),
];
const metadataErrors = validateModelMetadata(benchmarkModelNames);
if (metadataErrors.length) throw new Error(`Invalid model metadata:\n${metadataErrors.join('\n')}`);
const releaseDateByModel = new Map<string, string>(
    benchmarkModelNames.flatMap((name) => {
        const releaseDate = getModelReleaseDate(name);
        return releaseDate ? [[name, releaseDate] as const] : [];
    }),
);

// --- Visual Bench Data ---
type VisualRow = {
    name: string;
    releaseDate: string | undefined;
    lvl1: LevelValue;
    lvl2: LevelValue;
    lvl3: LevelValue;
    lvl4: LevelValue;
    lvl5: LevelValue;
    lvl6: string;
    rank: number | null;
    canonicalScore: number;
    canonicalRank: number | null;
    rankEligible: boolean;
    coverage: string;
    weightCoverage: string;
};

const visualRecordByName = new Map(
    benchmarks.models.map((m) => [
        m.name,
        {
            name: m.name,
            releaseDate: releaseDateByModel.get(m.name),
            lvl1: m.scores.lvl1,
            lvl2: m.scores.lvl2,
            lvl3: m.scores.lvl3,
            lvl4: m.scores.lvl4,
            lvl5: m.scores.lvl5,
            lvl6: 'PLANNED',
        },
    ]),
);

const visualArenaRows = canonicalLeaderboard.arenaRows.visual;
const unifiedList: VisualRow[] = visualArenaRows.map((row) => ({
    ...visualRecordByName.get(row.name)!,
    rank: row.rank,
    canonicalScore: row.score,
    canonicalRank: row.rank,
    rankEligible: row.canonical.rankEligible,
    coverage: row.canonical.coverage,
    weightCoverage: row.canonical.weightCoverage,
}));

const bestAiScores = computeBestScores(unifiedList, ['lvl1', 'lvl2', 'lvl3', 'lvl4', 'lvl5'] as const);

// --- Data Retrieval Bench Data ---
type DataRow = {
    name: string;
    releaseDate: string | undefined;
    worm: LevelValue;
    koala: LevelValue;
    crow: LevelValue;
    octopus: LevelValue;
    raven: string;
    athena: string;
    rank: number | null;
    canonicalScore: number;
    canonicalRank: number | null;
    rankEligible: boolean;
    coverage: string;
    weightCoverage: string;
};

const dataRecordByName = new Map(
    (benchmarks.dataRetrieval || []).map((m) => [
        m.name,
        {
            name: m.name,
            releaseDate: ('releaseDate' in m ? (m.releaseDate as string | undefined) : undefined) ?? releaseDateByModel.get(m.name),
            worm: m.scores?.worm,
            koala: m.scores?.koala,
            crow: m.scores?.crow,
            octopus: m.scores?.octopus,
            raven: 'PLANNED',
            athena: 'PLANNED',
        },
    ]),
);

const dataArenaRows = canonicalLeaderboard.arenaRows['data-retrieval'];
const dataList: DataRow[] = dataArenaRows.map((row) => ({
    ...dataRecordByName.get(row.name)!,
    rank: row.rank,
    canonicalScore: row.score,
    canonicalRank: row.rank,
    rankEligible: row.canonical.rankEligible,
    coverage: row.canonical.coverage,
    weightCoverage: row.canonical.weightCoverage,
}));

const bestDataAiScores = computeBestScores(dataList, ['worm', 'koala', 'crow', 'octopus'] as const);

// --- Chess Bench Data ---
type ChessRow = {
    name: string;
    releaseDate: string | undefined;
    mouse: LevelValue;
    spider: LevelValue;
    wolf: LevelValue;
    hawk: LevelValue;
    python: LevelValue;
    hydra?: LevelValue;
    rank: number | null;
    canonicalScore: number;
    canonicalRank: number | null;
    rankEligible: boolean;
    coverage: string;
    weightCoverage: string;
};

const chessRecordByName = new Map(
    (benchmarks.chessModels || []).map((m) => [
        m.name,
        {
            name: m.name,
            releaseDate: ('releaseDate' in m ? (m.releaseDate as string | undefined) : undefined) ?? releaseDateByModel.get(m.name),
            mouse: m.scores?.mouse,
            spider: m.scores?.spider,
            wolf: m.scores?.wolf,
            hawk: m.scores?.hawk,
            python: m.scores?.python,
        },
    ]),
);

const chessArenaRows = canonicalLeaderboard.arenaRows.chess;
const chessList: ChessRow[] = chessArenaRows.map((row) => ({
    ...chessRecordByName.get(row.name)!,
    rank: row.rank,
    canonicalScore: row.score,
    canonicalRank: row.rank,
    rankEligible: row.canonical.rankEligible,
    coverage: row.canonical.coverage,
    weightCoverage: row.canonical.weightCoverage,
}));

const bestChessAiScores = computeBestScores(chessList, ['mouse', 'spider', 'wolf', 'hawk', 'python', 'hydra'] as const);

// Homepage arena summaries intentionally show only officially ranked results.
// Incomplete, computable results remain visible separately for transparency.
const ARENA_PREVIEW_ROWS = 5;
const provisionalArenaRows = canonicalLeaderboard.arenaRows['data-retrieval'].filter((row) => row.rank === null);

// --- Global Ultimate Bench Logic: shared canonical utilities ---
const canonicalModels = canonicalLeaderboard.rows.map((item) => ({
    name: item.name,
    releaseDate: releaseDateByModel.get(item.name),
    visualScore: item.scores.visual,
    dataScore: item.scores['data-retrieval'],
    chessScore: item.scores.chess,
    ultimateScore: item.score,
    rank: item.rank,
    coverage: item.results,
}));

const pricingByModel: Record<string, unknown> = modelPricing;
const pricedModels = canonicalModels.flatMap((item) => {
    const result = validatePricing(pricingByModel[item.name]);
    if (!result.valid) return [];
    return [{ ...item, blendedCost: result.value.blendedCost, pricingSource: result.value.source }];
});
const omittedPricingCount = canonicalModels.length - pricedModels.length;
const paretoModels = pricedModels.filter(
    (item) =>
        !pricedModels.some(
            (other) =>
                other !== item &&
                other.blendedCost <= item.blendedCost &&
                other.ultimateScore >= item.ultimateScore &&
                (other.blendedCost < item.blendedCost || other.ultimateScore > item.ultimateScore),
        ),
);
const paretoNames = new Set(paretoModels.map((item) => item.name));
const sotaScore = Math.max(0, ...canonicalModels.map((item) => item.ultimateScore));
const chartWidth = 1200;
const chartHeight = 640;
const chartPad = { left: 82, right: 42, top: 72, bottom: 72 };
const chartDomain = createParetoChartDomain(pricedModels.map((item) => item.blendedCost));
const { minPower: minCostPower, maxPower: maxCostPower } = chartDomain;
const costTicks = Array.from({ length: maxCostPower - minCostPower + 1 }, (_, index) => 10 ** (minCostPower + index));
const scoreDomainMax = sotaScore > 0 ? sotaScore : 1;
const scoreTicks = Array.from({ length: 5 }, (_, index) => (scoreDomainMax * index) / 4);
const chartX = (cost: number) => chartPad.left + chartDomain.x(cost) * (chartWidth - chartPad.left - chartPad.right);
const chartY = (score: number) => chartPad.top + ((scoreDomainMax - score) / scoreDomainMax) * (chartHeight - chartPad.top - chartPad.bottom);
const frontierPoints = [...paretoModels]
    .sort((a, b) => a.blendedCost - b.blendedCost)
    .map((item) => `${chartX(item.blendedCost)},${chartY(item.ultimateScore)}`)
    .join(' ');

const capabilitySeries = buildCapabilitySeries(canonicalLeaderboard.arenaRows, canonicalLeaderboard.rows, (name, arena) => {
    const arenaRow = arena ? canonicalLeaderboard.arenaRows[arena].find((row) => row.name === name) : undefined;
    return resolveReleaseDate(name, arenaRow?.releaseDate, releaseDateByModel);
});

const arenaSummaries = [
    {
        id: 'visual',
        kicker: '01 / PERCEPTION',
        title: 'Visual Bench',
        description: 'Visual recognition and spatial reasoning',
        protocol: 'visual-bench',
        rows: visualArenaRows.filter((row) => row.rank !== null),
    },
    {
        id: 'data',
        kicker: '02 / RETRIEVAL',
        title: 'Data Retrieval Bench',
        description: 'Evidence retrieval and source synthesis',
        protocol: 'data-bench',
        rows: dataArenaRows.filter((row) => row.rank !== null),
    },
    {
        id: 'chess',
        kicker: '03 / STRATEGY',
        title: 'Chess Bench',
        description: 'Chess-position analysis and play',
        protocol: 'chess-bench',
        rows: chessArenaRows.filter((row) => row.rank !== null),
    },
] as const;

const visualHeaders = [
    { key: 'lvl1', css: 'mole', creature: 'mole', label: 'MOLE', aria: 'Show Mole Level 1 explanation', id: 'tooltip-explanation-2', heading: 'MOLE (Level 1):', body: 'Ten fixed coordinate questions about an intact 10 × 10 character grid, repeated in ten fresh, isolated conversations. The result counts correct responses among 100 repeated response instances.' },
    { key: 'lvl2', css: 'rhino', creature: 'rhino', label: 'RHINO', aria: 'Show Rhino Level 2 explanation', id: 'tooltip-explanation-3', heading: 'RHINO (Level 2):', body: 'The Mole grid loses the same lateral half of every column while retaining its logical grid and questions. Ten fixed questions are repeated in ten fresh, isolated conversations.' },
    { key: 'lvl3', css: 'chimp', creature: 'chimpanzee', label: 'CHIMPANZEE', aria: 'Show Chimpanzee Level 3 explanation', id: 'tooltip-explanation-4', heading: 'CHIMPANZEE (Level 3):', body: 'The Rhino image receives imperfect background removal, adding segmentation artifacts and information loss. The same ten questions are repeated in ten fresh, isolated conversations.' },
    { key: 'lvl4', css: 'owl', creature: 'owl', label: 'OWL', aria: 'Show Owl Level 4 explanation', id: 'tooltip-explanation-5', heading: 'OWL (Level 4):', body: 'In a separate 17 × 11 grid with a central 5 × 3 spanning image, the model locates two named anchors and identifies their unique horizontal or vertical midpoint character. Ten fixed questions are repeated in ten fresh, isolated conversations.' },
    { key: 'lvl5', css: 'eagle', creature: 'eagle', label: 'EAGLE', aria: 'Show Eagle Level 5 explanation', id: 'tooltip-explanation-6', heading: 'EAGLE (Level 5):', body: 'A larger, denser mixed-source grid combines animation, live action, irregular cropping, and selective color inversion. The model finds horizontal, vertical, or diagonal midpoint characters across ten fresh, isolated administrations.' },
    { key: 'lvl6', css: 'beholder', creature: 'beholder', label: 'BEHOLDER', aria: 'Show Beholder Level 6 explanation', id: 'tooltip-explanation-7', heading: 'BEHOLDER (Level 6):', body: 'Planned evaluation. The Level 6 stimulus, task structure, scoring protocol, and measured capabilities have not yet been defined. No model results are currently available.' },
] as const;

const chessHeaders = [
    { key: 'mouse', creature: 'mouse', label: 'MOUSE', aria: 'Show Chess Mouse Level 1 explanation', id: 'tooltip-explanation-9', heading: 'MOUSE (Level 1):', body: 'A test of baseline structural integrity and fundamental laws. The system must demonstrate an active, coherent grasp of basic spatial constraints and avoid immediate cognitive collapse over a short horizon.' },
    { key: 'spider', creature: 'spider', label: 'SPIDER', aria: 'Show Chess Spider Level 2 explanation', id: 'tooltip-explanation-10', heading: 'SPIDER (Level 2):', body: "A trial of cognitive stamina. Here, the march of turns is the primary adversary, testing whether the system's internal state representation can withstand the creeping decay of longer, more drawn-out sequences." },
    { key: 'wolf', creature: 'wolf', label: 'WOLF', aria: 'Show Chess Wolf Level 3 explanation', id: 'tooltip-explanation-11', heading: 'WOLF (Level 3):', body: 'An introduction to uncompromising precision. The margin for error shrinks drastically, demanding sharp tactical alertness where minor oversights carry sudden and heavy consequences.' },
    { key: 'hawk', creature: 'hawk', label: 'HAWK', aria: 'Show Chess Hawk Level 4 explanation', id: 'tooltip-explanation-12', heading: 'HAWK (Level 4):', body: 'An evaluation of psychological friction and self-certainty. The system must navigate external skepticism and defend its own logical calculations, where a single moment of submissive compliance or hesitation results in total failure.' },
    { key: 'python', creature: 'python', label: 'PYTHON', aria: 'Show Chess Python Level 5 explanation', id: 'tooltip-explanation-13', heading: 'PYTHON (Level 5):', body: 'A confrontation with flawless execution. The standard is set so high that mere survival or passive defense is treated as defeat, all while the system is subjected to relentless, systematic false accusations.' },
    { key: 'hydra', creature: 'hydra', label: 'HYDRA', aria: 'Show Chess Hydra Level 6 explanation', id: 'tooltip-explanation-14', heading: 'HYDRA (Level 6):', body: 'LOCKED. Its weight 32 is reserved; no model result exists. It may become Active by a deliberate version decision after a model scores above 0 on Python.' },
] as const;

const dataHeaders = [
    { key: 'worm', creature: 'worm', label: 'WORM', aria: 'Show Data Retrieval Worm Level 1 explanation', id: 'tooltip-explanation-16', heading: 'WORM (Level 1):', body: "Evaluates Baseline Agentic Retrieval. Measures the model's foundational ability to execute a single, focused multimodal web search and extract specific granular data from the noise of the open web." },
    { key: 'koala', creature: 'koala', label: 'KOALA', aria: 'Show Data Retrieval Koala Level 2 explanation', id: 'tooltip-explanation-17', heading: 'KOALA (Level 2):', body: "Tests Parallelized Multi-Hop Execution. Designed to expose 'Lost in the Middle' contextual collapse, this level evaluates a model's stamina and working memory when forced to execute massive batches of unrelated tasks simultaneously." },
    { key: 'crow', creature: 'crow', label: 'CROW', aria: 'Show Data Retrieval Crow Level 3 explanation', id: 'tooltip-explanation-18', heading: 'CROW (Level 3):', body: "Measures Epistemic Sovereignty. Tests the model's resistance to sycophancy and anchor bias. To pass, the agent must trust its retrieved data enough to actively defy and correct highly plausible, yet false, user suggestions." },
    { key: 'octopus', creature: 'octopus', label: 'OCTOPUS', aria: 'Show Data Retrieval Octopus Level 4 explanation', id: 'tooltip-explanation-19', heading: 'OCTOPUS (Level 4):', body: 'Tests advanced multimodal data navigation, needle-in-a-haystack retrieval, deep multilingual understanding, and more advanced sycophancy resistance.' },
    { key: 'raven', creature: 'raven', label: 'RAVEN', aria: 'Show Data Retrieval Raven Level 5 explanation', id: 'tooltip-explanation-20', heading: 'RAVEN (Level 5):', body: 'Planned future level. Protocol not yet defined.' },
    { key: 'athena', creature: 'athena', label: 'ATHENA', aria: 'Show Data Retrieval Athena Level 6 explanation', id: 'tooltip-explanation-21', heading: 'ATHENA (Level 6):', body: 'Planned future level. Protocol not yet defined.' },
] as const;
---

<Layout title="AI Model Leaderboard | Ultimate Bench" description="Independent AI model benchmarking across visual reasoning, data retrieval, and chess. Compare tested configurations, scores, and coverage.">
    <main>
        <header class="editorial-hero">
            <p class="hero-kicker">Ultimate Bench <span aria-hidden="true">/</span> Independent experimental research</p>
            <h1>AI model <span>benchmarks.</span></h1>
            <p>Independent comparisons of tested configurations across visual reasoning, data retrieval, and chess.</p>
            <nav class="intro-links" aria-label="Benchmark resources">
                <a href="/methodology">How scoring works <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
                <a href="/guide">Reading the results <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 12 12 4M4 4h8v8" /></svg></a>
            </nav>
        </header>
        <div class="leaderboard-grid">
            <!-- Benchmarks Section -->
            <section class="leaderboard-section full-width">

                <!-- Modal Container -->
                <div id="benchmark-modal" class="modal-overlay" hidden role="dialog" aria-modal="true" aria-label="Arena details">
                    <div class="modal-content">
                        <div class="modal-toolbar">
                            <button id="benchmark-modal-close" class="modal-close-btn" type="button" aria-label="Close arena details">&times;</button>
                        </div>
                        <div id="benchmark-modal-body"></div>
                    </div>
                </div>

                <!-- Homepage Combined View -->
                <div id="home-wrapper">
                    <!-- Ultimate Global Bench Section -->
                    <section class="ultimate-bench-section" id="global-leaderboard" aria-labelledby="ultimate-leaderboard-title">
                        <header class="ultimate-title-container">
                            <div>
                                <span class="leaderboard-kicker">Across all three arenas</span>
                                <h2 id="ultimate-leaderboard-title">Ultimate leaderboard</h2>
                            </div>
                            <p>{canonicalModels.length} qualified configurations · 3 arenas</p>
                        </header>

                        <div class="leaderboard-controls" aria-label="Filter leaderboard models">
                            <div class="score-mode" role="group" aria-label="Leaderboard scoring mode">
                                <button type="button" class="score-mode-btn is-active" data-score-mode="absolute" aria-pressed="true">Overall</button>
                                <button type="button" class="score-mode-btn" data-score-mode="pareto" aria-pressed="false">Price comparison</button>
                                <button type="button" class="score-mode-btn" data-score-mode="progress" aria-pressed="false">Progress over time</button>
                            </div>
                            <label class="model-search">
                                <span class="sr-only">Search models</span>
                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.35-4.35m2.1-5.4a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"/></svg>
                                <input id="ultimate-model-filter" type="search" placeholder="Find a model…" autocomplete="off" />
                                <kbd>/</kbd>
                            </label>
                            <div class="provider-filter" role="group" aria-label="Filter by provider">
                                <button type="button" class="provider-filter-btn is-active" data-provider-filter="all" aria-pressed="true">All</button>
                                {modelProviders.map((provider) => (
                                    <button type="button" class="provider-filter-btn" data-provider-filter={provider.name} aria-pressed="false">{provider.name}</button>
                                ))}
                            </div>
                            <span id="ultimate-filter-count" class="filter-count" aria-live="polite">{canonicalModels.length} models</span>
                            <button id="ultimate-filter-clear" class="filter-clear" type="button" hidden>Clear filters</button>
                        </div>

                        <section class="pareto-panel" hidden aria-labelledby="pareto-title">
                            <header class="pareto-header">
                                <div>
                                    <span class="pareto-kicker">Price × capability</span>
                                    <h3 id="pareto-title">The cost/performance frontier</h3>
                                </div>
                                <p>Every frontier model offers a performance level no cheaper model can match. Everything below the gold line is dominated by a stronger bargain.</p>
                                <div class="pareto-stat"><strong>{paretoModels.length}</strong><span>frontier models</span></div>
                            </header>
                            <div class="pareto-legend" aria-hidden="true">
                                <span><i class="frontier-dot"></i>Pareto frontier</span>
                                <span><i></i>Other models</span>
                                <small>Higher score · Lower cost ↖</small>
                            </div>
                            <div class="pareto-chart-wrap">
                                <svg class="pareto-chart" viewBox={`0 0 ${chartWidth} ${chartHeight}`} role="img" aria-labelledby="pareto-svg-title pareto-svg-desc">
                                    <title id="pareto-svg-title">Model performance versus blended token cost</title>
                                    <desc id="pareto-svg-desc">A logarithmic scatter plot scaled from zero to the current state-of-the-art score. Models on the gold Pareto frontier are not outperformed by any model at the same or lower price.</desc>
                                    <rect class="chart-plot-bg" x={chartPad.left} y={chartPad.top} width={chartWidth - chartPad.left - chartPad.right} height={chartHeight - chartPad.top - chartPad.bottom} rx="14"/>
                                    {scoreTicks.map((tick, index) => (
                                        <g class={`chart-grid ${index === scoreTicks.length - 1 ? 'sota-grid' : ''}`}>
                                            <line x1={chartPad.left} y1={chartY(tick)} x2={chartWidth - chartPad.right} y2={chartY(tick)}/>
                                            <text x={chartPad.left - 18} y={chartY(tick) + 5}>{tick.toFixed(1)}%</text>
                                        </g>
                                    ))}
                                    {costTicks.map((tick) => (
                                        <g class="chart-grid chart-grid-x">
                                            <line x1={chartX(tick)} y1={chartPad.top} x2={chartX(tick)} y2={chartHeight - chartPad.bottom}/>
                                            <text x={chartX(tick)} y={chartHeight - chartPad.bottom + 32}>${tick < 1 ? tick.toFixed(2) : tick}</text>
                                        </g>
                                    ))}
                                    <text class="axis-title" x={(chartWidth + chartPad.left - chartPad.right) / 2} y={chartHeight - 15}>BLENDED COST · USD PER 1M TOKENS · LOG SCALE</text>
                                    <text class="axis-title axis-title-y" transform={`translate(20 ${(chartHeight - chartPad.bottom + chartPad.top) / 2}) rotate(-90)`}>OVERALL SCORE · CURRENT DATASET</text>
                                    <polyline class="frontier-glow" points={frontierPoints}/>
                                    <polyline class="frontier-line" points={frontierPoints}/>
                                    {pricedModels.map((item) => {
                                        const px = chartX(item.blendedCost);
                                        const py = chartY(item.ultimateScore);
                                        const isFrontier = paretoNames.has(item.name);
                                        const alignRight = px > chartWidth - 280;
                                        return (
                                            <g
                                                class={`pareto-point ${isFrontier ? 'is-frontier' : ''}`}
                                                data-model-name={item.name.toLowerCase()}
                                                data-provider={getModelProvider(item.name).name}
                                                transform={`translate(${px} ${py})`}
                                                tabindex="0"
                                                role="img"
                                                aria-label={`${item.name}: ${formatAggregateScore(item.ultimateScore)} percent overall at $${item.blendedCost.toFixed(2)} per million tokens`}
                                            >
                                                <circle r={isFrontier ? 8.5 : 5.5}/>
                                                {isFrontier && (
                                                    <text x={alignRight ? -13 : 13} y="-11" text-anchor={alignRight ? 'end' : 'start'}>
                                                        {item.name}
                                                    </text>
                                                )}
                                                <title>{item.name} · {formatAggregateScore(item.ultimateScore)}% · ${item.blendedCost.toFixed(2)}/1M tokens</title>
                                            </g>
                                        );
                                    })}
                                </svg>
                            </div>
                            {pricedModels.length === 0 && <p class="pareto-empty" role="status">No qualified models have valid verified pricing for this cost comparison.</p>}
                            {omittedPricingCount > 0 && <p class="pareto-omission" role="note">{omittedPricingCount} qualified {omittedPricingCount === 1 ? 'model is' : 'models are'} omitted from this cost comparison because verified pricing is unavailable or invalid.</p>}
                            <p class="pareto-footnote">
                                <svg class="note-arrow" aria-hidden="true" width="13" height="13" viewBox="0 0 16 16"><path d="M3 3v7h10m-4-4 4 4-4 4" /></svg>
                                Cost blends 75% input and 25% output token pricing. Prices checked {PRICING_CHECKED_ON}; both axes preserve the raw benchmark data—no invented efficiency score.
