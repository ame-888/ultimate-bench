    .ultimate-row-hover { border-radius: 8px; }
    .ultimate-row-hover:hover { background: #142137 !important; transform: none !important; }
    .ultimate-score-cell { color: #fbbf24 !important; text-shadow: none !important; }
    .home-grid { align-items: flex-start; gap: 1rem; }
    .home-column { border-color: #26344c; border-radius: 14px; background: #0d1728; box-shadow: none; }
    .home-column-header { border-bottom-color: #26344c; }
    .home-column-header h2 { color: #e2e8f0; font-size: 1rem; letter-spacing: .04em; }
    .expand-btn { border: 1px solid #334155; border-radius: 7px; background: transparent; color: #94a3b8; }
    .home-column .benchmark-container { padding: .4rem; border: 0; background: transparent; box-shadow: none; }
    .creature-icon svg { width: 28px; height: 28px; filter: drop-shadow(0 2px 4px rgba(0,0,0,.28)); }

    @media (max-width: 800px) {
        main { margin-top: 1.5rem; }
