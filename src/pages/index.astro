                    <style>
                        .singularity-journey-section { position:relative; isolation:isolate; max-width:1040px; margin:4rem auto; padding:clamp(2rem,5vw,4.5rem); overflow:hidden; border:1px solid rgba(96,165,250,.16); border-radius:32px; background:linear-gradient(145deg,rgba(10,20,40,.98),rgba(15,23,42,.94)); box-shadow:0 30px 80px rgba(0,0,0,.35),inset 0 1px rgba(255,255,255,.04); }
