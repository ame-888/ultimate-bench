                        .sota-node:hover .sota-node-dot,.sota-node:focus-visible .sota-node-dot,.sota-node.selected .sota-node-dot { transform:translate(-50%,-50%) scale(1.35); border-color:var(--milestone); background:color-mix(in srgb,var(--milestone) 25%,#132038); }
                        .sota-node:hover .sota-node-label,.sota-node:focus-visible .sota-node-label,.sota-node.selected .sota-node-label { transform:translateY(-50%) translateX(-5px); }
