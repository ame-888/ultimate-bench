                                            <span class="sota-node-dot"><i></i></span>
                                            <span class="sota-node-label"><b>{milestone.name}</b><small>{milestone.score}%</small></span>
                                        </button>
                                    ))}
                                </div>
                            </div>

                            <aside id="milestone-details-panel" class="milestone-details-panel" aria-live="polite">
