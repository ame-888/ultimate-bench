                    </div>
                </div>

                <!-- Homepage Combined View -->
                <div id="home-wrapper">
                    <div class="benchmark-description">
                        <p>Welcome to Ultimate Bench. The global leaderboard summarizes model performance across all tasks using Progressive Level Weighting.</p>
                    </div>

                    <!-- Ultimate Global Bench Section -->
                    <section class="ultimate-bench-section" id="global-leaderboard" aria-labelledby="ultimate-leaderboard-title">
                        <header class="ultimate-title-container">
                            <div class="ultimate-sigil" aria-hidden="true"><span>UB</span></div>
                            <div class="ultimate-heading-copy">
                                <span class="leaderboard-kicker">Experimental ranking across three arenas</span>
                                <h2 class="ultimate-title" id="ultimate-leaderboard-title"><span>Global</span>Ultimate Bench</h2>
                                <p class="leaderboard-subtitle">The models that can do it all—ranked across vision, retrieval, and strategic reasoning.</p>
                            </div>
                            <div class="title-rule" aria-hidden="true"><span></span><i>✦</i><span></span></div>
                            <div class="leaderboard-meta" aria-label="Leaderboard overview">
                                <div><strong>{canonicalModels.length}</strong><span>qualified models</span></div>
                                <div><strong>3</strong><span>benchmark arenas</span></div>
                                <div><strong>{sotaScore.toFixed(1)}%</strong><span>highest current Overall</span></div>
                            </div>
                        </header>

                        <div class="leaderboard-controls" aria-label="Filter leaderboard models">
                            <div class="score-mode" role="group" aria-label="Leaderboard scoring mode">
                                <button type="button" class="score-mode-btn is-active" data-score-mode="absolute" aria-pressed="true">Absolute</button>
                                <button type="button" class="score-mode-btn" data-score-mode="pareto">Pareto chart</button>
                            </div>
                            <label class="model-search">
                                <span class="sr-only">Search models</span>
                                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m21 21-4.35-4.35m2.1-5.4a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z"/></svg>
                                <input id="ultimate-model-filter" type="search" placeholder="Find a model…" autocomplete="off" />
                                <kbd>/</kbd>
                            </label>
                            <div class="provider-filter" role="group" aria-label="Filter by provider">
                                <button type="button" class="provider-filter-btn is-active" data-provider-filter="all" aria-pressed="true">All</button>
                                {modelProviders.map((provider) => (
                                    <button type="button" class="provider-filter-btn" data-provider-filter={provider.name} aria-pressed="false">{provider.name}</button>
                                ))}
                            </div>
                            <span id="ultimate-filter-count" class="filter-count" aria-live="polite">{canonicalModels.length} models</span>
                            <button id="ultimate-filter-clear" class="filter-clear" type="button" hidden>Clear filters</button>
                        </div>

                        <section class="pareto-panel" hidden aria-labelledby="pareto-title">
                            <header class="pareto-header">
                                <div><span class="pareto-kicker">Price × capability</span><h3 id="pareto-title">The cost/performance frontier</h3></div>
                                <p>Every frontier model offers a performance level no cheaper model can match. Everything below the gold line is dominated by a stronger bargain.</p>
                                <div class="pareto-stat"><strong>{paretoModels.length}</strong><span>frontier models</span></div>
                            </header>
                            <div class="pareto-legend" aria-hidden="true"><span><i class="frontier-dot"></i>Pareto frontier</span><span><i></i>Other models</span><small>Higher score · Lower cost ↖</small></div>
                            <div class="pareto-chart-wrap">
                                <svg class="pareto-chart" viewBox={`0 0 ${chartWidth} ${chartHeight}`} role="img" aria-labelledby="pareto-svg-title pareto-svg-desc">
                                    <title id="pareto-svg-title">Model performance versus blended token cost</title>
                                    <desc id="pareto-svg-desc">A logarithmic scatter plot scaled from zero to the current state-of-the-art score. Models on the gold Pareto frontier are not outperformed by any model at the same or lower price.</desc>
                                    <rect class="chart-plot-bg" x={chartPad.left} y={chartPad.top} width={chartWidth - chartPad.left - chartPad.right} height={chartHeight - chartPad.top - chartPad.bottom} rx="14"/>
                                    {scoreTicks.map((tick, index) => <g class={`chart-grid ${index === scoreTicks.length - 1 ? 'sota-grid' : ''}`}><line x1={chartPad.left} y1={chartY(tick)} x2={chartWidth - chartPad.right} y2={chartY(tick)}/><text x={chartPad.left - 18} y={chartY(tick) + 5}>{tick.toFixed(1)}%</text></g>)}
                                    {costTicks.map(tick => <g class="chart-grid chart-grid-x"><line x1={chartX(tick)} y1={chartPad.top} x2={chartX(tick)} y2={chartHeight - chartPad.bottom}/><text x={chartX(tick)} y={chartHeight - chartPad.bottom + 32}>${tick < 1 ? tick.toFixed(2) : tick}</text></g>)}
                                    <text class="axis-title" x={(chartWidth + chartPad.left - chartPad.right) / 2} y={chartHeight - 15}>BLENDED COST · USD PER 1M TOKENS · LOG SCALE</text>
                                    <text class="axis-title axis-title-y" transform={`translate(20 ${(chartHeight - chartPad.bottom + chartPad.top) / 2}) rotate(-90)`}>OVERALL SCORE · CURRENT DATASET</text>
                                    <polyline class="frontier-glow" points={frontierPoints}/><polyline class="frontier-line" points={frontierPoints}/>
                                    {pricedModels.map(item => (
                                        <g class={`pareto-point ${paretoNames.has(item.name) ? 'is-frontier' : ''}`} data-model-name={item.name.toLowerCase()} data-provider={getModelProvider(item.name).name} transform={`translate(${chartX(item.blendedCost)} ${chartY(item.ultimateScore)})`} tabindex="0" role="img" aria-label={`${item.name}: ${item.ultimateScore.toFixed(1)} percent overall at $${item.blendedCost.toFixed(2)} per million tokens`}>
                                            <circle r={paretoNames.has(item.name) ? 9 : 6}/>
                                            {paretoNames.has(item.name) && <text x="12" y="-11">{item.name}</text>}
                                            <title>{item.name} · {item.ultimateScore.toFixed(1)}% · ${item.blendedCost.toFixed(2)}/1M tokens</title>
                                        </g>
                                    ))}
                                </svg>
                            </div>
                            {pricedModels.length === 0 && <p class="pareto-empty" role="status">No qualified models have valid verified pricing for this cost comparison.</p>}
                            {omittedPricingCount > 0 && <p class="pareto-omission" role="note">{omittedPricingCount} qualified {omittedPricingCount === 1 ? 'model is' : 'models are'} omitted from this cost comparison because verified pricing is unavailable or invalid.</p>}
                            <p class="pareto-footnote"><span>↳</span> Cost blends 75% input and 25% output token pricing. Prices checked {PRICING_CHECKED_ON}; both axes preserve the raw benchmark data—no invented efficiency score.</p>
