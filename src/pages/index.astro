                        @media (max-width:580px) { .singularity-journey-section { padding:2.5rem 1rem; border-radius:22px; } .journey-dashboard { display:block; } .journey-stat-card { max-width:250px; margin:0 auto 2rem; text-align:center; } .sota-loading-container { width:260px; height:470px; margin:auto; transform:translateX(25px); } .milestone-details-panel { margin-top:2rem; } .sota-node-label b { font-size:.62rem; } }
                        @media (prefers-reduced-motion:reduce) { .journey-stars i,.rocket-orbit,.sota-bar-fill,.journey-mini-track span { animation:none; } }
