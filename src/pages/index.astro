                        .milestone-panel-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; }
                        .milestone-icon { display:grid; place-items:center; width:40px; height:40px; border:1px solid #A855F7; border-radius:12px; background:rgba(168,85,247,.1); box-shadow:0 0 20px rgba(168,85,247,.18); }
                        .milestone-icon span { width:9px; height:9px; border-radius:50%; background:currentColor; box-shadow:0 0 12px currentColor; }
