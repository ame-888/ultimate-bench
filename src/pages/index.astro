                                                <td class={`ultimate-metric ultimate-${type}-score-cell score-cell`} data-score={score}>
                                                    <span class="score-value" style={`--score-fill: ${Math.max(0, Math.min(100, score))}%`}><strong>{score.toFixed(1)}</strong><small>%</small></span>
                                                </td>
                                            ))}
                                            <td class="ultimate-score-cell score-cell" data-absolute-score={item.ultimateScore.toFixed(1)}><span class="score-value" style={`--score-fill: ${Math.max(0, Math.min(100, item.ultimateScore))}%`}><strong>{item.ultimateScore.toFixed(1)}</strong><small>%</small></span></td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                                <div id="ultimate-filter-empty" class="ultimate-empty" hidden>No models match those filters.</div>
                                {canonicalModels.length === 0 && <div class="ultimate-empty">No models currently span all three benchmarks.</div>}
                            </div>
                        </div>
                        <p class="leaderboard-note absolute-note"><span>↳</span> Overall equally averages the three progressively weighted arena scores. Token price does not affect it.</p>
                    </section>

                    <!-- Score-positioned capability journey with illustrative milestones. -->
                    <section class="singularity-journey-section" aria-labelledby="journey-title">
                        <div class="journey-stars" aria-hidden="true">
                            {Array.from({ length: 34 }, (_, i) => (
                                <i style={`--x:${(i * 47) % 97}%;--y:${(i * 71) % 93}%;--d:${2 + (i % 5)}s;--s:${1 + (i % 3)}px`}></i>
