                        .journey-header p { max-width:550px; margin:1rem auto 0; color:#94A3B8; line-height:1.65; }
                        .journey-dashboard { display:grid; grid-template-columns:minmax(160px,1fr) 270px minmax(190px,1.15fr); gap:clamp(1rem,4vw,3.5rem); align-items:center; }
