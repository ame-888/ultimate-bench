                                                        <strong class="model-name" data-release-date={item.releaseDate}>{item.name}</strong>
                                                        {isNew(item.releaseDate) && <span class="new-badge">NEW</span>}{item.rank === null && <span class="provisional-badge">PROVISIONAL</span>}
                                                    </div>
                                                </div>
