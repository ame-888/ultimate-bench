                                    <th scope="col" aria-sort="none"><button id="ultimate-data-sort-btn" aria-label="Sort by Data Score"><span>Data Score</span><small id="ultimate-data-sort-text" aria-hidden="true">▼</small></button></th>
                                    <th scope="col" aria-sort="none"><button id="ultimate-chess-sort-btn" aria-label="Sort by Chess Score"><span>Chess Score</span><small id="ultimate-chess-sort-text" aria-hidden="true">▼</small></button></th>
                                    <th scope="col" aria-sort="descending"><button id="ultimate-sort-btn" class="overall-sort" aria-label="Sort by Overall Score"><span>Overall Score</span><small id="ultimate-sort-text" aria-hidden="true">▼</small></button></th>
                                </tr></thead>
                                <tbody class="ultimate-table-body">
                                    {canonicalModels.map((item) => (
