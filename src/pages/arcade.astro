---
import Layout from '../layouts/Layout.astro';
import GameCenter from '../components/GameCenter.astro';
---
<Layout title="Arcade | Ultimate Bench" description="Six handcrafted browser games. No downloads, no accounts—just play.">
    <main class="arcade-page">
        <header class="arcade-hero">
            <h1>Arcade</h1>
            <p>Six optional browser games. Scores and saved progress stay in your browser.</p>
        </header>
        <section id="library" class="library-shell">
            <div class="library-content"><GameCenter mode="embedded" /></div>
        </section>
    </main>
</Layout>

<style>
.arcade-page {
    max-width: 68rem;
    margin: auto;
    padding: 2.75rem 1.5rem 4.25rem;
}

.arcade-hero {
    max-width: 48rem;
    margin-bottom: 2rem;
}

.arcade-hero h1 {
    margin: 0 0 0.7rem;
    font-size: clamp(2rem, 4.4vw, 3rem);
    letter-spacing: -0.03em;
}

.arcade-hero p {
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
}

.library-shell {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, #101c31 0%, #0d1728 100%);
    box-shadow: var(--surface-highlight), var(--shadow-card);
}

@media (max-width: 640px) {
    .arcade-page {
        padding: 1.75rem 1rem 3rem;
    }

    .library-shell {
        padding: 1rem;
    }
}
</style>
