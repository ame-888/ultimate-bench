---
import Layout from '../layouts/Layout.astro';
import GameCenter from '../components/GameCenter.astro';
---
<Layout title="Arcade | Ultimate Bench" description="Six handcrafted browser games. No downloads, no accounts—just play.">
  <main class="arcade-page">
    <header class="arcade-hero"><h1>Arcade</h1><p>Six optional browser games. Scores and saved progress stay in your browser.</p></header>
    <section id="library" class="library-shell">
      <div class="library-content"><GameCenter mode="embedded" /></div>
    </section>

  </main>
</Layout>
<style>
.arcade-page{max-width:68rem;margin:auto;padding:2.75rem 1.5rem 4rem}.arcade-hero{max-width:48rem;margin-bottom:2rem}.arcade-hero h1{margin:0 0 .75rem;font-size:clamp(1.85rem,4vw,2.6rem)}.arcade-hero p{color:var(--muted);line-height:1.75}.library-shell{border-top:1px solid var(--line);padding-top:1.5rem}
@media(max-width:640px){.arcade-page{padding:1.75rem 1rem 3rem}}
</style>
