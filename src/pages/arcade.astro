---
import Layout from '../layouts/Layout.astro';
import GameCenter from '../components/GameCenter.astro';
import SitePlayground from '../components/SitePlayground.astro';
---
<Layout title="Synaptic Arcade — Play the machine | Ultimate Bench" description="Six handcrafted browser games. No downloads, no accounts—just play.">
  <main class="arcade-page">
    <section class="arcade-hero">
      <div class="hero-noise" aria-hidden="true"></div>
      <div class="hero-topline"><span>ULTIMATE BENCH / EXPERIMENT 07</span><span class="system-status"><i></i> ALL SYSTEMS NOMINAL</span></div>
      <div class="hero-copy">
        <p class="hero-kicker">THE BROWSER IS<br/>THE CONSOLE.</p>
        <h1>SYNAPTIC<br/><em>ARCADE</em></h1>
        <div class="hero-aside"><p>Six small worlds built to test reflex, logic, nerve, and curiosity.</p><a href="#library">Start playing <span>↓</span></a></div>
      </div>
      <div class="hero-footer"><span>NO DOWNLOADS</span><span>NO ACCOUNTS</span><span>LOCAL HIGH SCORES</span><span>EST. 2025</span></div>
    </section>
    <section id="library" class="library-shell">
      <div class="section-rail" aria-hidden="true"><span>01</span><span>PROGRAM DIRECTORY</span></div>
      <div class="library-content"><GameCenter mode="embedded" /></div>
    </section>
    <section class="manifesto"><span class="manifesto-index">ABOUT THE MACHINE</span><p>Games are benchmarks with <em>consequences.</em> Every run turns attention into a score, uncertainty into a choice, and a quiet browser tab into somewhere else entirely.</p><a href="/methodology">Read our methodology ↗</a></section>
  </main>
  <SitePlayground />
</Layout>
<style>
  .arcade-page{background:#07090d;color:#e9e7df;min-height:100vh}.arcade-hero{position:relative;min-height:calc(100vh - 4rem);padding:clamp(1rem,3vw,2.5rem) clamp(1rem,5vw,5rem);box-sizing:border-box;display:flex;flex-direction:column;overflow:hidden;background:radial-gradient(circle at 75% 25%,rgba(114,65,255,.24),transparent 32%),radial-gradient(circle at 20% 90%,rgba(201,255,61,.1),transparent 30%),#07090d}.hero-noise{position:absolute;inset:0;opacity:.16;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.35'/%3E%3C/svg%3E")}.hero-topline,.hero-footer{position:relative;display:flex;justify-content:space-between;color:#747975;font:700 .58rem/1 'Inter';letter-spacing:.18em}.system-status{color:#a5aaa6}.system-status i{display:inline-block;width:6px;height:6px;margin-right:.5rem;border-radius:50%;background:#c9ff3d;box-shadow:0 0 12px #c9ff3d}.hero-copy{position:relative;flex:1;display:grid;grid-template-columns:140px 1fr 210px;align-items:center;gap:2rem}.hero-kicker{color:#c9ff3d;font:700 .66rem/1.5 'Inter';letter-spacing:.16em}.hero-copy h1{margin:0;font-size:clamp(4.8rem,13vw,12rem);line-height:.72;letter-spacing:-.09em;font-weight:900;color:#e9e7df}.hero-copy h1 em{font-style:normal;color:transparent;-webkit-text-stroke:1px #8b918c}.hero-aside{align-self:end;margin-bottom:4rem}.hero-aside p{color:#a4aaa5;font-size:.84rem;line-height:1.6}.hero-aside a,.manifesto a{display:flex;justify-content:space-between;border-bottom:1px solid #5b615d;padding:.8rem 0;color:#e9e7df;text-decoration:none;font-size:.72rem;text-transform:uppercase;letter-spacing:.12em}.hero-footer{padding-top:1.2rem;border-top:1px solid rgba(233,231,223,.15)}.library-shell{display:grid;grid-template-columns:70px 1fr;max-width:1280px;margin:auto;padding:7rem 2rem}.section-rail{border-right:1px solid rgba(233,231,223,.12);display:flex;flex-direction:column;gap:1.5rem;color:#707570;font:700 .58rem Inter;letter-spacing:.15em}.section-rail span:last-child{writing-mode:vertical-rl}.library-content{padding-left:clamp(1rem,4vw,4rem)}.manifesto{padding:clamp(4rem,9vw,9rem) max(1rem,8vw);background:#c9ff3d;color:#090b0e}.manifesto-index{font:800 .6rem Inter;letter-spacing:.18em}.manifesto p{max-width:1050px;margin:2rem 0;font:700 clamp(2rem,5vw,5rem)/1.05 Poppins;letter-spacing:-.055em}.manifesto p em{font-style:normal;color:rgba(9,11,14,.36)}.manifesto a{max-width:260px;color:#090b0e;border-color:#090b0e}
  @media(max-width:800px){.arcade-hero{min-height:760px}.hero-copy{grid-template-columns:1fr;align-content:center;gap:1rem}.hero-copy h1{font-size:clamp(4.3rem,21vw,8rem)}.hero-kicker{margin:0}.hero-aside{align-self:auto;margin:1rem 0 0;max-width:300px}.hero-footer{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.library-shell{grid-template-columns:1fr;padding:4rem 1rem}.section-rail{display:none}.library-content{padding:0}}
</style>
