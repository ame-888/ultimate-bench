---
import Layout from '../layouts/Layout.astro';
import { benchmarks } from '../data/benchmarks';

const editionDate = 'July 27, 2026';
const isScore = (value: unknown): value is number => typeof value === 'number' && Number.isFinite(value);
const mean = (values: number[]) => values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : null;
const scoreMean = (scores: Record<string, unknown>) => mean(Object.values(scores).filter(isScore));
const format = (value: number | null, digits = 1) => value === null ? '—' : `${value.toFixed(digits)}%`;
const unique = <T extends { name: string }>(rows: T[]) => [...new Map(rows.map((row) => [row.name, row])).values()];

const categories = [
    { id: 'visual', short: 'Visual', name: 'Visual reasoning', rows: unique(benchmarks.models), keys: ['lvl1', 'lvl2', 'lvl3', 'lvl4', 'lvl5'] },
    { id: 'data', short: 'Data', name: 'Data retrieval', rows: unique(benchmarks.dataRetrieval || []), keys: ['worm', 'koala', 'crow', 'octopus'] },
    { id: 'chess', short: 'Chess', name: 'Chess', rows: unique(benchmarks.chessModels || []), keys: ['mouse', 'spider', 'wolf', 'hawk', 'python'] },
];

const rankedCategories = categories.map((category) => ({
    ...category,
    ranking: category.rows
        .map((row) => ({ name: row.name, score: scoreMean(row.scores), coverage: Object.values(row.scores).filter(isScore).length }))
        .filter((row): row is { name: string; score: number; coverage: number } => row.score !== null)
        .sort((a, b) => b.score - a.score),
}));

const allNames = new Set(rankedCategories.flatMap((category) => category.rows.map(({ name }) => name)));
const crossDomain = [...allNames].map((name) => {
    const scores = rankedCategories.map((category) => {
        const row = category.rows.find((candidate) => candidate.name === name);
        return row ? scoreMean(row.scores) : null;
    });
    return { name, scores, overall: scores.every(isScore) ? mean(scores as number[]) : null };
}).filter((row): row is { name: string; scores: number[]; overall: number } => row.overall !== null)
  .sort((a, b) => b.overall - a.overall);

const visualDifficulty = rankedCategories[0].keys.map((key, index) => {
    const values = rankedCategories[0].rows.map((row) => row.scores[key as keyof typeof row.scores]).filter(isScore);
    return { label: `L${index + 1}`, average: mean(values) ?? 0, solved: values.filter((value) => value > 0).length, tested: values.length };
});

const executionPairs = [
    ['Gemini 3.6 Flash', 'Gemini 3.6 Flash (with code execution)'],
    ['Gemini 3.1 Pro Preview', 'Gemini 3.1 Pro Preview (with code execution)'],
    ['Gemini 3.1 Flashlite GA', 'Gemini 3.1 Flashlite GA (with code execution)'],
].map(([baseName, toolName]) => {
    const base = rankedCategories[0].rows.find((row) => row.name === baseName)!;
    const tool = rankedCategories[0].rows.find((row) => row.name === toolName)!;
    const comparableKeys = rankedCategories[0].keys.filter((key) => isScore(base.scores[key as keyof typeof base.scores]) && isScore(tool.scores[key as keyof typeof tool.scores]));
    const baseAverage = mean(comparableKeys.map((key) => Number(base.scores[key as keyof typeof base.scores])))!;
    const toolAverage = mean(comparableKeys.map((key) => Number(tool.scores[key as keyof typeof tool.scores])))!;
    return { name: baseName, baseAverage, toolAverage, lift: toolAverage - baseAverage, levels: comparableKeys.length };
});

const leader = crossDomain[0];
const runnerUp = crossDomain[1];
const lead = leader.overall - runnerUp.overall;
const hardLevelAverage = visualDifficulty[3].average;
const totalRuns = rankedCategories.reduce((sum, category) => sum + category.rows.length, 0);
---

<Layout title="Analysis | Ultimate Bench" description="A data-first analysis of Ultimate Bench results across visual reasoning, data retrieval, and chess.">
    <main class="analysis-page">
        <header class="analysis-hero">
            <div>
                <p class="eyebrow">Analysis · updated {editionDate}</p>
                <h1>What the benchmark<br /><em>actually shows.</em></h1>
                <p class="deck">Numbers first: category leaders, difficulty curves, tool impact, and the models that hold up across every test.</p>
            </div>
            <div class="hero-result">
                <span>Overall leader</span>
                <strong>{leader.name}</strong>
                <div><b>{format(leader.overall)}</b><small>3-category average</small></div>
            </div>
        </header>

        <section class="kpi-grid" aria-label="Key benchmark statistics">
            <article><span>Lead over #2</span><strong>+{lead.toFixed(1)}</strong><small>percentage points</small></article>
            <article><span>Complete models</span><strong>{crossDomain.length}</strong><small>tested in all 3 categories</small></article>
            <article><span>Visual L4 average</span><strong>{format(hardLevelAverage)}</strong><small>across {visualDifficulty[3].tested} valid runs</small></article>
            <article><span>Published runs</span><strong>{totalRuns}</strong><small>unique category configurations</small></article>
        </section>

        <section class="data-section" aria-labelledby="leaders-title">
            <div class="section-head">
                <div><p class="section-label">01 · category rankings</p><h2 id="leaders-title">Who wins each test?</h2></div>
                <p>Mean score across every valid level. Zeroes count; INVALID and UNAVAILABLE results do not.</p>
            </div>
            <div class="ranking-grid">
                {rankedCategories.map((category) => (
                    <article class="ranking-card">
                        <header><div><span>{category.name}</span><strong>{format(category.ranking[0].score)}</strong></div><small>{category.ranking[0].name}</small></header>
                        <ol>
                            {category.ranking.slice(0, 5).map((row, index) => (
                                <li>
                                    <span class="rank">{index + 1}</span>
                                    <div class="model"><span>{row.name}</span><i style={`--score:${row.score}%`}></i></div>
                                    <strong>{format(row.score)}</strong>
                                </li>
                            ))}
                        </ol>
                    </article>
                ))}
            </div>
        </section>

        <section class="data-section difficulty" aria-labelledby="difficulty-title">
            <div class="section-head">
                <div><p class="section-label">02 · difficulty curve</p><h2 id="difficulty-title">Visual performance collapses after Level 3.</h2></div>
                <p>The average falls to {format(hardLevelAverage)} at Level 4. Level 5 is currently at 0% across every valid run.</p>
            </div>
            <div class="chart" role="img" aria-label="Average visual score by difficulty level">
                {visualDifficulty.map((level) => (
                    <div class="bar-column">
                        <div class="bar-value">{format(level.average)}</div>
                        <div class="bar-track"><i style={`--height:${Math.max(level.average, .6)}%`}></i></div>
                        <strong>{level.label}</strong>
                        <small>{level.solved}/{level.tested} scored above 0</small>
                    </div>
                ))}
            </div>
            <div class="plain-finding"><strong>Read it plainly:</strong> high scores on Levels 1–3 do not imply frontier-level success. Level 4 separates the field; Level 5 remains unsolved.</div>
        </section>

        <section class="data-section" aria-labelledby="tools-title">
            <div class="section-head">
                <div><p class="section-label">03 · tool impact</p><h2 id="tools-title">How much does code execution help?</h2></div>
                <p>Like-for-like visual configurations, averaged only across levels where both versions have numeric results.</p>
            </div>
            <div class="tool-table">
                <div class="tool-row tool-head"><span>Model pair</span><span>Base</span><span>With code</span><span>Lift</span></div>
                {executionPairs.map((pair) => (
                    <div class="tool-row">
                        <div><strong>{pair.name}</strong><small>{pair.levels} comparable levels</small></div>
                        <span>{format(pair.baseAverage)}</span><span>{format(pair.toolAverage)}</span><b>+{pair.lift.toFixed(1)} pts</b>
                    </div>
                ))}
            </div>
            <p class="caveat">Code execution improves every matched pair here, but this is a system comparison—not proof that the underlying model alone became better. Invalid assisted runs are excluded.</p>
        </section>

        <section class="data-section" aria-labelledby="overall-title">
            <div class="section-head">
                <div><p class="section-label">04 · complete field</p><h2 id="overall-title">Who performs across all three?</h2></div>
                <p>Unweighted mean of the three category averages. Only configurations with a numeric result in every category qualify.</p>
            </div>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>#</th><th>Configuration</th>{rankedCategories.map((category) => <th>{category.short}</th>)}<th>Overall</th></tr></thead>
                    <tbody>{crossDomain.map((row, index) => <tr><td>{String(index + 1).padStart(2, '0')}</td><td>{row.name}</td>{row.scores.map((score) => <td>{format(score)}</td>)}<td><strong>{format(row.overall)}</strong></td></tr>)}</tbody>
                </table>
            </div>
        </section>

        <section class="bottom-line" aria-labelledby="bottom-line-title">
            <p class="section-label">Bottom line</p>
            <h2 id="bottom-line-title">Three conclusions supported by the data.</h2>
            <div>
                <article><b>1</b><p><strong>{leader.name} is the most balanced.</strong> It leads the complete field and scores between {format(Math.min(...leader.scores))} and {format(Math.max(...leader.scores))} across the three categories.</p></article>
                <article><b>2</b><p><strong>There is no universal category winner.</strong> {rankedCategories.map((category) => category.ranking[0].name).filter((name, index, names) => names.indexOf(name) === index).length} different configurations lead the three benchmark families.</p></article>
                <article><b>3</b><p><strong>The benchmark is measuring a frontier, not mastery.</strong> Visual Level 5, chess Hawk, and chess Python all have no positive result.</p></article>
            </div>
            <footer><span>Calculated directly from the published dataset at build time.</span><a href="/methodology">Methods and limitations →</a></footer>
        </section>
    </main>
</Layout>

<style>
