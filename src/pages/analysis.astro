mega{display:block;color:#fff;font-size:clamp(3.5rem,7vw,6rem);letter-spacing:-.08em}.mega i{margin-left:.5rem;color:#60738a;font-size:.8rem;font-style:normal;letter-spacing:0}.curve{height:9rem;display:flex;gap:.45rem;align-items:end;margin-top:1.5rem}.curve>div{display:grid;grid-template-rows:1fr auto auto;width:20%;height:100%;text-align:center}.curve i{align-self:end;height:var(--h);min-height:2px;border-radius:.25rem .25rem 0 0;background:linear-gradient(var(--cyan),#2563eb)}.curve b{padding-top:.4rem;color:#dce9f6;font-size:.7rem}.curve small{color:#60738a;font-size:.6rem}.pair-list>div{display:grid;grid-template-columns:1fr 1fr auto;gap:.8rem;align-items:center;padding:1rem 0;border-bottom:1px solid var(--line);font-size:.75rem}.pair-list i{height:5px;width:var(--w);max-width:100%;background:#a3e635}.pair-list b{color:#d9f99d}.profile-table{overflow-x:auto}.profile-head,.profile-row{display:grid;grid-template-columns:minmax(15rem,1.5fr) repeat(3,minmax(7rem,1fr)) 4rem;gap:.8rem;align-items:center;min-width:720px}.profile-head{padding:.7rem;color:#61738a;font-size:.62rem;text-transform:uppercase}.profile-row{padding:.85rem .7rem;border-top:1px solid var(--line)}.profile-row>strong{overflow:hidden;color:#dbe7f4;font-size:.73rem;text-overflow:ellipsis;white-space:nowrap}.profile-row span{position:relative;height:1.2rem;background:#172538}.profile-row i{display:block;width:var(--w);height:100%;background:#1d5672}.profile-row b{position:absolute;right:.25rem;top:.15rem;color:#e5f7ff;font-size:.62rem}.profile-row em{color:#8295aa;font-size:.7rem;font-style:normal}.leaders>div{display:grid;grid-template-columns:5rem 1fr auto;gap:.8rem;padding:1rem 0;border-top:1px solid var(--line);font-size:.75rem}.leaders span{color:#6f8197}.leaders strong{color:#e2e8f0}.leaders b{color:var(--cyan)}.method-note{display:flex;justify-content:space-between;gap:1rem;margin-top:1rem;padding:1.3rem;color:#6f8197;font-size:.72rem}.method-note a{color:#a5f3fc;text-decoration:none}@media(max-width:720px){.findings{grid-template-columns:1fr}.finding.feature{grid-column:auto}.lens-picker{overflow-x:auto}.lens-picker span{display:none}.lens-picker button{white-space:nowrap}.callouts{grid-template-columns:1fr}.method-note{flex-direction:column}}
</style>
