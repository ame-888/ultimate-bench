}

.summary b,
.summary span,
.summary small {
    display: block;
}

.summary b {
    color: var(--accent);
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
}

.summary span {
    margin-top: 0.2rem;
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 500;
}

.summary small {
    margin-top: 0.25rem;
    color: var(--subtle);
    font-size: 0.74rem;
}

