---
import Layout from '../layouts/Layout.astro';
import { benchmarks } from '../data/benchmarks';
import { ARENA_LIST } from '../data/benchmarkSpec';
import { buildLeaderboard } from '../data/leaderboard';

const editionDate = 'July 27, 2026';
const isScore = (value: unknown): value is number => typeof value === 'number' && Number.isFinite(value);
const mean = (values: number[]) => values.length ? values.reduce((sum, value) => sum + value, 0) / values.length : 0;
const scoreMean = (scores: Record<string, unknown>) => mean(Object.values(scores).filter(isScore));
const format = (value: number, digits = 1) => `${value.toFixed(digits)}%`;
const unique = <T extends { name: string }>(rows: T[]) => [...new Map(rows.map((row) => [row.name, row])).values()];

const canonical = buildLeaderboard(benchmarks);
const domains = ARENA_LIST.map(arena => ({ name: arena.shortName, arena, rows: canonical.arenaRows[arena.id] }));
const profiles = canonical.rows.map(row => {
    const scores = ARENA_LIST.map(arena => row.scores[arena.id]);
    const best = Math.max(...scores); const worst = Math.min(...scores);
    return { name: row.name, scores, average: row.score, spread: best - worst, bestDomain: ARENA_LIST[scores.indexOf(best)].name };
});
const mostBalanced = [...profiles].sort((a,b) => a.spread-b.spread)[0];
const mostSpecialized = [...profiles].sort((a,b) => b.spread-a.spread)[0];
const domainLeaders = ARENA_LIST.map(arena => canonical.arenaLeaders[arena.id]).filter((row): row is NonNullable<typeof row> => row !== null);

const visualKeys = ['lvl1', 'lvl2', 'lvl3', 'lvl4', 'lvl5'];
const visualCurve = visualKeys.map((key, index) => {
    const values = benchmarks.models.map((row) => row.scores[key as keyof typeof row.scores]).filter(isScore);
    return { label: `L${index + 1}`, score: mean(values) };
});
const drops = visualCurve.slice(1).map((level, index) => ({ from: visualCurve[index].label, to: level.label, drop: visualCurve[index].score - level.score }));
const cliff = [...drops].sort((a, b) => b.drop - a.drop)[0];

const executionPairs = [
    ['Gemini 3.6 Flash', 'Gemini 3.6 Flash (with code execution)'],
    ['Gemini 3.1 Pro Preview', 'Gemini 3.1 Pro Preview (with code execution)'],
    ['Gemini 3.1 Flashlite GA', 'Gemini 3.1 Flashlite GA (with code execution)'],
].flatMap(([baseName, toolName]) => {
    const base = benchmarks.models.find((row) => row.name === baseName);
    const tool = benchmarks.models.find((row) => row.name === toolName);
    if (!base || !tool) return [];
    const keys = visualKeys.filter((key) => isScore(base.scores[key as keyof typeof base.scores]) && isScore(tool.scores[key as keyof typeof tool.scores]));
    const baseAverage = mean(keys.map((key) => Number(base.scores[key as keyof typeof base.scores])));
    const toolAverage = mean(keys.map((key) => Number(tool.scores[key as keyof typeof tool.scores])));
    return [{ name: baseName.replace('Gemini ', ''), baseAverage, toolAverage, lift: toolAverage - baseAverage }];
});
---

<Layout title="Analysis | Ultimate Bench" description="Patterns, trade-offs, and surprising findings from Ultimate Bench results.">
  <main class="analysis-page">
    <header class="hero">
      <p class="eyebrow">Analysis notebook · {editionDate}</p>
      <h1>Past the leaderboard.</h1>
      <p>Home tells you who scored highest. Here we look for the useful part: <strong>where models break, what tools change, and which strengths transfer.</strong></p>
    </header>

    <nav class="lens-picker" aria-label="Filter analysis cards">
      <span>Choose a lens</span>
      <button class="active" data-lens="all">All findings</button><button data-lens="reliability">Reliability</button><button data-lens="difficulty">Difficulty</button><button data-lens="tools">Tools</button>
    </nav>

    <section class="findings" aria-label="Key findings">
      <article class="finding feature" data-topic="reliability" data-tilt>
        <p class="number">01 / TRANSFER</p><h2>A high score in one arena does not travel automatically.</h2>
        <div class="callouts"><div><span>Most balanced</span><strong>{mostBalanced.name}</strong><small>{mostBalanced.spread.toFixed(1)} point range</small></div><div><span>Most specialized</span><strong>{mostSpecialized.name}</strong><small>{mostSpecialized.spread.toFixed(1)} point range · strongest in {mostSpecialized.bestDomain}</small></div></div>
        <p class="note">Range is the gap between a qualified configuration’s best and worst canonical arena score. Lower means more consistent—not necessarily better.</p>
      </article>

      <article class="finding" data-topic="difficulty" data-tilt>
        <p class="number">02 / THE CLIFF</p><h2>The biggest visual drop is {cliff.from} → {cliff.to}.</h2><strong class="mega">−{cliff.drop.toFixed(1)}<i>pts</i></strong>
        <div class="curve">{visualCurve.map((level) => <div><i style={`--h:${Math.max(level.score, 1)}%`}></i><b>{level.label}</b><small>{format(level.score)}</small></div>)}</div>
        <p class="note">This exploratory flat mean includes numeric results at each Visual level and omits statuses. It is distinct from the canonical progressively weighted score.</p>
      </article>

      <article class="finding" data-topic="tools" data-tilt>
        <p class="number">03 / TOOL EFFECT</p><h2>Code helps, but the size of the help is not stable.</h2>
        <div class="pair-list">{executionPairs.map((pair) => <div><span>{pair.name}</span><i style={`--w:${Math.max(pair.lift * 4, 2)}%`}></i><b>{pair.lift >= 0 ? '+' : ''}{pair.lift.toFixed(1)} pts</b></div>)}</div>
        <p class="note">Matched visual runs only. This compares complete systems; it does not isolate a change in model intelligence.</p>
      </article>

      <article class="finding feature" data-topic="reliability" data-tilt>
        <p class="number">04 / SHAPE OF PERFORMANCE</p><h2>Compare profiles, not just totals.</h2>
        <div class="profile-table"><div class="profile-head"><span>Configuration</span>{domains.map((d) => <span>{d.name}</span>)}<span>Range</span></div>{profiles.map((row) => <div class="profile-row"><strong>{row.name}</strong>{row.scores.map((score) => <span><i style={`--w:${score}%`}></i><b>{format(score, 0)}</b></span>)}<em>{row.spread.toFixed(1)}</em></div>)}</div>
        <p class="note">Only globally qualified configurations appear. Bars use canonical progressively weighted arena scores; the displayed average is canonical Overall.</p>
      </article>

      <article class="finding leaders" data-topic="reliability" data-tilt>
        <p class="number">05 / NO SINGLE CROWN</p><h2>Canonical arena leaders reflect different task-specific strengths.</h2>
        {domainLeaders.map((leader, index) => <div><span>{domains[index].name}</span><strong>{leader.name}</strong><b>{format(leader.score)}</b></div>)}
        <p class="note">That disagreement is the point: an arena leader is highest only on that current Ultimate Bench arena, not generally the most intelligent model.</p>
      </article>
    </section>

    <footer class="method-note"><span>All findings are calculated from the published dataset at build time.</span><a href="/methodology">Audit the methodology →</a></footer>
  </main>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-lens]');
  const cards = document.querySelectorAll<HTMLElement>('[data-topic]');
  buttons.forEach((button) => button.addEventListener('click', () => {
    buttons.forEach((item) => item.classList.toggle('active', item === button));
    cards.forEach((card) => card.classList.toggle('filtered-out', button.dataset.lens !== 'all' && card.dataset.topic !== button.dataset.lens));
  }));
</script>

<style>
