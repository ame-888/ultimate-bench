;color:#f8fafc}.bar-column>small{margin-top:.25rem;color:#66788f;font-size:.65rem}.plain-finding{padding:1rem 1.2rem;border-left:3px solid var(--lime);background:rgba(163,230,53,.06);font-size:.82rem;line-height:1.65}.plain-finding strong{color:#d9f99d}.tool-table,.table-wrap{overflow-x:auto;border:1px solid #29384b;border-radius:1rem}.tool-row{display:grid;grid-template-columns:minmax(18rem,1fr) repeat(3,8rem);align-items:center;min-width:680px;padding:1rem 1.25rem;border-bottom:1px solid #29384b}.tool-row:last-child{border:0}.tool-row>div strong,.tool-row>div small{display:block}.tool-row>div strong{color:#e2e8f0;font-size:.82rem}.tool-row>div small{margin-top:.25rem;color:#64748b;font-size:.68rem}.tool-row>span{color:#c4d0df}.tool-row>b{color:var(--lime)}.tool-head{color:#718198;background:#111c2c;font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.caveat{margin:.8rem 0 0;color:#73849a;font-size:.72rem;line-height:1.6}table{width:100%;min-width:760px;border-collapse:collapse}th,td{padding:1rem 1.1rem;border-bottom:1px solid #26364a;text-align:right;font-size:.78rem}th{color:#718198;background:#111c2c;font-size:.63rem;text-transform:uppercase;letter-spacing:.08em}th:nth-child(2),td:nth-child(2){text-align:left}td:first-child{color:#617188}td:nth-child(2){color:#dce7f5;font-weight:700}td:last-child strong{color:var(--cyan)}tbody tr:last-child td{border:0}.bottom-line{margin-top:clamp(5rem,9vw,8rem);padding:clamp(1.5rem,4vw,2.5rem);border:1px solid rgba(34,211,238,.25);border-radius:1.25rem;background:linear-gradient(130deg,rgba(8,47,73,.28),rgba(15,23,42,.75))}.bottom-line>div{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:2rem}.bottom-line article{display:grid;grid-template-columns:1.5rem 1fr;gap:.8rem;padding:1.3rem;border-top:1px solid #2a4052}.bottom-line article+article{border-left:1px solid #2a4052}.bottom-line article b{color:var(--cyan)}.bottom-line article p{margin:0;font-size:.82rem;line-height:1.7}.bottom-line article strong{color:#f1f5f9}.bottom-line footer{display:flex;justify-content:space-between;gap:1rem;margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid #2a4052;color:#6f8197;font-size:.7rem}.bottom-line a{color:#a5f3fc;font-weight:700;text-decoration:none}@media(max-width:850px){.analysis-hero{grid-template-columns:1fr}.hero-result{max-width:22rem}.kpi-grid{grid-template-columns:1fr 1fr}.kpi-grid article:nth-child(2){border-right:0}.kpi-grid article:nth-child(-n+2){border-bottom:1px solid #29384b}.ranking-grid{grid-template-columns:1fr}.section-head{grid-template-columns:1fr;gap:1rem}.bottom-line>div{grid-template-columns:1fr}.bottom-line article+article{border-left:0}.bottom-line footer{flex-direction:column}}@media(max-width:520px){.analysis-page{padding-top:3rem}.kpi-grid{grid-template-columns:1fr 1fr}.kpi-grid strong{font-size:1.45rem}.chart{height:18rem;padding:1.5rem .5rem 1rem}.bar-track i{right:22%;left:22%}.bar-column>small{font-size:.56rem}}
</style>
