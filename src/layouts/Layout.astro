---
import Navbar from '../components/Navbar.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Footer from '../components/Footer.astro';
import '../styles/site.css';

const {
    title = 'Ultimate Bench | AI Model Benchmark',
    description = 'Ultimate Bench is an independent experimental benchmark comparing AI model results across Visual Bench, Data Retrieval Bench, and Chess Bench.',
    robots,
    ogType = 'website'
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const websiteJsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Ultimate Bench', url: new URL('/', Astro.site).href, description: 'Independent experimental AI model benchmarking across visual, data retrieval, and chess evaluations.' };
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <meta name="description" content={description} />
        {robots && <meta name="robots" content={robots} />}
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:type" content={ogType} />
        <meta property="og:site_name" content="Ultimate Bench" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd).replaceAll('<', '\\u003c')} />
        <slot name="head" />
	</head>
	<body>
        <a class="skip-link" href="#main-content">Skip to main content</a>
        <Navbar />

        <div class="content-wrapper" id="main-content" tabindex="-1">
            <slot />
        </div>

        <Footer />

        <CookieBanner />

	</body>
</html>
