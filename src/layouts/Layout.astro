---
import Navbar from '../components/Navbar.astro';
import CookieBanner from '../components/CookieBanner.astro';

const {
    title = 'Ultimate Bench | AI Model Benchmark',
    description = 'Ultimate Bench is an independent experimental benchmark comparing AI model performance across visual, data, and chess evaluations.'
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Ultimate Bench" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;900&display=swap" rel="stylesheet">
        <slot name="head" />
	</head>
	<body>
        <Navbar />

		<div class="content-wrapper">
            <slot />
        </div>

        <!-- Achievement Toast Container -->
        <div id="achievement-toast-container"></div>

        <CookieBanner />

        <!-- Future Progress Bar Floating Button -->
        <a href="https://future-progress-bar.vercel.app/" target="_blank" rel="noopener noreferrer" class="future-progress-button" aria-label="Visit Future Progress Bar">
            <span class="button-icon">🔴</span>
            <span class="button-text">Explore Future Progress ➔</span>
        </a>

	</body>
</html>

<style is:global>
    :root {
        --font-body: 'Inter', sans-serif;
        --font-heading: 'Poppins', sans-serif;
        --color-bg: #111827;
        --color-text: #F3F4F6;
    }

	html,
	body {
		margin: 0;
		width: 100%;
        min-height: 100vh;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-body);
        overflow-x: hidden;
	}

    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
    }

    .content-wrapper {
        position: relative;
        z-index: 1;
        pointer-events: none; /* Let clicks pass through empty spaces */
    }

    .content-wrapper > * {
        pointer-events: auto; /* Re-enable clicks on actual content */
    }

    /* Achievement Toast */
    #achievement-toast-container {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        z-index: 10000;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        pointer-events: none;
    }

    .achievement-toast {
        background: rgba(17, 24, 39, 0.95);
        border: 1px solid #10B981;
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        color: white;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
        transform: translateX(120%);
        transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.27, 1.55);
        pointer-events: auto;
        min-width: 300px;
    }

    .achievement-toast.show {
        transform: translateX(0);
    }

    .achievement-icon {
        font-size: 2rem;
        background: rgba(16, 185, 129, 0.2);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .achievement-info {
        display: flex;
        flex-direction: column;
    }

    .achievement-title {
        font-size: 0.75rem;
        color: #10B981;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
    }

    .achievement-name {
        font-size: 1.1rem;
        font-weight: 600;
    }

    /* Future Progress Bar Button Styles */
    .future-progress-button {
        position: fixed;
        bottom: 2rem;
        left: 2rem;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);
        color: white;
        padding: 0.75rem 1.25rem;
        border-radius: 50px;
        text-decoration: none;
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 0.95rem;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4), 0 0 0 2px rgba(255, 255, 255, 0.1);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        pointer-events: auto;
        animation: float-pulse 3s infinite;
    }

    .future-progress-button:hover {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 8px 25px rgba(239, 68, 68, 0.6), 0 0 0 2px rgba(255, 255, 255, 0.3);
        background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
    }

    .future-progress-button .button-icon {
        animation: pulse-icon 1.5s infinite;
    }

    .future-progress-button .button-text {
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    @keyframes float-pulse {
        0% {
            transform: translateY(0);
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4), 0 0 0 2px rgba(255, 255, 255, 0.1);
        }
        50% {
            transform: translateY(-6px);
            box-shadow: 0 10px 20px rgba(239, 68, 68, 0.5), 0 0 15px rgba(239, 68, 68, 0.6);
        }
        100% {
            transform: translateY(0);
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4), 0 0 0 2px rgba(255, 255, 255, 0.1);
        }
    }

    @keyframes pulse-icon {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.2);
        }
    }

    @media (max-width: 640px) {
        .future-progress-button {
            bottom: 1.5rem;
            left: 50%;
            transform: translateX(-50%);
            padding: 0.6rem 1rem;
            font-size: 0.85rem;
            animation: none; /* Disable complex animations on mobile for performance/ux */
            animation: mobile-pulse 3s infinite;
        }

        @keyframes mobile-pulse {
            0% { transform: translateX(-50%) scale(1); }
            50% { transform: translateX(-50%) scale(1.05); box-shadow: 0 6px 20px rgba(239, 68, 68, 0.6); }
            100% { transform: translateX(-50%) scale(1); }
        }

        .future-progress-button:hover {
            transform: translateX(-50%) translateY(-2px);
        }
    }
</style>
