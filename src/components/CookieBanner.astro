<!-- Production personalized-ad consent in the EEA, UK, and Switzerland must use a Google-certified CMP / Google Privacy & Messaging. This custom preference UI does not claim TCF certification. -->
<div id="cookie-notice" class="cookie-banner" role="region" aria-labelledby="cookie-notice-title" hidden>
    <div class="cookie-content">
        <div>
            <h2 id="cookie-notice-title">Cookie preferences</h2>
            <p>
                We use necessary browser storage for your preferences. With your permission, we also load Google AdSense,
                which may use cookies or similar technologies for advertising. See our <a href="/privacy">Privacy Policy</a>.
            </p>
        </div>
        <div class="cookie-actions">
            <button id="accept-cookies" class="cookie-btn primary" type="button">Accept advertising</button>
            <button id="reject-cookies" class="cookie-btn" type="button">Reject non-essential</button>
            <button id="manage-cookies" class="cookie-btn" type="button" aria-controls="cookie-preferences-dialog" aria-expanded="false">
                Manage preferences
            </button>
        </div>
    </div>
</div>

<div id="cookie-preferences-backdrop" class="cookie-dialog-backdrop" hidden>
    <div
        id="cookie-preferences-dialog"
        class="cookie-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="cookie-dialog-title"
        aria-describedby="cookie-dialog-description"
    >
        <h2 id="cookie-dialog-title">Manage cookie preferences</h2>
        <p id="cookie-dialog-description">Necessary storage is always active. Advertising remains optional.</p>
        <div class="cookie-options">
            <label class="cookie-option">
                <input type="checkbox" checked disabled />
                <span>Necessary storage (always active)</span>
            </label>
            <label class="cookie-option">
                <input id="advertising-consent" type="checkbox" />
                <span>Advertising cookies and services</span>
            </label>
        </div>
        <div class="cookie-actions">
            <button id="save-cookies" class="cookie-btn primary" type="button">Save preferences</button>
            <button id="cancel-cookie-settings" class="cookie-btn" type="button">Cancel</button>
        </div>
    </div>
</div>

<button
    id="reopen-cookie-settings"
    class="reopen-cookie-settings"
    type="button"
    aria-controls="cookie-preferences-dialog"
    aria-expanded="false"
    hidden
>
    Cookie preferences
</button>

<script>
import { isolateDialog, trapDialogFocus } from '../scripts/DialogUtils.js';

interface ConsentState {
    necessary?: boolean;
    advertising: boolean;
}

const CONSENT_KEY = 'ultimate_bench_cookie_consent';

function loadAdsense() {
    if (document.querySelector('script[data-consent-service="adsense"]')) return;
    const script = document.createElement('script');
    script.async = true;
    script.crossOrigin = 'anonymous';
    script.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5230972214569734';
    script.dataset.consentService = 'adsense';
    document.head.appendChild(script);
}

document.addEventListener('DOMContentLoaded', () => {
    const notice = document.getElementById('cookie-notice');
    const backdrop = document.getElementById('cookie-preferences-backdrop');
    const dialog = document.getElementById('cookie-preferences-dialog');
    const advertising = document.getElementById('advertising-consent');
    const accept = document.getElementById('accept-cookies');
    const reject = document.getElementById('reject-cookies');
    const manage = document.getElementById('manage-cookies');
    const save = document.getElementById('save-cookies');
    const cancel = document.getElementById('cancel-cookie-settings');
    const reopen = document.getElementById('reopen-cookie-settings');

    if (
        !(
            notice &&
            backdrop &&
            dialog &&
            advertising instanceof HTMLInputElement &&
            accept &&
            reject &&
            manage &&
            save &&
            cancel &&
            reopen
        )
    ) {
        return;
    }

    let consent: ConsentState | null = null;
    let lastOpener: HTMLElement | null = null;
    let restoreBackground: (() => void) | null = null;

    try {
        const stored = JSON.parse(localStorage.getItem(CONSENT_KEY) || 'null');
        if (stored && typeof stored.advertising === 'boolean') {
            consent = stored;
        }
    } catch {
        /* Browser storage can be blocked or malformed. Keep an in-memory choice. */
    }

    const closeDialog = (restoreFocus = true) => {
        backdrop.hidden = true;
        restoreBackground?.();
        restoreBackground = null;
        manage.setAttribute('aria-expanded', 'false');
        reopen.setAttribute('aria-expanded', 'false');
        notice.hidden = Boolean(consent);
        reopen.hidden = !consent;
        if (restoreFocus) lastOpener?.focus({ preventScroll: true });
    };

    const openDialog = (opener: HTMLElement) => {
        lastOpener = opener;
        advertising.checked = Boolean(consent?.advertising);
        backdrop.hidden = false;
        notice.hidden = true;
        reopen.hidden = true;
        opener.setAttribute('aria-expanded', 'true');
        restoreBackground = isolateDialog(backdrop);
        advertising.focus();
    };

    const storeConsent = (allowed: boolean) => {
        const revoked = Boolean(consent?.advertising && !allowed);
        consent = { necessary: true, advertising: allowed };
        let persisted = false;
        try {
            localStorage.setItem(CONSENT_KEY, JSON.stringify(consent));
            persisted = true;
        } catch {
            /* Preferences still work for this page when storage is unavailable. */
        }
        closeDialog(false);
        reopen.focus({ preventScroll: true });
        if (allowed) loadAdsense();
        // Removing a script does not stop already-running advertising code.
        if (revoked && persisted) window.location.reload();
    };

    notice.hidden = Boolean(consent);
    reopen.hidden = !consent;
    if (consent?.advertising) loadAdsense();

    accept.addEventListener('click', () => storeConsent(true));
    reject.addEventListener('click', () => storeConsent(false));
    manage.addEventListener('click', () => openDialog(manage));
    reopen.addEventListener('click', () => openDialog(reopen));
    save.addEventListener('click', () => storeConsent(advertising.checked));
    cancel.addEventListener('click', () => closeDialog());
    dialog.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            event.preventDefault();
            closeDialog();
        }
        trapDialogFocus(event, dialog);
    });
});
</script>

