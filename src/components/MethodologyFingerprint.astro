---
interface Props { value: string }
const { value } = Astro.props;
---
<aside class="methodology-fingerprint" aria-label="Document information">
  <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7zM14 3v5h5M10 13h5M10 17h5" /></svg>
  <span>Document fingerprint: <code>{value}</code></span>
</aside>
<style>
  .methodology-fingerprint{display:flex;align-items:center;gap:.65rem;width:fit-content;max-width:100%;margin:2rem auto 0;padding:.7rem .9rem;border:1px solid rgba(148,163,184,.3);border-radius:.65rem;background:rgba(15,23,42,.45);color:#cbd5e1;font-size:.78rem;line-height:1.45}
  svg{width:1.05rem;min-width:1.05rem;fill:none;stroke:#93c5fd;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
  code{color:#e2e8f0;font-size:.76rem;overflow-wrap:anywhere}
</style>
