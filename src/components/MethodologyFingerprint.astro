---
interface Props {
    value: string;
}

const { value } = Astro.props;
---
<aside class="methodology-fingerprint" aria-label="Document information">
    <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M7 3h7l4 4v14H7zM14 3v5h5M10 13h5M10 17h5" />
    </svg>
    <span>Document fingerprint: <code>{value}</code></span>
</aside>

<style>
.methodology-fingerprint {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: fit-content;
    max-width: 100%;
    margin: 2.25rem auto 0;
    padding: 0.72rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.45;
}

svg {
    width: 1.05rem;
    min-width: 1.05rem;
    fill: none;
    stroke: var(--link);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
}

code {
    color: var(--text);
    font-size: 0.76rem;
    overflow-wrap: anywhere;
}
</style>
