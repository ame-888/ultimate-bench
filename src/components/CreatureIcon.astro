---
interface Props {
    creature: 'mole' | 'rhino' | 'chimpanzee' | 'owl' | 'eagle' | 'beholder' |
        'mouse' | 'spider' | 'wolf' | 'hawk' | 'python' | 'hydra' |
        'worm' | 'koala' | 'crow' | 'octopus' | 'raven' | 'athena';
}

const { creature } = Astro.props;

const icons: Record<Props['creature'], string> = {
    mole: `<path d="M5 22c0-7 4.7-12 11-12s11 5 11 12v3H5z"/><path d="M11 10 9 7m12 3 2-3M7 22l-3 3m21-3 3 3"/><circle cx="12" cy="17" r="1"/><circle cx="20" cy="17" r="1"/><path d="M14 21h4"/>`,
    rhino: `<path d="M5 12h17l5 5v8H10l-5-5z"/><path d="m22 12 4-5 1 8M8 24v3m14-3v3"/><circle cx="21" cy="16" r="1"/>`,
    chimpanzee: `<circle cx="16" cy="15" r="10"/><path d="M10 12c1-5 11-5 12 0M11 17c0-4 10-4 10 0v4c-2 3-8 3-10 0z"/><circle cx="13" cy="14" r="1"/><circle cx="19" cy="14" r="1"/><path d="M14 20c1 1 3 1 4 0"/>`,
    owl: `<path d="M7 11 5 5l7 4h8l7-4-2 6v10l-4 6H11l-4-6z"/><circle cx="12" cy="16" r="3"/><circle cx="20" cy="16" r="3"/><circle cx="12" cy="16" r="1"/><circle cx="20" cy="16" r="1"/><path d="m14 21 2 2 2-2"/>`,
    eagle: `<path d="M4 12c7-6 17-6 24 0l-8-1-4 5-4-5z"/><path d="M12 11v10l4 6 4-6V11"/><path d="m20 15 7 3-7 2"/><circle cx="18" cy="14" r="1"/>`,
    beholder: `<circle cx="16" cy="17" r="9"/><circle cx="16" cy="17" r="4"/><circle cx="16" cy="17" r="1.5"/><path d="M8 10 5 5m6 4-1-6m6 5V2m5 7 1-6m2 7 3-5M8 23l-4 3m20-3 4 3"/>`,
    mouse: `<path d="M7 18c0-7 4-11 10-11 7 0 10 5 10 11v6H7z"/><circle cx="10" cy="8" r="4"/><circle cx="22" cy="8" r="4"/><circle cx="13" cy="16" r="1"/><circle cx="20" cy="16" r="1"/><path d="m16 20 2 2 2-2M7 22c-4 0-5 4-2 6"/>`,
    spider: `<circle cx="16" cy="12" r="4"/><ellipse cx="16" cy="21" rx="6" ry="7"/><path d="m11 14-6-4m6 8-8-1m8 5-7 4m17-12 6-4m-6 8 8-1m-8 5 7 4"/><circle cx="14" cy="11" r=".7"/><circle cx="18" cy="11" r=".7"/>`,
    wolf: `<path d="m6 5 7 5h6l7-5-2 14-8 8-8-8z"/><path d="m10 13 4 3m8-3-4 3M13 21h6l-3 3z"/><circle cx="12" cy="16" r="1"/><circle cx="20" cy="16" r="1"/>`,
    hawk: `<path d="M3 9c7-4 10-2 13 2 3-4 6-6 13-2l-8 8-5 11-5-11z"/><path d="M12 14h8l-4 4z"/><circle cx="13" cy="13" r="1"/><circle cx="19" cy="13" r="1"/>`,
    python: `<path d="M8 9c0-5 5-7 9-5 5 2 4 8 0 10l-5 3c-4 2-3 8 2 9 4 1 8-1 8-5"/><path d="M8 9h7"/><circle cx="11" cy="7" r="1"/><path d="m8 10-3 2"/>`,
    hydra: `<path d="M10 26V13L5 9V5m11 21V10m6 16V13l5-4V5"/><path d="M2 4c2-2 5-2 7 0v5H2zM12 3c2-2 6-2 8 0v6h-8zm11 1c2-2 5-2 7 0v5h-7z"/><circle cx="5" cy="6" r="1"/><circle cx="16" cy="6" r="1"/><circle cx="27" cy="6" r="1"/><path d="M8 26h16"/>`,
    worm: `<path d="M4 20c0-5 6-5 8-1 2-6 9-6 11-1 2-3 5-2 5 2 0 5-7 7-13 7S4 25 4 20Z"/><circle cx="24" cy="19" r="1"/><path d="M27 17l2-3"/>`,
    koala: `<circle cx="8" cy="12" r="6"/><circle cx="24" cy="12" r="6"/><path d="M7 17c0-8 4-13 9-13s9 5 9 13v8H7z"/><circle cx="12" cy="15" r="1"/><circle cx="20" cy="15" r="1"/><ellipse cx="16" cy="20" rx="3" ry="4"/>`,
    crow: `<path d="M7 20c1-9 5-15 12-15 4 0 7 2 9 5l-7 1 4 5-5 10H9z"/><path d="m9 18-6-2 5 6m6 4-2 4m7-4 2 4"/><circle cx="20" cy="8" r="1"/>`,
    octopus: `<path d="M7 16C7 8 10 4 16 4s9 4 9 12v4H7z"/><circle cx="12" cy="14" r="1"/><circle cx="20" cy="14" r="1"/><path d="M8 20c-5 8 3 10 6 3 0 7 6 7 6 0 3 7 11 5 5-3"/>`,
    raven: `<path d="M6 20C7 10 11 5 19 5c4 0 7 2 10 5l-8 2 3 5-5 10H8z"/><path d="m9 18-6 4 7 1m5 4-2 3m6-3 2 3"/><circle cx="20" cy="9" r="1"/>`,
    athena: `<path d="M7 13c0-6 4-10 9-10s9 4 9 10v13H7z"/><path d="M6 11h20M10 11v15m12-15v15M16 3v23"/><circle cx="13" cy="16" r="1"/><circle cx="19" cy="16" r="1"/><path d="M13 21h6M4 28h24"/>`
};
---

<svg class={`creature-svg creature-svg--${creature}`} viewBox="0 0 32 32" role="img" aria-label={`${creature} icon`}>
    <g set:html={icons[creature]} />
</svg>

<style>
    .creature-svg {
        width: 30px;
        height: 30px;
        overflow: visible;
        fill: color-mix(in srgb, currentColor 22%, transparent);
        stroke: currentColor;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
        vector-effect: non-scaling-stroke;
        filter: drop-shadow(0 3px 5px rgb(0 0 0 / 35%));
    }

    .creature-svg :global(circle),
    .creature-svg :global(ellipse) { vector-effect: non-scaling-stroke; }
</style>
