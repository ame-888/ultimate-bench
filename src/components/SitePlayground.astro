<button id="curiosity-button" aria-label="Reveal a benchmark curiosity" title="Feeling curious?">✦</button>
<div id="curiosity-card" role="status" aria-live="polite"></div>
<div id="konami-mode" aria-hidden="true">ARCADE BRAIN ACTIVATED</div>

<script>
const facts = [
  'Level 5 is still waiting for its first visual breakthrough.',
  'A category winner is not necessarily the most consistent model.',
  'Code execution is part of the tested system—not a free intelligence upgrade.',
  'Try the classic ↑ ↑ ↓ ↓ ← → ← → B A sequence.',
  'Psst… click the UB logo five times.'
];
const curiosity = document.querySelector<HTMLButtonElement>('#curiosity-button');
const card = document.querySelector<HTMLElement>('#curiosity-card');
let factIndex = Number(sessionStorage.getItem('ub-fact') || '0');
curiosity?.addEventListener('click', () => {
  if (!card) return;
  card.textContent = facts[factIndex++ % facts.length];
  sessionStorage.setItem('ub-fact', String(factIndex));
  card.classList.remove('show'); requestAnimationFrame(() => card.classList.add('show'));
});

document.addEventListener('click', (event) => {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const target = event.target as HTMLElement;
  if (target.closest('a,button,input,select,textarea')) return;
  const spark = document.createElement('i'); spark.className = 'click-spark'; spark.textContent = ['✦','·','✧'][Math.floor(Math.random()*3)];
  spark.style.left = `${event.clientX}px`; spark.style.top = `${event.clientY}px`; document.body.append(spark); setTimeout(() => spark.remove(), 700);
});

let logoClicks = 0;
document.querySelector('.brand-mark')?.addEventListener('click', (event) => {
  logoClicks += 1;
  if (logoClicks === 5) { event.preventDefault(); document.body.classList.toggle('party-mode'); logoClicks = 0; }
});

const code = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a']; let progress = 0;
document.addEventListener('keydown', (event) => {
  progress = event.key === code[progress] ? progress + 1 : 0;
  if (progress === code.length) { document.body.classList.toggle('konami'); document.querySelector('#konami-mode')?.classList.add('show'); setTimeout(() => document.querySelector('#konami-mode')?.classList.remove('show'), 2200); progress = 0; }
});

document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((item) => {
  item.addEventListener('pointermove', (event) => { if (matchMedia('(prefers-reduced-motion: reduce)').matches) return; const r=item.getBoundingClientRect(); item.style.setProperty('--rx',`${(event.clientY-r.top-r.height/2)/r.height*-2}deg`); item.style.setProperty('--ry',`${(event.clientX-r.left-r.width/2)/r.width*2}deg`); });
  item.addEventListener('pointerleave', () => { item.style.removeProperty('--rx'); item.style.removeProperty('--ry'); });
});
</script>

<style is:global>
#curiosity-button{position:fixed;right:1.25rem;bottom:calc(1.25rem + env(safe-area-inset-bottom, 0px));z-index:9998;width:2.8rem;height:2.8rem;border:1px solid #3b647c;border-radius:50%;color:#a5f3fc;background:#102438;box-shadow:0 8px 30px #0008;cursor:pointer;font-size:1.15rem;transition:.2s}#curiosity-button:hover{transform:rotate(20deg) scale(1.1);color:white}#curiosity-card{position:fixed;right:1.25rem;bottom:calc(4.7rem + env(safe-area-inset-bottom, 0px));z-index:9998;max-width:17rem;padding:1rem;border:1px solid #31536a;border-radius:.8rem;color:#cbdbe9;background:#0d1927;box-shadow:0 12px 35px #0009;font-size:.75rem;line-height:1.55;opacity:0;transform:translateY(.5rem);pointer-events:none;transition:.25s}#curiosity-card.show{opacity:1;transform:none}.click-spark{position:fixed;z-index:99999;color:#67e8f9;pointer-events:none;font-style:normal;animation:spark-away .7s ease-out forwards}@keyframes spark-away{to{transform:translateY(-28px) rotate(45deg) scale(1.8);opacity:0}}[data-tilt]{transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg))}body.party-mode{animation:hue-party 5s linear infinite}@keyframes hue-party{to{filter:hue-rotate(360deg)}}#konami-mode{position:fixed;inset:50% auto auto 50%;z-index:10001;padding:1rem 1.5rem;border:2px solid #facc15;border-radius:.7rem;color:#facc15;background:#111827;box-shadow:0 0 60px #f59e0b;transform:translate(-50%,-50%) scale(0);font:900 clamp(1rem,4vw,2rem) Poppins;text-align:center;transition:.35s}#konami-mode.show{transform:translate(-50%,-50%) scale(1)}body.konami .navbar{border-bottom-color:#facc15}body.konami .brand-mark{animation:konami-spin 1s ease}@keyframes konami-spin{to{transform:rotate(360deg)}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
