---
import Layout from '../layouts/Layout.astro';
import { benchmarks } from '../data/benchmarks';
import { ARENAS, activeLevels, canonicalDenominator, operationalWeight, type ArenaId } from '../data/benchmarkSpec';
import { buildLeaderboard } from '../data/leaderboard';
import { formatAggregateScore } from '../data/formatting';

interface Props {
    arenaId: ArenaId;
    title: string;
    description: string;
    definition: string;
    evaluates: string;
    doesNot: string;
    methodologyPath: string;
}

const { arenaId, title, description, definition, evaluates, doesNot, methodologyPath } = Astro.props;
const arena = Object.values(ARENAS).find((item) => item.id === arenaId)!;
const rows = buildLeaderboard(benchmarks).arenaRows[arenaId];
const ranked = rows.filter((row) => row.rank !== null).slice(0, 8);
const active = activeLevels(arena);
const denominator = canonicalDenominator(arena);
const operational = operationalWeight(arena);
---
<Layout title={title} description={description}>
    <main class={`overview-page overview-${arenaId}`}>
        <header class="hero">
            <p class="eyebrow">Benchmark overview</p>
            <h1>{arena.name}</h1>
            <p>{definition}</p>
            <div class="actions">
                <a class="primary" href="/#global-leaderboard">Interactive leaderboard</a>
                <a href={methodologyPath}>Detailed methodology</a>
                <a href="/analysis">Analysis</a>
            </div>
        </header>

        <section aria-labelledby="scope">
            <h2 id="scope">What this arena measures</h2>
            <div class="two">
                <article><h3>Evaluates</h3><p>{evaluates}</p></article>
                <article><h3>Does not establish</h3><p>{doesNot}</p></article>
            </div>
        </section>

        <section aria-labelledby="structure">
            <h2 id="structure">Published six-level structure</h2>
            <p>Each position has a Progressive Level Weighting value of 1, 2, 4, 8, 16, or 32. The arena score is <code>Σ(result × level weight) / 63</code>. The permanent denominator is {denominator}; the current operational weight is {operational}/63 and the remaining weight is reserved.</p>
            <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable benchmark table">
                <table>
                    <thead>
                        <tr><th>Level</th><th>Name</th><th>Status</th><th>Weight</th></tr>
                    </thead>
                    <tbody>
                        {arena.levels.map((level) => (
                            <tr><td>{level.number}</td><th scope="row">{level.name}</th><td>{level.status}</td><td>{level.weight}</td></tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <aside><strong>Published design, not a construction notice.</strong> Planned and Locked describe intentionally reserved benchmark levels. They are part of the benchmark design and do not indicate unfinished website content.</aside>
        </section>

        <section aria-labelledby="results">
            <h2 id="results">Current ranked configurations</h2>
            <p>Official arena rank requires results for all {active.length} Active levels. Numeric results and INVALID count toward coverage; UNAVAILABLE and NOT_TESTED make a result provisional. A provisional score can remain visible, but cannot receive an official rank.</p>
            <div class="table-wrap" tabindex="0" role="region" aria-label="Scrollable benchmark table">
                <table>
                    <thead>
                        <tr><th>Rank</th><th>Named configuration</th><th>Arena score</th><th>Active coverage</th></tr>
                    </thead>
                    <tbody>
                        {ranked.map((row) => (
                            <tr><td>{row.rank}</td><th scope="row">{row.name}</th><td>{formatAggregateScore(row.score)}%</td><td>{row.canonical.coverage}</td></tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </section>

        <section aria-labelledby="states">
            <h2 id="states">How result states work</h2>
            <div class="states">
                <p><strong>Numeric zero</strong> is an administered, valid result that earned zero.</p>
                <p><strong>INVALID</strong> is an attempted but non-evaluable result; it contributes zero while counting as covered.</p>
                <p><strong>UNAVAILABLE</strong> means the configuration could not be accessed; it contributes zero and makes coverage incomplete.</p>
                <p><strong>NOT_TESTED</strong> means administration did not occur; it contributes zero and makes coverage incomplete.</p>
            </div>
        </section>

        <section aria-labelledby="limits">
            <h2 id="limits">Limitations and interpretation</h2>
            <p>These experimental scores are snapshots of named accessible configurations under documented conditions. They do not measure universal intelligence, safety, suitability, cost, or every real-world workflow. Provider-controlled interfaces and updates can affect results, protected active material limits independent reproduction, and small score differences should be interpreted cautiously.</p>
            <p class="links">
                <a href={methodologyPath}>Read the arena protocol</a>
                <a href="/guide">Use the practical guide</a>
                <a href="/blog/how-to-read-ai-benchmark">How to read a benchmark</a>
                <a href="/glossary">Open the glossary</a>
            </p>
        </section>
    </main>
</Layout>

<style>
.overview-page {
    --overview-accent: var(--accent-visual);
    max-width: 68rem;
    margin: auto;
    padding: 2.75rem 1.5rem 4.25rem;
    color: var(--muted);
}

.overview-data-retrieval {
    --overview-accent: var(--accent-data);
}

.overview-chess {
    --overview-accent: var(--accent-chess);
}

.hero {
    max-width: 50rem;
    margin-bottom: 2.5rem;
    padding-left: 1.25rem;
    border-left: 3px solid var(--overview-accent);
}

.eyebrow {
    margin: 0 0 0.5rem;
    color: var(--overview-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 4.2vw, 2.9rem);
}

.hero > p {
    line-height: 1.75;
}

.actions,
.links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.25rem;
    margin-top: 1.15rem;
    font-size: 0.86rem;
    font-weight: 500;
}

.actions .primary {
    padding: 0.55rem 0.95rem;
    border: 1px solid rgba(125, 196, 255, 0.42);
    border-radius: 7px;
    background: rgba(30, 54, 89, 0.88);
    color: #e4f2ff;
    font-weight: 600;
    text-decoration: none;
}

.actions .primary:hover {
    border-color: var(--link);
    color: #ffffff;
}

section {
    padding-top: 2.25rem;
    margin-top: 2.25rem;
    border-top: 1px solid var(--line-subtle);
}

h2 {
    margin: 0 0 0.85rem;
    font-size: 1.45rem;
}

h3 {
    margin: 0 0 0.45rem;
    font-size: 1.02rem;
}

p {
    line-height: 1.75;
}

.two,
.states {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.35rem;
}

.two article,
.states p {
    margin: 0;
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--panel);
}

.states strong {
    color: var(--text);
}

aside {
    padding: 1rem 1.2rem;
    border: 1px solid var(--line-subtle);
    border-left: 3px solid var(--overview-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--surface);
    font-size: 0.9rem;
    line-height: 1.7;
}

aside strong {
    color: var(--text);
}

.table-wrap {
    overflow-x: auto;
    margin: 1.25rem 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #0a1322;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
}

th,
td {
    padding: 0.8rem 0.95rem;
    border-bottom: 1px solid var(--line-subtle);
    text-align: left;
    font-size: 0.88rem;
}

tbody tr:last-child th,
tbody tr:last-child td {
    border-bottom: 0;
}

thead {
    background: #132238;
}

thead th {
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

tbody th {
    color: var(--text);
    font-weight: 600;
}

code {
    color: var(--text);
}

@media (max-width: 650px) {
    .overview-page {
        padding: 1.75rem 1rem 3rem;
    }

    .two,
    .states {
        grid-template-columns: 1fr;
    }
}
</style>
