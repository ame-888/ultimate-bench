---
const { mode = 'modal' } = Astro.props;

const games = [
  { id: 'pool', number: '01', name: 'Synapse Pool', genre: 'PHYSICS / PRECISION', description: 'Read the table. Shape the angle. Clear every node.', accent: 'cyan', icon: '◉' },
  { id: 'adventure', number: '02', name: "The Architect’s Journey", genre: 'NARRATIVE / RPG', description: 'Enter a branching terminal world where every choice persists.', accent: 'violet', icon: '⌘' },
  { id: 'tetris', number: '03', name: 'Quantum Tetris', genre: 'PUZZLE / ENDURANCE', description: 'Collapse impossible structures before the stack reaches critical.', accent: 'amber', icon: '▦' },
  { id: 'snake', number: '04', name: 'Byte Snake', genre: 'ARCADE / REFLEX', description: 'Consume loose data. Grow the chain. Never cross your own signal.', accent: 'lime', icon: '⌁' },
  { id: 'breakout', number: '05', name: 'Proxy Breaker', genre: 'ACTION / CONTROL', description: 'Punch through layered firewalls with a single volatile packet.', accent: 'coral', icon: '◆' },
  { id: 'tictactoe', number: '06', name: 'Cyber Tic-Tac-Toe', genre: 'STRATEGY / AI', description: 'A familiar grid. An opponent that learns how you think.', accent: 'blue', icon: '×' },
];
---
<div id="game-center-container" data-mode={mode}>
  {mode === 'modal' && <button id="joystick-btn" aria-label="Open Game Center" title="Enter arcade"><span>PLAY</span></button>}
  <div id="game-modal" class={mode === 'embedded' ? 'embedded-view' : 'hidden'}>
    {mode === 'modal' && <div class="modal-overlay"></div>}
    <section class="modal-content" aria-labelledby="modal-title">
      <div id="crt-overlay" class="hidden"></div>
      <header class="modal-header">
        <button id="header-back-btn" class="icon-btn hidden" aria-label="Back to game library">←</button>
        <div class="title-lockup"><span class="eyebrow">UB // PLAY SYSTEM</span><h2 id="modal-title">Arcade Library</h2></div>
        <div class="header-actions">
          <button id="crt-toggle-btn" class="icon-btn" aria-label="Toggle scanlines" title="Toggle scanlines">CRT</button>
          <button id="suggest-game-btn" class="icon-btn" aria-label="Suggest a game" title="Suggest a game">+IDEA</button>
          <button id="close-modal-btn" class="icon-btn close-btn" aria-label="Close arcade">×</button>
        </div>
      </header>

      <div id="game-menu" class="fade-in">
        <div class="library-intro">
          <p>SELECT PROGRAM</p><span>6 experiments online</span>
        </div>
        <div class="game-grid">
          {games.map((game) => (
            <button class={`game-select-btn accent-${game.accent}`} data-game={game.id}>
              <span class="game-number">{game.number}</span>
              <span class="game-glyph" aria-hidden="true">{game.icon}</span>
              <span class="game-meta"><small>{game.genre}</small><strong>{game.name}</strong><span>{game.description}</span></span>
              <span class="launch-arrow" aria-hidden="true">↗</span>
            </button>
          ))}
        </div>
        <button class="leaderboard-strip" id="leaderboard-btn">
          <span class="rank-icon">⌁</span><span><small>LOCAL RECORDS</small><strong>Hall of Signals</strong></span><span class="launch-arrow">→</span>
        </button>
      </div>

      <div id="leaderboard-view" class="hidden fade-in"><div class="view-kicker">LOCAL MEMORY</div><h3>Hall of Signals</h3><div id="leaderboard-content"></div></div>

      <div id="game-area" class="hidden fade-in game-layout-wrapper">
        <div class="game-left-col">
          <div id="pool-controls" class="hidden pool-controls"><button id="pool-mode-btn">Switch to VS AI</button></div>
          <div id="adventure-wrapper" class="hidden">
            <div class="adventure-top-bar"><button id="adv-save-btn" class="adv-action-btn">SAVE</button><button id="adv-load-btn" class="adv-action-btn">LOAD</button><span id="adv-status-msg"></span></div>
            <div class="adventure-main-layout"><div id="adventure-character-sheet" class="adv-side-panel"><h4>OPERATOR</h4><div id="adv-char-name">User_01</div>
              <div class="adv-stat-row"><span>LVL</span><span id="adv-stat-lvl">1</span></div><div class="adv-stat-row"><span>XP</span><span id="adv-stat-xp">0</span></div><div class="adv-stat-row"><span>HP</span><span id="adv-stat-hp">100/100</span></div><div class="adv-stat-row"><span>STM</span><span id="adv-stat-stm">50/50</span></div><div class="adv-stat-row"><span>STR</span><span id="adv-stat-str">10</span></div><div class="adv-stat-row"><span>DEX</span><span id="adv-stat-dex">10</span></div><div class="adv-stat-row"><span>INT</span><span id="adv-stat-int">10</span></div><div class="adv-stat-row"><span>CR</span><span id="adv-stat-currency">0</span></div><div class="adv-stat-row"><span>STATE</span><span id="adv-stat-status">OK</span></div>
            </div><div id="adventure-container" class="terminal-screen"><div id="adventure-text" class="terminal-text"></div><div id="adventure-choices" class="terminal-choices"></div></div></div>
            <div id="adventure-inventory" class="adv-bottom-panel"><h4>INVENTORY</h4><div id="adv-inv-list" class="inv-list"><span class="inv-empty">Empty</span></div></div>
          </div>
          <div id="canvas-container" class="game-canvas-wrapper"><canvas id="game-canvas" width="400" height="400"></canvas><div id="game-overlay" class="hidden"><span class="view-kicker">RUN TERMINATED</span><h3 id="game-overlay-title">Game Over</h3><p id="game-overlay-score">Score: 0</p><button id="game-restart-btn">Run it back</button><button id="game-quit-btn">Return to library</button></div><div id="cutscene-overlay" class="hidden"><div class="cutscene-content"><div class="glitch-text" data-text="WARNING">WARNING</div><p class="cutscene-msg">UNAUTHORIZED WIN STREAK DETECTED</p><p class="cutscene-sub">ENGAGING MAX DIFFICULTY PROTOCOL...</p></div></div></div>
        </div>
        <aside class="game-controls-info"><div class="score-card"><div class="score-label">LIVE SCORE</div><div class="score-display" id="current-score">0</div></div><div class="info-card"><span class="panel-label">INPUT MAP</span><p id="controls-hint">Controls Info</p></div><button id="side-quit-btn" class="side-btn">← Exit program</button></aside>
      </div>
    </section>
  </div>
</div>
<style>
  :root { --arcade-ink:#07090d; --arcade-paper:#e9e7df; --arcade-line:rgba(233,231,223,.14); --arcade-lime:#c9ff3d; }
  #game-center-container { width:100%; }
  #joystick-btn { position:fixed; bottom:1.5rem; left:50%; transform:translateX(-50%); z-index:9999; border:1px solid #c9ff3d; background:#c9ff3d; color:#07090d; font:800 .72rem/1 'Inter',sans-serif; letter-spacing:.15em; border-radius:999px; padding:1rem 1.5rem; cursor:pointer; box-shadow:0 10px 40px #000; }
  #game-modal { position:fixed; inset:4rem 0 0; z-index:90; display:grid; place-items:center; opacity:0; visibility:hidden; transition:.25s ease; }
  #game-modal:not(.hidden), #game-modal.embedded-view { opacity:1; visibility:visible; }
  #game-modal.embedded-view { position:static; display:block; width:100%; }
  .modal-overlay { position:absolute; inset:0; background:rgba(3,4,7,.88); backdrop-filter:blur(14px); }
  .modal-content { position:relative; width:min(1120px,calc(100% - 2rem)); max-height:calc(100vh - 6rem); overflow:auto; box-sizing:border-box; color:var(--arcade-paper); background:#0a0d12; border:1px solid var(--arcade-line); border-radius:2px; padding:clamp(1rem,3vw,2.25rem); box-shadow:0 30px 100px rgba(0,0,0,.55); }
  .embedded-view .modal-content { width:100%; max-height:none; overflow:visible; background:transparent; border:0; box-shadow:none; padding:0; }
  .modal-header { display:flex; align-items:center; gap:1rem; padding-bottom:1.35rem; margin-bottom:1.5rem; border-bottom:1px solid var(--arcade-line); }
  .title-lockup { flex:1; }.eyebrow,.view-kicker,.panel-label { display:block; color:#8d928f; font:700 .62rem/1.2 'Inter',sans-serif; letter-spacing:.18em; }
  #modal-title { margin:.35rem 0 0; color:var(--arcade-paper); font-size:clamp(1.4rem,3vw,2.2rem); letter-spacing:-.045em; }
  .header-actions { display:flex; gap:.45rem; }.icon-btn { min-width:2.5rem; height:2.5rem; padding:0 .75rem; border:1px solid var(--arcade-line); background:transparent; color:#aeb2b0; font:700 .62rem 'Inter',sans-serif; letter-spacing:.08em; cursor:pointer; }.icon-btn:hover { border-color:var(--arcade-lime); color:var(--arcade-lime); }.close-btn{font-size:1.25rem}.embedded-view .close-btn{display:none}
  .library-intro { display:flex; justify-content:space-between; align-items:center; margin-bottom:.8rem; color:#7d827f; font-size:.7rem; letter-spacing:.14em; }.library-intro p{margin:0;color:var(--arcade-lime);font-weight:800}
  .game-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid var(--arcade-line); border-left:1px solid var(--arcade-line); }
  .game-select-btn { --accent:#c9ff3d; position:relative; min-height:190px; display:grid; grid-template-columns:2.5rem 1fr auto; align-items:start; gap:1rem; text-align:left; color:var(--arcade-paper); padding:1.35rem; border:0; border-right:1px solid var(--arcade-line); border-bottom:1px solid var(--arcade-line); background:rgba(255,255,255,.015); cursor:pointer; overflow:hidden; transition:background .25s; }
  .game-select-btn:after { content:''; position:absolute; inset:auto 0 0; height:3px; background:var(--accent); transform:scaleX(0); transform-origin:left; transition:transform .3s; }.game-select-btn:hover{background:rgba(255,255,255,.05)}.game-select-btn:hover:after{transform:scaleX(1)}
  .accent-violet{--accent:#bba1ff}.accent-amber{--accent:#ffcc66}.accent-lime{--accent:#c9ff3d}.accent-coral{--accent:#ff786b}.accent-blue{--accent:#75a7ff}
  .game-number{color:#606662;font:600 .68rem monospace}.game-glyph{font:400 2.9rem/1 'Poppins',sans-serif;color:var(--accent);text-shadow:0 0 35px color-mix(in srgb,var(--accent) 35%,transparent)}
  .game-meta{align-self:end;display:flex;flex-direction:column;gap:.45rem}.game-meta small{color:var(--accent);font:700 .58rem 'Inter';letter-spacing:.14em}.game-meta strong{font:700 clamp(1.05rem,2vw,1.4rem) 'Poppins';letter-spacing:-.035em}.game-meta>span{max-width:34ch;color:#8f9491;font-size:.75rem;line-height:1.45}.launch-arrow{color:#6e7470;font-size:1.1rem}
  .leaderboard-strip { width:100%; display:grid; grid-template-columns:2.5rem 1fr auto; align-items:center; gap:1rem; margin-top:1rem; padding:1rem 1.35rem; border:1px solid var(--arcade-line); background:#11151a; color:var(--arcade-paper); text-align:left; cursor:pointer }.leaderboard-strip:hover{border-color:#ffcc66}.rank-icon{color:#ffcc66;font-size:1.5rem}.leaderboard-strip small{display:block;color:#8d928f;font-size:.55rem;letter-spacing:.14em}.leaderboard-strip strong{font-size:.9rem}
  .game-layout-wrapper{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:1.25rem}.game-canvas-wrapper{position:relative;aspect-ratio:1;background:#020303;border:1px solid #2b312e;overflow:hidden}canvas{display:block;width:100%;height:100%;image-rendering:pixelated}.game-controls-info{display:flex;flex-direction:column;gap:.75rem}.score-card,.info-card{border:1px solid var(--arcade-line);background:#0e1115;padding:1.1rem}.score-label,.panel-label{color:#777d79;font-size:.58rem;letter-spacing:.16em}.score-display{margin-top:.5rem;color:var(--arcade-lime);font:700 2.8rem monospace}.info-card{flex:1}#controls-hint{color:#aeb2af;font-size:.8rem;line-height:1.6}.side-btn,.pool-controls button,.adv-action-btn{border:1px solid var(--arcade-line);background:transparent;color:var(--arcade-paper);padding:.8rem;cursor:pointer}.side-btn:hover{border-color:#ff786b;color:#ff786b}
  #game-overlay,#cutscene-overlay{position:absolute;inset:0;z-index:20;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:rgba(4,5,7,.92);padding:2rem}#game-overlay h3{font-size:2.5rem;margin:.5rem 0;color:#ff786b}#game-overlay button{width:min(260px,90%);padding:.8rem;margin:.25rem;border:1px solid #39413d;background:#121713;color:white;cursor:pointer}#game-restart-btn{border-color:var(--arcade-lime)!important;color:var(--arcade-lime)!important}
  #crt-overlay{position:absolute;inset:0;z-index:30;pointer-events:none;background:repeating-linear-gradient(0deg,transparent 0 3px,rgba(0,0,0,.2) 3px 4px)}
  #leaderboard-view h3{font-size:2rem;margin:.5rem 0 1.5rem}.leaderboard-game-section{border-top:1px solid var(--arcade-line);padding:1rem 0}.leaderboard-game-title{color:var(--arcade-lime);font-size:.7rem;letter-spacing:.12em}.leaderboard-list{padding:0;list-style:none}.leaderboard-list li{display:flex;justify-content:space-between;padding:.45rem 0;color:#aeb2af;font: .8rem monospace}
  #adventure-wrapper{display:flex;flex-direction:column;gap:.75rem}.adventure-top-bar{display:flex;gap:.5rem;align-items:center}.adventure-main-layout{display:grid;grid-template-columns:180px 1fr;gap:.75rem}.adv-side-panel,.adv-bottom-panel,.terminal-screen{box-sizing:border-box;border:1px solid #31513b;background:#020503;color:#77f39a;padding:1rem;font: .78rem/1.5 monospace}.adv-side-panel h4,.adv-bottom-panel h4{margin:0 0 .75rem;color:#c9ff3d}.adv-stat-row{display:flex;justify-content:space-between;padding:.16rem 0}.terminal-screen{min-height:420px;display:flex;flex-direction:column}.terminal-text{flex:1;white-space:pre-wrap;overflow:auto}.terminal-choices{display:flex;flex-direction:column;gap:.4rem}.inv-list{display:flex;gap:.5rem;flex-wrap:wrap}.inv-item{border:1px solid #31513b;padding:.2rem .4rem}.cutscene-content{color:#ff786b}.glitch-text{font:900 3rem Poppins}.hidden{display:none!important}.fade-in{animation:fade .35s ease}@keyframes fade{from{opacity:0;transform:translateY(8px)}}
  @media(max-width:700px){.modal-content{width:calc(100% - 1rem);padding:1rem}.game-grid{grid-template-columns:1fr}.game-select-btn{min-height:150px}.game-layout-wrapper{grid-template-columns:1fr}.game-controls-info{display:grid;grid-template-columns:1fr 1fr}.side-btn{grid-column:1/-1}.adventure-main-layout{grid-template-columns:1fr}.modal-header{align-items:flex-start}.header-actions{flex-wrap:wrap;justify-content:flex-end}.eyebrow{display:none}.game-meta>span{display:none}}
  @media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>

<script>
    // @ts-nocheck -- legacy canvas arcade code uses runtime DOM/game-state guards.
    import { SoundManager, MusicManager, ScoreManager, GameLogic, CameraParams, GlobalParticles } from '../scripts/GameEngine.js';
    import { AdventureEngine } from '../scripts/AdventureEngine.js';

    // Initialize Managers
    const sound = new SoundManager();
    const music = new MusicManager();
    const scores = new ScoreManager();
    const adventure = new AdventureEngine();

    // Elements
    let modal, joystickBtn;
    let canvas, ctx;
    let adventureWrapper, adventureContainer, canvasContainer;
    let gameLoopId;
    let state = null;
    let currentGame = null;
    let lastTime = 0;
    let isPaused = false;
    let keys = {};
    let typeWriterInterval = null;
    let isTyping = false;

    let crtEnabled = true;

    function init() {
        joystickBtn = document.getElementById('joystick-btn');
        modal = document.getElementById('game-modal');
        canvas = document.getElementById('game-canvas');
        adventureWrapper = document.getElementById('adventure-wrapper');
        adventureContainer = document.getElementById('adventure-container');
        canvasContainer = document.getElementById('canvas-container');
        if (canvas) ctx = canvas.getContext('2d');

        const crtToggleBtn = document.getElementById('crt-toggle-btn');
        if (crtToggleBtn) {
            crtToggleBtn.addEventListener('click', () => {
                crtEnabled = !crtEnabled;
                const overlay = document.getElementById('crt-overlay');
                if (overlay) {
                    if (crtEnabled && currentGame) {
                        overlay.classList.remove('hidden');
                    } else {
                        overlay.classList.add('hidden');
                    }
                }
                crtToggleBtn.style.opacity = crtEnabled ? '1' : '0.5';
            });
        }

        if (joystickBtn) {
            joystickBtn.addEventListener('click', () => {
                modal.classList.remove('hidden');
                showMenu();
            });
        }

        const closeBtn = document.getElementById('close-modal-btn');
        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                // Fully quit the game
                stopGame(true);
                if (!modal.classList.contains('embedded-view')) {
                    modal.classList.add('hidden');
                } else {
                    // For embedded, maybe redirect to home or just show menu
                    showMenu();
                    window.location.href = '/';
                }
            });
        }

        const suggestBtn = document.getElementById('suggest-game-btn');
        if (suggestBtn) {
            suggestBtn.addEventListener('click', () => {
                window.dispatchEvent(new CustomEvent('open-game-suggestion'));
            });
        }

        document.querySelectorAll('.game-select-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                if (btn.id === 'leaderboard-btn') {
                    showLeaderboard();
                } else {
                    startGame(btn.dataset.game);
                }
            });
        });

        document.getElementById('game-restart-btn')?.addEventListener('click', () => {
            document.getElementById('game-overlay').classList.add('hidden');
            // currentGame is still set, so we can just restart
            startGame(currentGame);
        });

        document.getElementById('game-quit-btn')?.addEventListener('click', () => {
            stopGame(true);
            showMenu();
        });

        document.getElementById('side-quit-btn')?.addEventListener('click', () => {
            stopGame(true);
            showMenu();
        });

        document.getElementById('header-back-btn')?.addEventListener('click', () => {
            stopGame(true);
            showMenu();
        });

        const poolModeBtn = document.getElementById('pool-mode-btn');
        if (poolModeBtn) {
            poolModeBtn.addEventListener('click', () => {
                if (currentGame === 'pool' && state) {
                    const targetMode = !state.vsAI;
                    // Reset game on mode switch
                    startGame('pool');
                    // Restore/Set mode on new state
                    if (state) state.vsAI = targetMode;
                    poolModeBtn.textContent = state.vsAI ? "Switch to Solo" : "Switch to VS AI";
                }
            });
        }

        // Input Handling
        window.addEventListener('keydown', (e) => {
            keys[e.key] = true;
            if (e.key.toLowerCase() === 'p' && currentGame && currentGame !== 'tictactoe' && currentGame !== 'pool') {
                isPaused = !isPaused;
            }
            // Prevent scrolling
            if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key) && !modal.classList.contains('hidden')) {
                e.preventDefault();
            }

            // Direct Input Handling
            if (currentGame && GameLogic[currentGame] && GameLogic[currentGame].onKeyDown) {
                 // Pass full context for modification
                 state = GameLogic[currentGame].onKeyDown(e, state, {
                    playSound: (t) => sound.play(t)
                 });
            }
        });

        window.addEventListener('keyup', (e) => keys[e.key] = false);

        if (canvas) {
            canvas.addEventListener('mousedown', (e) => {
                if (currentGame === 'tictactoe' && state) {
                    state = GameLogic.tictactoe.handleClick(e, state, canvas, {
                        playSound: (t) => sound.play(t),
                        onScore: updateScore,
                        onGameOver: handleGameOver,
                        onCutscene: triggerCutscene
                    });
                    GameLogic.tictactoe.draw(ctx, state, canvas);
                } else if (currentGame === 'pool' && state) {
                     state = GameLogic.pool.handleMouseDown(e, state, canvas);
                } else if (currentGame === 'idle' && state) {
                     state = GameLogic.idle.handleClick(e, state, canvas, {
                        playSound: (t) => sound.play(t),
                        onScore: updateScore,
                        onGameOver: handleGameOver
                     });
                }
            });

            canvas.addEventListener('mousemove', (e) => {
                if (currentGame === 'pool' && state) {
                    state = GameLogic.pool.handleMouseMove(e, state, canvas);
                }
            });

            canvas.addEventListener('mouseup', (e) => {
                if (currentGame === 'pool' && state) {
                    state = GameLogic.pool.handleMouseUp(e, state, canvas, {
                        playSound: (t) => sound.play(t),
                        onScore: updateScore,
                        onGameOver: handleGameOver
                    });
                }
            });
        }
    }

    function renderAdventure() {
        const node = adventure.getCurrentNode();
        const textEl = document.getElementById('adventure-text');
        const choicesEl = document.getElementById('adventure-choices');

        choicesEl.innerHTML = '';
        textEl.textContent = '';

        if (typeWriterInterval) clearInterval(typeWriterInterval);
        isTyping = true;

        let charIndex = 0;
        const speed = 20; // ms per char

        // Disable choices until typing is done
        textEl.onclick = () => {
            if (isTyping) {
                clearInterval(typeWriterInterval);
                textEl.textContent = node.text;
                isTyping = false;
                renderAdventureChoices(node, choicesEl);
            }
        };

        typeWriterInterval = setInterval(() => {
            if (charIndex < node.text.length) {
                textEl.textContent += node.text.charAt(charIndex);
                charIndex++;
                if (charIndex % 3 === 0) sound.play('move'); // tick sound
                textEl.scrollTop = textEl.scrollHeight; // scroll to bottom
            } else {
                clearInterval(typeWriterInterval);
                isTyping = false;
                renderAdventureChoices(node, choicesEl);
            }
        }, speed);
    }

    function renderAdventureChoices(node, choicesEl) {
        node.choices.forEach((c, i) => {
            // Check reqs
            if (c.req && !adventure.state.inventory.includes(c.req)) return;

            const btn = document.createElement('button');
            btn.textContent = "> " + c.text;
            btn.className = 'adventure-btn fade-in';
            btn.style.padding = '0.5rem';
            btn.style.background = 'transparent';
            btn.style.color = '#10B981';
            btn.style.border = '1px solid #059669';
            btn.style.borderRadius = '0.25rem';
            btn.style.cursor = 'pointer';
            btn.style.textAlign = 'left';
            btn.style.fontFamily = "'Courier New', monospace";
            btn.style.textShadow = '0 0 5px #10B981';

            btn.onmouseover = () => {
                btn.style.background = 'rgba(16, 185, 129, 0.2)';
                sound.play('move');
            };
            btn.onmouseout = () => btn.style.background = 'transparent';

            btn.onclick = () => {
                if (isTyping) return;
                sound.play('pop');
                const newNode = adventure.handleChoice(i, {
                    onLoot: (item) => sound.play('score'),
                    onAchievement: (id) => {
                        sound.play('score');
                    }
                });
                updateAdventureUI();
                if (newNode) renderAdventure();
            };
            choicesEl.appendChild(btn);
        });
    }

    function updateAdventureUI() {
        if(!adventure || !adventure.state || !adventure.state.stats) return;

        // Character Sheet
        const nameEl = document.getElementById('adv-char-name');
        const lvlEl = document.getElementById('adv-stat-lvl');
        const xpEl = document.getElementById('adv-stat-xp');
        const hpEl = document.getElementById('adv-stat-hp');
        const stmEl = document.getElementById('adv-stat-stm');
        const strEl = document.getElementById('adv-stat-str');
        const dexEl = document.getElementById('adv-stat-dex');
        const intEl = document.getElementById('adv-stat-int');
        const currEl = document.getElementById('adv-stat-currency');
        const statusEl = document.getElementById('adv-stat-status');

        if (nameEl) {
            if (adventure.state.stats.race && adventure.state.stats.charClass) {
                nameEl.textContent = `${adventure.state.stats.race} ${adventure.state.stats.charClass}`;
            } else {
                nameEl.textContent = 'Unknown Entity';
            }
        }

        if (lvlEl) lvlEl.textContent = adventure.state.stats.level;
        if (xpEl) xpEl.textContent = adventure.state.stats.xp;
        if (hpEl) hpEl.textContent = `${adventure.state.stats.hp}/${adventure.state.stats.maxHp}`;
        if (stmEl) stmEl.textContent = `${adventure.state.stats.stm}/${adventure.state.stats.maxStm}`;
        if (strEl) strEl.textContent = adventure.state.stats.str;
        if (dexEl) dexEl.textContent = adventure.state.stats.dex;
        if (intEl) intEl.textContent = adventure.state.stats.int;
        if (currEl) currEl.textContent = adventure.state.currency;
        if (statusEl) statusEl.textContent = adventure.state.stats.status;

        // Inventory
        const invList = document.getElementById('adv-inv-list');
        if (invList) {
            invList.innerHTML = '';
            if (!adventure.state.inventory || adventure.state.inventory.length === 0) {
                invList.innerHTML = '<span class="inv-empty">Empty</span>';
            } else {
                adventure.state.inventory.forEach(item => {
                    const span = document.createElement('span');
                    span.className = 'inv-item';
                    span.textContent = item.replace('_', ' '); // Clean up formatting
                    invList.appendChild(span);
                });
            }
        }
    }

    function showMenu() {
        document.getElementById('game-menu').classList.remove('hidden');
        document.getElementById('game-area').classList.add('hidden');
        document.getElementById('leaderboard-view').classList.add('hidden');
        document.getElementById('header-back-btn').classList.add('hidden'); // Hide back button on menu
        document.getElementById('suggest-game-btn').classList.remove('hidden'); // Show suggest button
        document.getElementById('modal-title').textContent = "Synaptic Arcade";
        document.getElementById('crt-overlay')?.classList.add('hidden');
    }

    function showLeaderboard() {
        document.getElementById('game-menu').classList.add('hidden');
        document.getElementById('leaderboard-view').classList.remove('hidden');
        document.getElementById('header-back-btn').classList.remove('hidden'); // Show back button
        document.getElementById('suggest-game-btn').classList.add('hidden'); // Hide suggest on leaderboard
        document.getElementById('modal-title').textContent = "High Scores";

        const data = scores.getScores();
        const fmtDate = (d) => new Date(d).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
        const listHtml = (items) => items.map(s => `<li><span>${fmtDate(s.date)}</span><span>${s.score}</span></li>`).join('');

        const content = document.getElementById('leaderboard-content');
        content.innerHTML = `
             <div class="leaderboard-game-section">
                <div class="leaderboard-game-title">Synapse Pool</div>
                <ul class="leaderboard-list">${listHtml(data.pool || [])}</ul>
            </div>
            <div class="leaderboard-game-section">
                <div class="leaderboard-game-title">Quantum Tetris</div>
                <ul class="leaderboard-list">${listHtml(data.tetris)}</ul>
            </div>
            <div class="leaderboard-game-section">
                <div class="leaderboard-game-title">Byte Snake</div>
                <ul class="leaderboard-list">${listHtml(data.snake)}</ul>
            </div>
            <div class="leaderboard-game-section">
                <div class="leaderboard-game-title">Proxy Breaker</div>
                <ul class="leaderboard-list">${listHtml(data.breakout)}</ul>
            </div>
             <div class="leaderboard-game-section">
                <div class="leaderboard-game-title">Cyber Tic-Tac-Toe (Streak)</div>
                <ul class="leaderboard-list"><li><span>Best Streak</span><span>${data.tictactoe || 0}</span></li></ul>
            </div>
        `;
    }

    function startGame(game) {
        currentGame = game;
        document.getElementById('game-menu').classList.add('hidden');
        document.getElementById('game-area').classList.remove('hidden');
        document.getElementById('game-overlay').classList.add('hidden');
        document.getElementById('header-back-btn').classList.remove('hidden'); // Show back button
        document.getElementById('suggest-game-btn').classList.add('hidden'); // Hide suggest button in game

        // Pool controls
        const poolControls = document.getElementById('pool-controls');
        if (game === 'pool') {
            poolControls.classList.remove('hidden');
        } else {
            poolControls.classList.add('hidden');
        }

        // Handle Adventure vs Canvas
        const modalContent = document.querySelector('.modal-content');
        if (game === 'adventure') {
            adventureWrapper.classList.remove('hidden');
            canvasContainer.classList.add('hidden');
            if (modalContent) modalContent.classList.add('adventure-mode');

            // Adventure UI updates and hooks
            updateAdventureUI();

            // Bind save/load
            const saveBtn = document.getElementById('adv-save-btn');
            const loadBtn = document.getElementById('adv-load-btn');
            const statusMsg = document.getElementById('adv-status-msg');

            if (saveBtn) saveBtn.onclick = () => {
                adventure.explicitSave();
                if(statusMsg) {
                    statusMsg.textContent = "Game Saved.";
                    setTimeout(() => statusMsg.textContent = "", 2000);
                }
            };
            if (loadBtn) loadBtn.onclick = () => {
                const loaded = adventure.explicitLoad();
                if(loaded) {
                    if(statusMsg) {
                        statusMsg.textContent = "Game Loaded.";
                        setTimeout(() => statusMsg.textContent = "", 2000);
                    }
                    updateAdventureUI();
                    renderAdventure();
                } else {
                    if(statusMsg) {
                        statusMsg.textContent = "No Save Found.";
                        setTimeout(() => statusMsg.textContent = "", 2000);
                    }
                }
            };

            renderAdventure();
        } else {
            adventureWrapper.classList.add('hidden');
            canvasContainer.classList.remove('hidden');
            if (modalContent) modalContent.classList.remove('adventure-mode');
        }

        if (crtEnabled) {
            document.getElementById('crt-overlay')?.classList.remove('hidden');
        } else {
            document.getElementById('crt-overlay')?.classList.add('hidden');
        }

        // Titles & Hints
        const titles = {
            snake: "Byte Snake",
            tetris: "Quantum Tetris",
            breakout: "Proxy Breaker",
            tictactoe: "Cyber Tic-Tac-Toe",
            pool: "Synapse Pool",
            adventure: "The Architect's Journey"
        };
        const hints = {
            snake: "Arrows to Move • P to Pause • Eat Bytes to Grow",
            tetris: "Arrows to Move/Rotate • P to Pause • Clear Rows",
            breakout: "Left/Right to Deflect • P to Pause • Break Proxies",
            tictactoe: "Click empty nodes to capture • Get 3 in a row",
            pool: "Drag/Hold to aim & shoot • Click button to switch mode",
            adventure: "Read text • Click choices to progress • Manage Stats"
        };
        document.getElementById('modal-title').textContent = titles[game] || "Game";
        document.getElementById('controls-hint').textContent = hints[game] || "";
        document.getElementById('current-score').textContent = "0";

        // Reset
        canvas.width = 400; canvas.height = 400;
        keys = {};
        isPaused = false;
        document.getElementById('cutscene-overlay').classList.add('hidden');

        if (GameLogic[game]) {
            state = GameLogic[game].init(canvas);

            // Sync button state for pool
            if (game === 'pool') {
                const btn = document.getElementById('pool-mode-btn');
                if (btn) btn.textContent = state.vsAI ? "Switch to Solo" : "Switch to VS AI";
            }

            // Start Music
            if (game === 'tetris') music.playTrack('tetris');
            if (game === 'breakout') music.playTrack('breakout');

            lastTime = performance.now();
            if (gameLoopId) cancelAnimationFrame(gameLoopId);
            loop(lastTime);
        }
    }

    function stopGame(fullQuit = false) {
        if (gameLoopId) cancelAnimationFrame(gameLoopId);
        music.stop();
        if (fullQuit) {
            currentGame = null;
        }
    }

    function updateScore(s) {
        document.getElementById('current-score').textContent = s;
    }

    function handleGameOver(finalScore) {
        stopGame(); // Stop the loop, but keep currentGame for restart
        sound.play('gameover');
        scores.saveScore(currentGame, finalScore);

        document.getElementById('game-overlay-score').textContent = `Score: ${finalScore}`;
        document.getElementById('game-overlay').classList.remove('hidden');
    }

    function triggerCutscene() {
        sound.play('gameover'); // Deep sound
        const overlay = document.getElementById('cutscene-overlay');
        overlay.classList.remove('hidden');
        setTimeout(() => {
            overlay.classList.add('hidden');
        }, 4000);
    }

    function loop(time) {
        if (!currentGame) return;
        gameLoopId = requestAnimationFrame(loop);

        if (isPaused) {
            lastTime = time;
            // Draw Pause
            ctx.fillStyle = 'rgba(0,0,0,0.5)';
            ctx.fillRect(0,0,canvas.width, canvas.height);
            ctx.fillStyle = '#F59E0B';
            ctx.font = 'bold 30px Courier New';
            ctx.textAlign = 'center';
            ctx.fillText("PAUSED", canvas.width/2, canvas.height/2);
            return;
        }

        let dt = time - lastTime;
        // Cap dt to prevent "spiral of death" or huge jumps after tab switching
        if (dt > 100) dt = 16.67;
        lastTime = time;

        ctx.clearRect(0,0,canvas.width, canvas.height);

        // Update Camera
        if (CameraParams) CameraParams.update(dt);
        ctx.save();
        if (CameraParams) CameraParams.apply(ctx);

        // Update & Draw
        if (currentGame !== 'tictactoe') { // TTT is event based
            state = GameLogic[currentGame].update(dt, state, canvas, {
                playSound: (t) => sound.play(t),
                onScore: updateScore,
                onGameOver: handleGameOver,
                spawnParticles: (x, y, color, count, speedMul) => GlobalParticles.spawn(x, y, color, count, speedMul),
                triggerShake: (mag, time) => CameraParams.triggerShake(mag, time)
            }, { keys });

            // Check if game over happened inside update
            if (currentGame) GameLogic[currentGame].draw(ctx, state, canvas);
        } else {
             GameLogic.tictactoe.draw(ctx, state, canvas);
        }

        if (GlobalParticles) {
            GlobalParticles.update(dt);
            GlobalParticles.draw(ctx);
        }

        ctx.restore();
    }

    // Init on load
    document.addEventListener('DOMContentLoaded', init);

</script>
