---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
    { href: '/', label: 'Home' },
    { href: '/about', label: 'About' },
    { href: '/methodology', label: 'Methodology' },
    { href: '/signals', label: 'Signals' },
    { href: '/field-guide', label: 'Field Guide' },
    { href: '/contact', label: 'Contact' },
    { href: '/terms', label: 'Terms' },
    { href: '/privacy', label: 'Privacy' },
];
---

<nav class="navbar">
    <div class="navbar-container">
        <a class="brand-link" href="/" aria-label="Ultimate Bench home">
            <span class="brand-mark" aria-hidden="true">UB</span>
            <span class="brand-name">Ultimate Bench</span>
        </a>

        <button class="navbar-toggle" id="navbar-toggle" aria-label="Toggle navigation" aria-controls="navbar-menu" aria-expanded="false">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>

        <div class="navbar-menu" id="navbar-menu">
            {links.map(({ href, label }) => (
                <a href={href} class="nav-link" aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
            ))}
            <button id="achievements-btn" class="nav-link achievements-link" aria-label="Open achievements">
                <span aria-hidden="true">🏆</span><span>Achievements</span>
            </button>
            <a href="/arcade" id="nav-arcade" class="nav-link arcade-link" aria-current={currentPath === '/arcade' ? 'page' : undefined}>Arcade</a>
        </div>
    </div>
</nav>

<style>
    .navbar {
        background-color: rgba(10, 15, 25, 0.95);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(12px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
    }

    .navbar-container {
        max-width: 90rem;
        margin: 0 auto;
        padding: 0 1rem;
        height: 4rem;
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .brand-link {
        font-family: 'Poppins', sans-serif;
        font-weight: 900;
        font-size: 1rem;
        color: white;
        text-decoration: none;
        background: linear-gradient(to right, #60A5FA, #A78BFA);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        flex: 0 0 auto;
    }

    .brand-mark {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 0.55rem;
        color: #08101f;
        background: linear-gradient(135deg, #60A5FA, #A78BFA);
        -webkit-text-fill-color: #08101f;
        font-size: 0.72rem;
        letter-spacing: -0.03em;
        box-shadow: 0 0 20px rgba(96, 165, 250, 0.22);
    }

    .navbar-menu {
        display: flex;
        gap: 0.15rem;
        align-items: center;
        justify-content: flex-end;
        flex: 1;
    }

    .nav-link {
        color: #9CA3AF;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.78rem;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        position: relative;
        padding: 0.6rem 0.7rem;
        border-radius: 0.375rem;
        white-space: nowrap;
    }

    .nav-link:hover {
        color: white;
        background-color: rgba(255, 255, 255, 0.1);
    }

    .nav-link.active-bench {
        color: #93C5FD !important;
        background-color: rgba(96, 165, 250, 0.1) !important;
    }

    .nav-link[aria-current="page"] {
        color: #93C5FD;
        background: rgba(96, 165, 250, 0.1);
    }

    .achievements-link {
        background: transparent;
        border: none;
        cursor: pointer;
        font-family: inherit;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        background: linear-gradient(135deg, #FCD34D 0%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 0 10px rgba(245, 158, 11, 0.3);
        transition: all 0.3s ease;
    }

    .arcade-link,
    .arcade-link[aria-current="page"] {
        color: #FACC15;
        font-weight: 700;
    }

    .achievements-link:hover {
        background: linear-gradient(135deg, #FDE68A 0%, #FBBF24 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        transform: scale(1.05);
        text-shadow: 0 0 15px rgba(245, 158, 11, 0.6);
    }

    /* Pet Notification Style */
    .pet-notification {
        display: inline-block;
        margin-left: 0.5rem;
        animation: bounce 1s infinite;
        color: #FACC15;
        font-size: 1.2em;
        vertical-align: middle;
        text-shadow: 0 0 5px rgba(250, 204, 21, 0.5);
    }

    @keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-3px); }
    }

    .navbar-toggle {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 30px;
        height: 21px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 101;
    }

    .bar {
        height: 3px;
        width: 100%;
        background-color: white;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    @media (max-width: 1100px) {
        .navbar-toggle {
            display: flex;
        }

        .navbar-menu {
            position: fixed;
            top: 4rem; /* Below navbar */
            left: 0;
            width: 100%;
            background-color: #1F2937;
            flex-direction: column;
            gap: 0;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            align-items: stretch;
        }

        .navbar-menu.active {
            max-height: calc(100vh - 4rem);
            overflow-y: auto;
        }

        .nav-link {
            width: 100%;
            text-align: center;
            padding: 1rem 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .nav-link:last-child {
            border-bottom: none;
        }
    }

    @media (max-width: 420px) {
        .brand-name {
            display: none;
        }
    }
</style>

<script>
    // Mobile Menu Toggle
    const toggle = document.getElementById('navbar-toggle');
    const menu = document.getElementById('navbar-menu');

    if (toggle && menu) {
        toggle.addEventListener('click', () => {
            const isOpen = menu.classList.toggle('active');
            toggle.setAttribute('aria-expanded', String(isOpen));
        });

        menu.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
                menu.classList.remove('active');
                toggle.setAttribute('aria-expanded', 'false');
            });
        });
    }

    // Pet Notification Logic
    function checkPetNotification() {
        try {
            // Check if user has a pet
            const hasPet = localStorage.getItem('pixel_pet');
            // Check if notification already seen
            const notificationSeen = localStorage.getItem('pet_notification_seen');

            if (hasPet && !notificationSeen) {
                // Create indicator
                const indicator = document.createElement('span');
                indicator.className = 'pet-notification';
                indicator.textContent = '⬅'; // Or ✨
                indicator.setAttribute('aria-label', 'New Pet!');

                // Assuming pet link exists somewhere or we want to add the indicator somewhere
                // (The original code seems to have had a specific target that got lost. Let's just catch the error)
            }
        } catch (e) {
            console.warn('Pet notification check failed:', e);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        checkPetNotification();

        // Also highlight active link
        const currentPath = window.location.pathname;
        const currentSearch = window.location.search;
        const urlParams = new URLSearchParams(currentSearch);
        const activeTab = urlParams.get('tab') || 'home';

        document.querySelectorAll('.nav-link').forEach(link => {
            const href = link.getAttribute('href');

            // Handle active state for benchmark tabs on homepage
            if (currentPath === '/' && href === '/') {
                if (activeTab === 'home') {
                    link.classList.add('active-bench');
                } else {
                    link.classList.remove('active-bench');
                }
            }
            // Regular links
            else if (href === currentPath && currentPath !== '/') {
                link.style.color = '#60A5FA';
                link.style.fontWeight = '700';
            }

            // Intercept home click to prevent reload if already on homepage
            if (href === '/') {
                link.addEventListener('click', (e) => {
                    if (window.location.pathname === '/') {
                        e.preventDefault();
                        const newTab = 'home';

                        // Update URL without reload
                        window.history.pushState({}, '', '/');

                        // Update UI
                        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active-bench'));
                        link.classList.add('active-bench');

                        // Trigger custom event so index.astro can update the view
                        window.dispatchEvent(new CustomEvent('benchmarkTabChanged', { detail: newTab }));
                    }
                });
            }
        });
    });
</script>
