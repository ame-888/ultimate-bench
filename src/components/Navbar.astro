---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
    { href: '/', label: 'Home' },
    { href: '/methodology', label: 'Methodology' },
    { href: '/analysis', label: 'Analysis' },
    { href: '/guide', label: 'Guide' },
    { href: '/blog', label: 'Articles' },
    { href: '/about', label: 'About' },
    { href: '/contact', label: 'Contact' },
];
---

<nav class="navbar" aria-label="Main navigation">
    <div class="navbar-container">
        <a class="brand-link" href="/" aria-label="Ultimate Bench home">
            <span class="brand-mark" aria-hidden="true">UB</span>
            <span class="brand-name">Ultimate Bench</span>
        </a>

        <button class="navbar-toggle" id="navbar-toggle" aria-label="Toggle navigation" aria-controls="navbar-menu" aria-expanded="false">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>

        <div class="navbar-menu" id="navbar-menu">
            {links.map(({ href, label }) => (
                <a href={href} class="nav-link" aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
            ))}
        </div>
    </div>
</nav>

<style>
    .navbar {
        background-color: rgba(10, 15, 25, 0.95);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        position: sticky;
        top: 0;
        z-index: 100;
        backdrop-filter: blur(12px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
    }

    .navbar-container {
        max-width: 90rem;
        margin: 0 auto;
        padding: 0 1rem;
        height: 4rem;
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .brand-link {
        font-family: 'Poppins', sans-serif;
        font-weight: 900;
        font-size: 1rem;
        color: white;
        text-decoration: none;
        background: linear-gradient(to right, #60A5FA, #A78BFA);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        flex: 0 0 auto;
    }

    .brand-mark {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
        border-radius: 0.55rem;
        color: #08101f;
        background: linear-gradient(135deg, #60A5FA, #A78BFA);
        -webkit-text-fill-color: #08101f;
        font-size: 0.72rem;
        letter-spacing: -0.03em;
        box-shadow: 0 0 20px rgba(96, 165, 250, 0.22);
    }

    .navbar-menu {
        display: flex;
        gap: 0.15rem;
        align-items: center;
        justify-content: flex-end;
        flex: 1;
    }

    .nav-link {
        color: #9CA3AF;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.78rem;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        position: relative;
        padding: 0.6rem 0.7rem;
        border-radius: 0.375rem;
        white-space: nowrap;
    }

    .nav-link:hover {
        color: white;
        background-color: rgba(255, 255, 255, 0.1);
    }

    .nav-link.active-bench {
        color: #93C5FD !important;
        background-color: rgba(96, 165, 250, 0.1) !important;
    }

    .nav-link[aria-current="page"] {
        color: #93C5FD;
        background: rgba(96, 165, 250, 0.1);
    }

    .achievements-link {
        background: transparent;
        border: none;
        cursor: pointer;
        font-family: inherit;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        background: linear-gradient(135deg, #FCD34D 0%, #F59E0B 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-shadow: 0 0 10px rgba(245, 158, 11, 0.3);
        transition: all 0.3s ease;
    }

    .arcade-link,
    .arcade-link[aria-current="page"] {
        color: #FACC15;
        font-weight: 700;
    }

    .achievements-link:hover {
        background: linear-gradient(135deg, #FDE68A 0%, #FBBF24 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        transform: scale(1.05);
        text-shadow: 0 0 15px rgba(245, 158, 11, 0.6);
    }

    /* Pet Notification Style */
    .pet-notification {
        display: inline-block;
        margin-left: 0.5rem;
        animation: bounce 1s infinite;
        color: #FACC15;
        font-size: 1.2em;
        vertical-align: middle;
        text-shadow: 0 0 5px rgba(250, 204, 21, 0.5);
    }

    @keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-3px); }
    }

    .navbar-toggle {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 44px;
        height: 44px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 11px 7px;
        margin-left: auto;
        z-index: 101;
    }

    .bar {
        height: 3px;
        width: 100%;
        background-color: white;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

    @media (max-width: 1100px) {
        .navbar-toggle {
            display: flex;
        }

        .navbar-menu {
            position: fixed;
            top: 4rem; /* Below navbar */
            left: 0;
            width: 100%;
            background-color: #1F2937;
            flex-direction: column;
            gap: 0;
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            align-items: stretch;
        }

        .navbar-menu.active {
            max-height: calc(100vh - 4rem);
            overflow-y: auto;
        }

        .nav-link {
            width: 100%;
            text-align: center;
            padding: 1rem 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .nav-link:last-child {
            border-bottom: none;
        }
    }

    @media (max-width: 1100px) {
        .navbar:not([data-enhanced]) .navbar-container { height: auto; flex-wrap: wrap; padding-block: 1rem; gap: 1rem; }
        .navbar:not([data-enhanced]) .navbar-menu { position: static; max-height: none; flex: 1 0 100%; }
        .navbar:not([data-enhanced]) .navbar-toggle { display: none; }
    }

    @media (max-width: 420px) {
        .brand-name {
            display: none;
        }
    }
</style>

<script>
    const toggle = document.getElementById('navbar-toggle');
    const menu = document.getElementById('navbar-menu');
    const navbar = document.querySelector('.navbar');
    if (toggle && menu && navbar) {
        const mobile = matchMedia('(max-width: 1100px)');
        navbar.setAttribute('data-enhanced', '');
        const setOpen = (open: boolean) => {
            menu.classList.toggle('active', open);
            toggle.setAttribute('aria-expanded', String(open));
            menu.inert = mobile.matches && !open;
        };
        setOpen(false);
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
        mobile.addEventListener('change', () => setOpen(false));
        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && menu.classList.contains('active')) {
                setOpen(false);
                toggle.focus();
            }
        });
        document.addEventListener('click', event => {
            if (event.target instanceof Node && !navbar.contains(event.target)) setOpen(false);
        });
        navbar.addEventListener('focusout', event => {
            if (event instanceof FocusEvent && event.relatedTarget instanceof Node && !navbar.contains(event.relatedTarget)) setOpen(false);
        });
    }
</script>
