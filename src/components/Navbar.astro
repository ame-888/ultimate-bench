---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
    { href: '/', label: 'Home' },
    { href: '/methodology', label: 'Methodology' },
    { href: '/analysis', label: 'Analysis' },
    { href: '/guide', label: 'Guide' },
    { href: '/blog', label: 'Articles' },
    { href: '/about', label: 'About' },
    { href: '/contact', label: 'Contact' },
];
---

<nav class="navbar" aria-label="Main navigation">
    <div class="navbar-container">
        <a class="brand-link" href="/" aria-label="Ultimate Bench home">
            <span class="brand-mark" aria-hidden="true">UB</span>
            <span class="brand-name">Ultimate Bench</span>
        </a>

        <button
            class="navbar-toggle"
            id="navbar-toggle"
            type="button"
            aria-label="Toggle navigation"
            aria-controls="navbar-menu"
            aria-expanded="false"
        >
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>

        <div class="navbar-menu" id="navbar-menu">
            {links.map(({ href, label }) => {
                const isActive = href === '/'
                    ? currentPath === '/'
                    : currentPath === href || currentPath.startsWith(`${href}/`);
                return (
                    <a
                        href={href}
                        class="nav-link"
                        aria-current={isActive ? 'page' : undefined}
                    >
                        {label}
                    </a>
                );
            })}
        </div>
    </div>
</nav>

<style>
.navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(54, 77, 112, 0.55);
    background: rgba(8, 15, 28, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
}

.navbar-container {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: min(100% - 3rem, var(--container-max));
    height: 4.25rem;
    margin: auto;
}

.brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
    white-space: nowrap;
}

.brand-link:hover {
    color: #ffffff;
}

.brand-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid rgba(125, 196, 255, 0.35);
    border-radius: 0.55rem;
    background: linear-gradient(155deg, #1b3154 0%, #0f1e36 100%);
    color: var(--text);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    box-shadow: var(--surface-highlight), 0 4px 12px rgba(2, 8, 20, 0.4);
    overflow: hidden;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
}

.brand-mark::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2.5px;
    background: var(--accent);
}

.brand-link:hover .brand-mark {
    border-color: rgba(243, 201, 105, 0.55);
    transform: translateY(-1px);
}

.navbar-menu {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
}

.nav-link {
    position: relative;
    padding: 0.48rem 0.75rem;
    border: 1px solid transparent;
    border-radius: 7px;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
}

.nav-link:hover {
    color: var(--text);
    background: rgba(23, 39, 66, 0.72);
}

.nav-link[aria-current="page"] {
    color: #dbeeff;
    font-weight: 600;
    background: rgba(30, 52, 86, 0.85);
    border-color: rgba(125, 196, 255, 0.28);
    box-shadow: var(--surface-highlight);
}

.navbar-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    margin-left: auto;
    padding: 0 11px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--surface);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
}

.navbar-toggle:hover {
    border-color: var(--link);
    background: var(--panel);
}

.bar {
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transform-origin: center;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
}

.navbar-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
}

.navbar-toggle[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
}

.navbar-toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
}

@media (max-width: 1100px) {
    .navbar-container {
        width: calc(100% - 2rem);
    }

    .navbar-toggle {
        display: flex;
    }

    .navbar-menu {
        position: fixed;
        top: 4.25rem;
        left: 0;
        display: none;
        flex-direction: column;
        align-items: stretch;
        gap: 0.25rem;
        width: 100%;
        max-height: calc(100dvh - 4.25rem);
        overflow-y: auto;
        padding: 0.75rem 1rem 1.25rem;
        border-bottom: 1px solid var(--line-strong);
        background: rgba(8, 15, 28, 0.98);
        box-shadow: 0 20px 44px rgba(2, 8, 20, 0.65);
    }

    .navbar-menu.active {
        display: flex;
    }

    .nav-link {
        padding: 0.75rem 0.85rem;
        font-size: 0.92rem;
    }

    .navbar:not([data-enhanced]) .navbar-container {
        height: auto;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding-block: 1rem;
    }

    .navbar:not([data-enhanced]) .navbar-menu {
        position: static;
        display: flex;
        max-height: none;
        padding: 0;
        border: 0;
        box-shadow: none;
    }

    .navbar:not([data-enhanced]) .navbar-toggle {
        display: none;
    }
}
</style>

<script>
    const toggle = document.getElementById('navbar-toggle');
    const menu = document.getElementById('navbar-menu');
    const navbar = document.querySelector('.navbar');

    if (toggle && menu && navbar) {
        const mobile = matchMedia('(max-width: 1100px)');
        navbar.setAttribute('data-enhanced', '');

        const setOpen = (open: boolean) => {
            menu.classList.toggle('active', open);
            toggle.setAttribute('aria-expanded', String(open));
            menu.inert = mobile.matches && !open;
        };

        setOpen(false);

        toggle.addEventListener('click', () => {
            setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        menu.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => setOpen(false));
        });

        mobile.addEventListener('change', () => setOpen(false));

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && menu.classList.contains('active')) {
                setOpen(false);
                toggle.focus();
            }
        });

        document.addEventListener('click', (event) => {
            if (event.target instanceof Node && !navbar.contains(event.target)) {
                setOpen(false);
            }
        });

        navbar.addEventListener('focusout', (event) => {
            if (
                event instanceof FocusEvent &&
                event.relatedTarget instanceof Node &&
                !navbar.contains(event.relatedTarget)
            ) {
                setOpen(false);
            }
        });
    }
</script>
