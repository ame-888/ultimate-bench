---
import { ARENA_LIST } from '../../data/benchmarkSpec';
import { guideComparisonRows } from '../../data/guide';
const first = guideComparisonRows[0], second = guideComparisonRows[1] ?? first;
---
<section id="compare" class="guide-section" aria-labelledby="compare-title">
 <p class="step">05 · Compare responsibly</p><h2 id="compare-title">Compare evidence, not just rank.</h2>
 {guideComparisonRows.length >= 2 ? <><div class="compare-controls"><label for="model-a">Configuration A</label><select id="model-a">{guideComparisonRows.map((row,i)=><option value={i}>{row.name}</option>)}</select><label for="model-b">Configuration B</label><select id="model-b">{guideComparisonRows.map((row,i)=><option value={i} selected={i===1}>{row.name}</option>)}</select></div><p id="compare-message" class="fine" role="status">Showing two globally qualified configurations. No winner is inferred.</p><div class="table-scroll compare-region" tabindex="0" aria-label="Selected model comparison; scroll horizontally if needed"><table><caption>Orientation comparison from canonical leaderboard output</caption><thead><tr><th scope="col">Evidence</th><th id="compare-a-name" scope="col">{first.name}</th><th id="compare-b-name" scope="col">{second.name}</th></tr></thead><tbody><tr><th scope="row">Official rank</th><td data-side="a" data-field="rank">#{first.rank}</td><td data-side="b" data-field="rank">#{second.rank}</td></tr><tr><th scope="row">Overall</th><td data-side="a" data-field="overall">{first.overall}%</td><td data-side="b" data-field="overall">{second.overall}%</td></tr>{ARENA_LIST.map(arena=><tr><th scope="row">{arena.name}</th><td data-side="a" data-field={`arena.${arena.id}`}>{first.arenas[arena.id]}%</td><td data-side="b" data-field={`arena.${arena.id}`}>{second.arenas[arena.id]}%</td></tr>)}<tr><th scope="row">Active coverage</th><td data-side="a" data-field="coverage">{Object.values(first.coverage).join(' · ')}</td><td data-side="b" data-field="coverage">{Object.values(second.coverage).join(' · ')}</td></tr><tr><th scope="row">Release date</th><td data-side="a" data-field="releaseDate">{first.releaseDate}</td><td data-side="b" data-field="releaseDate">{second.releaseDate}</td></tr><tr><th scope="row">Price view</th><td data-side="a" data-field="pricing">{first.pricing}</td><td data-side="b" data-field="pricing">{second.pricing}</td></tr></tbody></table></div></> : <p class="notice">At least two globally qualified configurations are required for the helper. Arena tables remain available on the leaderboard.</p>}
 <ol class="questions"><li>Are both complete and officially ranked?</li><li>Are the configurations genuinely comparable?</li><li>Which arena resembles the need?</li><li>Is the advantage broad or concentrated?</li><li>Does either fail at a level that matters?</li><li>Is the gap practically meaningful, rather than merely visible after rounding?</li><li>Do price, speed, access, privacy, context, or tools change the choice?</li><li>Have both been tested on representative work?</li></ol>
 <p class="links"><a href="/#global-leaderboard">Open full leaderboard</a><a href="/analysis#tradeoffs">Inspect trade-offs</a><a href="#evaluate">Build a private evaluation</a></p>
</section>
<script is:inline define:vars={{models: guideComparisonRows}}>
 const a=document.querySelector('#model-a'), b=document.querySelector('#model-b'), message=document.querySelector('#compare-message');
 function render(side, index){/* @ts-ignore Astro injects models. */const model=models[Number(index)]; if(!model)return; const heading=document.querySelector(`#compare-${side}-name`); if(heading)heading.textContent=model.name; document.querySelectorAll(`[data-side="${side}"]`).forEach(cell=>{const field=cell.dataset.field; if(field==='rank')cell.textContent=`#${model.rank}`; else if(field==='overall')cell.textContent=`${model.overall}%`; else if(field?.startsWith('arena.'))cell.textContent=`${model.arenas[field.slice(6)]}%`; else if(field==='coverage')cell.textContent=Object.values(model.coverage).join(' · '); else cell.textContent=model[field] ?? 'Unavailable';});}
 function update(){ if(!a||!b)return; render('a',a.value); render('b',b.value); if(message)message.textContent=a.value===b.value?'You selected the same configuration twice. Choose a different second configuration for a useful comparison.':'Showing two globally qualified configurations. No winner is inferred.'; }
 a?.addEventListener('change',update); b?.addEventListener('change',update);
</script>
