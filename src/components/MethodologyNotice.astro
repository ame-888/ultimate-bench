---
import { METHODOLOGY } from '../data/methodology';
---
<aside class="methodology-notice" aria-label="Complete methodology publication">
  <strong>Part of the complete Ultimate Bench methodology</strong>
  <span><a href={METHODOLOGY.overviewPath}>Methodology overview</a><a href={METHODOLOGY.publicationPath}>Complete HTML publication</a><a href={METHODOLOGY.pdfPath}>Open PDF (version {METHODOLOGY.version})</a></span>
</aside>
<style>
.methodology-notice{display:flex;flex-wrap:wrap;justify-content:space-between;gap:.75rem 1.5rem;margin:0 0 1.5rem;padding:1rem 0;border-block:1px solid var(--line);color:var(--muted);font-size:.85rem}.methodology-notice strong{color:var(--text);font-weight:500}.methodology-notice span{display:flex;flex-wrap:wrap;gap:.6rem 1.25rem}a{color:var(--link)}
</style>
