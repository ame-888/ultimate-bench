---
import { METHODOLOGY } from '../data/methodology';
---
<aside class="methodology-notice" aria-label="Complete methodology publication">
    <strong>Part of the complete Ultimate Bench methodology</strong>
    <span>
        <a href={METHODOLOGY.overviewPath}>Methodology overview</a>
        <a href={METHODOLOGY.publicationPath}>Complete HTML publication</a>
        <a href={METHODOLOGY.pdfPath}>Open PDF (version {METHODOLOGY.version})</a>
    </span>
</aside>

<style>
.methodology-notice {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin: 0 0 1.75rem;
    padding: 0.9rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.84rem;
}

.methodology-notice strong {
    color: var(--text);
    font-weight: 600;
}

.methodology-notice span {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.25rem;
}

a {
    color: var(--link);
}
</style>
