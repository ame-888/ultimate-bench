---
import type { CapabilitySeries } from '../data/progression';
const { series } = Astro.props as { series: CapabilitySeries };
const labels = { visual:'Visual', 'data-retrieval':'Data Retrieval', chess:'Chess', ultimate:'Ultimate' };
---
<section class="capability-timeline progress-panel" aria-labelledby="progress-title" hidden>
  <header><span class="timeline-kicker">Progress · release by release</span><h3 id="progress-title">Capability Progress</h3><p>Model scores by release date. The frontier line shows the highest eligible score available at each point in time.</p></header>
  <div class="metric-tabs" role="group" aria-label="Metric">{Object.entries(labels).map(([key,label]) => <button type="button" data-metric={key} aria-pressed={key==='ultimate'}>{label}</button>)}</div>
  <div class="timeline-controls">
    <fieldset><legend>Time range</legend><button type="button" data-range="recent" aria-pressed="true">Recent</button><button type="button" data-range="full" aria-pressed="false">Full history</button></fieldset>
    <fieldset><legend>Vertical scale</legend><button type="button" data-scale="zoomed" aria-pressed="true">Zoomed</button><button type="button" data-scale="full" aria-pressed="false">Full 0–100%</button></fieldset>
    <label><input type="checkbox" data-frontier checked/> Show frontier</label>
  </div>
  <p class="timeline-scale-note">Zoomed vertical scale. Select 0–100% to view the full benchmark range.</p>
  <div class="timeline-chart" data-chart></div>
  <div class="timeline-detail" data-detail aria-live="polite">Focus, hover, or select a point to inspect a model.</div>
  <div class="timeline-legend" data-legend aria-label="Provider legend"></div>
  <p class="timeline-coverage" data-coverage></p>
  <script type="application/json" data-timeline-data set:html={JSON.stringify(series).replace(/</g,'\u003c')}></script>
</section>

<style>
.capability-timeline{--text:#f3f4f6;--muted:#afc4e6;--axis:rgba(148,163,184,.45);--grid:rgba(148,163,184,.18);padding:1.3rem;border:1px solid #29394e;border-radius:18px;background:#0a1524;color:var(--text)}
.capability-timeline header h3{margin:.25rem 0;font-size:1.55rem}.capability-timeline header p{margin:.3rem 0 1rem;color:var(--muted);line-height:1.5}.timeline-kicker{color:#5eead4;font-size:.68rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
.metric-tabs,.timeline-controls,.timeline-controls fieldset{display:flex;flex-wrap:wrap;gap:.4rem}.metric-tabs{margin-bottom:.8rem}.metric-tabs button,.timeline-controls button{min-height:38px;padding:.5rem .75rem;border:1px solid #40516a;border-radius:7px;background:#101b2b;color:#d5deea;font-weight:700;cursor:pointer}.metric-tabs button[aria-pressed=true],.timeline-controls button[aria-pressed=true]{border-color:#5eead4;background:#15323a;color:#fff}.timeline-controls{align-items:end}.timeline-controls fieldset{margin:0;padding:0;border:0}.timeline-controls legend{width:100%;color:var(--muted);font-size:.65rem}.timeline-controls label{display:flex;align-items:center;min-height:38px;padding:0 .5rem;color:#d5deea;font-size:.75rem}.timeline-scale-note,.timeline-coverage{margin:.7rem 0;color:#9fb0c5;font-size:.7rem}
.timeline-chart{width:100%;min-height:440px}.timeline-chart svg{display:block;width:100%;height:440px;overflow:visible}.timeline-grid{stroke:var(--grid);stroke-width:1}.timeline-axis{stroke:var(--axis);stroke-width:1}.timeline-axis-text,.timeline-axis-label{fill:var(--muted);font:12px var(--font-body)}.timeline-axis-label{font-weight:700}.timeline-frontier{fill:none;stroke:#f8fafc;stroke-width:2.25;stroke-linejoin:round;stroke-linecap:round;vector-effect:non-scaling-stroke}.timeline-hit{fill:transparent;cursor:pointer}.timeline-point{stroke:#f3f4f6;stroke-width:1.25}.timeline-point.is-selected{stroke:#fbbf24;stroke-width:3}.timeline-point-group:focus{outline:none}.timeline-point-group:focus .timeline-point{stroke:#fbbf24;stroke-width:3;r:6}.timeline-detail{min-height:1.4rem;margin-top:.5rem;padding:.65rem .8rem;border-left:3px solid #5eead4;background:#101b2b;color:#cbd5e1;font-size:.75rem;line-height:1.5}.timeline-detail strong{color:#fff}.timeline-legend{display:flex;flex-wrap:wrap;gap:.55rem 1rem;margin-top:.8rem;color:#cbd5e1;font-size:.7rem}.timeline-legend span{display:flex;align-items:center;gap:.35rem}.timeline-legend i{width:.65rem;height:.65rem;border:1px solid #f3f4f6;border-radius:50%}
@media(max-width:600px){.capability-timeline{padding:.8rem}.timeline-chart{min-height:360px}.timeline-chart svg{height:360px}.timeline-controls fieldset{flex:1 1 100%}.timeline-controls button{flex:1}.metric-tabs button{flex:1 1 40%;padding:.4rem}.timeline-axis-text{font-size:10px}}
</style>

<script is:inline>
const root=document.querySelector('.capability-timeline');
if(root){
 const series=JSON.parse(root.querySelector('[data-timeline-data]').textContent); const chart=root.querySelector('[data-chart]'), detail=root.querySelector('[data-detail]'), legend=root.querySelector('[data-legend]'), coverage=root.querySelector('[data-coverage]');
 const colors={Google:'#60a5fa',OpenAI:'#34d399',Anthropic:'#fb923c','xAI':'#e879f9',Meta:'#f472b6',DeepSeek:'#a78bfa',Other:'#94a3b8'};
 const provider=n=>{n=n.toLowerCase();if(n.includes('gemini'))return'Google';if(n.includes('gpt')||n.includes('o3')||n.includes('o4'))return'OpenAI';if(n.includes('claude'))return'Anthropic';if(n.includes('grok'))return'xAI';if(n.includes('llama')||n.includes('muse'))return'Meta';if(n.includes('deepseek'))return'DeepSeek';return'Other'};
 const labels={visual:'Visual','data-retrieval':'Data Retrieval',chess:'Chess',ultimate:'Ultimate'}; const state={metric:'ultimate',range:'recent',scale:'zoomed',frontier:true};
 const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const fullDate=t=>new Intl.DateTimeFormat('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}).format(t); const shortDate=t=>new Intl.DateTimeFormat('en-US',{year:'numeric',month:'short',timeZone:'UTC'}).format(t);
 function select(point,previous,node){chart.querySelectorAll('.timeline-point').forEach(p=>p.classList.remove('is-selected'));node?.querySelector('.timeline-point')?.classList.add('is-selected');const improvement=point.isRecord?(previous==null?'first recorded frontier':`previous frontier ${previous.toFixed(2)}%; improvement ${(point.score-previous).toFixed(2)} percentage points`):`did not establish a new frontier`;detail.innerHTML=`<strong>${esc(point.name)}</strong> · ${esc(provider(point.name))} · ${fullDate(point.timestamp)} · ${labels[state.metric]} · ${point.score.toFixed(2)}% · ${improvement}.`}
 function render(){const progression=series[state.metric], days=progression.dates, latest=Math.max(...days.map(d=>d.timestamp)), earliest=Math.min(...days.map(d=>d.timestamp));let start=earliest;if(state.range==='recent'){const d=new Date(latest);d.setUTCMonth(d.getUTCMonth()-18);start=d.getTime()}const visible=days.filter(d=>d.timestamp>=start&&d.timestamp<=latest),points=visible.flatMap(d=>d.observations);const maxScore=Math.max(0,...points.map(p=>p.score));const yMax=state.scale==='full'?100:Math.min(100,Math.max(5,Math.ceil(maxScore*1.12/5)*5));const W=1000,H=440,m={l:72,r:30,t:28,b:62},pad=Math.max(86400000*10,(latest-start)*.025),xmin=start-pad,xmax=latest+pad,x=t=>m.l+(t-xmin)/(xmax-xmin)*(W-m.l-m.r),y=v=>m.t+(yMax-v)/yMax*(H-m.t-m.b);const mobile=innerWidth<600,tickCount=mobile?3:6;const xt=Array.from({length:tickCount},(_,i)=>start+(latest-start)*i/(tickCount-1));const step=yMax<=20?5:yMax<=50?10:20;const yt=[];for(let n=0;n<=yMax;n+=step)yt.push(n);if(yt.at(-1)!==yMax)yt.push(yMax);let record=-Infinity;const line=[];for(const day of days.filter(d=>d.timestamp<=latest)){record=Math.max(record,day.frontierScore);if(day.timestamp>=start)line.push({x:x(day.timestamp),y:y(record)});else if(!line.length)line.push({x:x(start),y:y(record)})}const path=line.map((p,i)=>i?`H ${p.x} V ${p.y}`:`M ${p.x} ${p.y}`).join(' ');chart.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${labels[state.metric]} canonical scores by model release date"><g>${yt.map(t=>`<line class="timeline-grid" x1="${m.l}" x2="${W-m.r}" y1="${y(t)}" y2="${y(t)}"/><text class="timeline-axis-text" text-anchor="end" x="${m.l-10}" y="${y(t)+4}">${t}%</text>`).join('')}</g><line class="timeline-axis" x1="${m.l}" x2="${W-m.r}" y1="${H-m.b}" y2="${H-m.b}"/><line class="timeline-axis" x1="${m.l}" x2="${m.l}" y1="${m.t}" y2="${H-m.b}"/>${xt.map((t,i)=>`<text class="timeline-axis-text" text-anchor="${i===0?'start':i===xt.length-1?'end':'middle'}" x="${x(t)}" y="${H-m.b+26}">${shortDate(t)}</text>`).join('')}<text class="timeline-axis-label" text-anchor="middle" x="${(m.l+W-m.r)/2}" y="${H-8}">Model release date</text><text class="timeline-axis-label" text-anchor="middle" transform="translate(18 ${(m.t+H-m.b)/2}) rotate(-90)">Canonical score</text>${state.frontier?`<path class="timeline-frontier" d="${path}" fill="none" stroke="#F8FAFC" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>`:''}<g>${points.map((p,i)=>`<g class="timeline-point-group" tabindex="0" role="button" data-i="${i}" aria-label="${esc(p.name)}, ${p.score.toFixed(2)} percent"><circle class="timeline-hit" cx="${x(p.timestamp)}" cy="${y(p.score)}" r="12"/><circle class="timeline-point" cx="${x(p.timestamp)}" cy="${y(p.score)}" r="5" fill="${colors[provider(p.name)]}" stroke="#F3F4F6"/></g>`).join('')}</g></svg>`;const providers=[...new Set(points.map(p=>provider(p.name)))].sort();legend.innerHTML=providers.map(p=>`<span><i style="background:${colors[p]}"></i>${p}</span>`).join('');coverage.textContent=progression.excluded.length?`Timeline includes ${days.flatMap(d=>d.observations).length} of ${days.flatMap(d=>d.observations).length+progression.excluded.length} eligible models with recorded release dates.`:'';chart.querySelectorAll('[data-i]').forEach(node=>{const p=points[+node.dataset.i],prev=days.findLast(d=>d.timestamp<p.timestamp&&d.recordModels.length)?.frontierScore;['mouseenter','focus','click','touchstart'].forEach(e=>node.addEventListener(e,()=>select(p,prev,node),{passive:true}))});const holder=[...points].reverse().find(p=>p.isRecord);if(holder)select(holder,days.findLast(d=>d.timestamp<holder.timestamp&&d.recordModels.length)?.frontierScore)}
 root.querySelectorAll('[data-metric],[data-range],[data-scale]').forEach(b=>b.addEventListener('click',()=>{const key=b.dataset.metric?'metric':b.dataset.range?'range':'scale';state[key]=b.dataset.metric||b.dataset.range||b.dataset.scale;root.querySelectorAll(`[data-${key}]`).forEach(x=>x.setAttribute('aria-pressed',String(x===b)));root.querySelector('.timeline-scale-note').hidden=state.scale!=='zoomed';render()}));root.querySelector('[data-frontier]').addEventListener('change',e=>{state.frontier=e.target.checked;render()});addEventListener('resize',()=>render());render();
}
</script>
