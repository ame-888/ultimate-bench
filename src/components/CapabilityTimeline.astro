---
import type { CapabilitySeries } from '../data/progression';
const { series } = Astro.props as { series: CapabilitySeries };
const labels = { visual: 'Visual', 'data-retrieval': 'Data Retrieval', chess: 'Chess', ultimate: 'Ultimate' };
---
<section class="capability-timeline progress-panel" aria-labelledby="progress-title" hidden>
  <header>
    <span class="timeline-kicker">Progress over time</span>
    <h3 id="progress-title">Capability Progress</h3>
  </header>

  <div class="metric-tabs" role="tablist" aria-label="Benchmark metric">
    {Object.entries(labels).map(([key, label]) => (
      <button type="button" role="tab" data-metric={key} aria-selected={key === 'ultimate'} tabindex={key === 'ultimate' ? '0' : '-1'}>{label}</button>
    ))}
  </div>

  <div class="timeline-toolbar" aria-label="Chart options">
    <div class="range-switch" role="group" aria-label="Time range">
      <button type="button" data-range="recent" aria-pressed="true">Recent</button>
      <button type="button" data-range="full" aria-pressed="false">Full history</button>
    </div>
    <label class="quiet-toggle"><input type="checkbox" data-full-scale /><span aria-hidden="true"></span>Full 0–100%</label>
    <label class="quiet-toggle"><input type="checkbox" data-frontier checked /><span aria-hidden="true"></span>Show frontier</label>
  </div>

  <div class="timeline-chart" data-chart></div>
  <div class="timeline-legend" data-legend aria-label="Provider legend"></div>
  <div class="timeline-detail" data-detail aria-live="polite"></div>
  <script is:inline type="application/json" data-timeline-data set:html={JSON.stringify(series).replace(/</g, '\u003c')}></script>
</section>

<style is:global>
  .capability-timeline{--text:#f5f7fb;--muted:#9cacc1;--subtle:#74859c;--line:rgba(148,163,184,.14);padding:clamp(1rem,2.5vw,1.75rem);border:1px solid rgba(148,163,184,.16);border-radius:20px;background:linear-gradient(145deg,rgba(13,27,45,.96),rgba(7,17,30,.98));box-shadow:0 18px 55px rgba(0,0,0,.16);color:var(--text)}
  .capability-timeline header{margin-bottom:1.25rem}.capability-timeline header h3{margin:.25rem 0 0;font-size:clamp(1.45rem,3vw,1.8rem);letter-spacing:-.025em}.timeline-kicker{color:#69dbc9;font-size:.66rem;font-weight:750;letter-spacing:.13em;text-transform:uppercase}
  .metric-tabs{display:flex;gap:.25rem;width:fit-content;max-width:100%;margin-bottom:.75rem;padding:.25rem;border:1px solid rgba(148,163,184,.15);border-radius:12px;background:rgba(5,13,24,.46);overflow-x:auto}.metric-tabs button{min-height:38px;padding:.5rem .9rem;border:0;border-radius:8px;background:transparent;color:#9eafc4;font:inherit;font-size:.8rem;font-weight:700;white-space:nowrap;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s}.metric-tabs button[aria-selected=true]{background:#1b3444;color:#f7fffd;box-shadow:inset 0 0 0 1px rgba(94,234,212,.32),0 3px 12px rgba(0,0,0,.16)}
  .timeline-toolbar{display:flex;align-items:center;flex-wrap:wrap;gap:.45rem 1rem;margin-bottom:.55rem;color:#aab8ca;font-size:.72rem}.range-switch{display:flex;padding:2px;border:1px solid rgba(148,163,184,.16);border-radius:999px;background:rgba(5,13,24,.38)}.range-switch button{min-height:30px;padding:.3rem .7rem;border:0;border-radius:999px;background:transparent;color:#8fa0b5;font:inherit;font-weight:650;cursor:pointer}.range-switch button[aria-pressed=true]{background:rgba(148,163,184,.15);color:#eef3f9}
  .quiet-toggle{display:inline-flex;align-items:center;gap:.42rem;min-height:30px;cursor:pointer;white-space:nowrap}.quiet-toggle input{position:absolute;width:1px;height:1px;opacity:0}.quiet-toggle span{position:relative;width:1.65rem;height:.94rem;border:1px solid rgba(148,163,184,.35);border-radius:999px;background:#111d2c;transition:.18s}.quiet-toggle span:after{content:"";position:absolute;top:2px;left:2px;width:.58rem;height:.58rem;border-radius:50%;background:#8090a5;transition:.18s}.quiet-toggle input:checked+span{border-color:rgba(94,234,212,.48);background:rgba(45,212,191,.18)}.quiet-toggle input:checked+span:after{transform:translateX(.68rem);background:#75e6d4}
  button:focus-visible,.quiet-toggle:has(input:focus-visible){outline:2px solid #5eead4;outline-offset:3px}
  .timeline-chart{width:100%;min-height:410px}.timeline-chart svg{display:block;width:100%;height:410px;overflow:visible}.timeline-grid{stroke:var(--line);stroke-width:1}.timeline-axis{stroke:rgba(148,163,184,.26);stroke-width:1}.timeline-axis-text,.timeline-axis-label{fill:#91a1b5;font:11px var(--font-body);letter-spacing:.01em}.timeline-axis-label{fill:#a9b6c7;font-size:10.5px;font-weight:650;letter-spacing:.04em}.timeline-frontier{fill:none;stroke:#d8e3ee;stroke-width:1.65;stroke-linejoin:round;stroke-linecap:round;vector-effect:non-scaling-stroke;opacity:.9}.timeline-hit{fill:transparent;cursor:pointer}.timeline-point{stroke:#dbe5ef;stroke-width:.85;filter:drop-shadow(0 1px 2px rgba(0,0,0,.35));transition:r .12s,stroke-width .12s}.timeline-record-ring{fill:none;stroke:rgba(216,227,238,.54);stroke-width:1}.timeline-point.is-selected,.timeline-point-group:focus .timeline-point{stroke:#fff4bd;stroke-width:2;r:5}.timeline-point-group:focus{outline:none}
  .timeline-legend{display:flex;flex-wrap:wrap;gap:.45rem 1rem;margin:.45rem 0 .55rem;color:#93a3b7;font-size:.68rem}.timeline-legend span{display:inline-flex;align-items:center;gap:.35rem}.timeline-legend i{width:.48rem;height:.48rem;border:1px solid rgba(255,255,255,.58);border-radius:50%;box-shadow:0 0 0 2px rgba(255,255,255,.03)}
  .timeline-detail{min-height:2.6rem;padding:.6rem 0 .05rem;border-top:1px solid rgba(148,163,184,.12);color:#95a6ba;font-size:.72rem;line-height:1.45}.timeline-detail strong{color:#edf3f9;font-size:.78rem}.timeline-detail .detail-score{color:#dce8f4;font-variant-numeric:tabular-nums}.timeline-detail .detail-context{color:#718299}
  @media(max-width:700px){.metric-tabs{width:100%}.metric-tabs button{flex:1;padding:.45rem .55rem}.timeline-chart{min-height:290px}.timeline-chart svg{height:290px}.timeline-toolbar{gap:.35rem .75rem}.timeline-axis-text{font-size:10px}}
  @media(max-width:430px){.capability-timeline{padding:.9rem;border-radius:16px}.metric-tabs button{font-size:.7rem}.timeline-toolbar{font-size:.68rem}.range-switch{width:100%}.range-switch button{flex:1}.timeline-chart{min-height:180px;margin-top:.15rem}.timeline-chart svg{height:180px}.timeline-detail{min-height:3rem}}
</style>

<script is:inline>
const root=document.querySelector('.capability-timeline');
if(root){
 const series=JSON.parse(root.querySelector('[data-timeline-data]').textContent),chart=root.querySelector('[data-chart]'),detail=root.querySelector('[data-detail]'),legend=root.querySelector('[data-legend]');
 const colors={Google:'#60a5fa',OpenAI:'#34d399',Anthropic:'#fb923c',xAI:'#e879f9',Meta:'#f472b6',DeepSeek:'#a78bfa',Other:'#94a3b8'};
 const provider=n=>{n=n.toLowerCase();if(n.includes('gemini'))return'Google';if(n.includes('gpt')||n.includes('o3')||n.includes('o4'))return'OpenAI';if(n.includes('claude'))return'Anthropic';if(n.includes('grok'))return'xAI';if(n.includes('llama')||n.includes('muse'))return'Meta';if(n.includes('deepseek'))return'DeepSeek';return'Other'};
 const labels={visual:'Visual','data-retrieval':'Data Retrieval',chess:'Chess',ultimate:'Ultimate'},state={metric:'ultimate',range:'recent',fullScale:false,frontier:true};
 const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const fullDate=t=>new Intl.DateTimeFormat('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}).format(t),shortDate=t=>new Intl.DateTimeFormat('en-US',{year:'numeric',month:'short',timeZone:'UTC'}).format(t);
 function select(point,node){chart.querySelectorAll('.timeline-point').forEach(p=>p.classList.remove('is-selected'));node?.querySelector('.timeline-point')?.classList.add('is-selected');const status=point.isRecord?'Frontier record':'Model result';detail.innerHTML=`<strong>${esc(point.name)}</strong> <span class="detail-score">${point.score.toFixed(2)}%</span><br><span>${esc(provider(point.name))} · ${fullDate(point.timestamp)} · ${labels[state.metric]}</span> <span class="detail-context">· ${status}</span>`}
 function render(){
  const progression=series[state.metric],days=progression.dates,latest=Math.max(...days.map(d=>d.timestamp)),earliest=Math.min(...days.map(d=>d.timestamp));let start=earliest;if(state.range==='recent'){const d=new Date(latest);d.setUTCMonth(d.getUTCMonth()-18);start=d.getTime()}
  const visible=days.filter(d=>d.timestamp>=start&&d.timestamp<=latest),points=visible.flatMap(d=>d.observations),scores=points.map(p=>p.score),maxScore=Math.max(0,...scores),minScore=Math.min(...scores);let yMin=0,yMax=100;if(!state.fullScale){const spread=Math.max(8,maxScore-minScore);yMin=Math.max(0,Math.floor((minScore-spread*.18)/5)*5);yMax=Math.min(100,Math.ceil((maxScore+spread*.18)/5)*5);if(yMax-yMin<10)yMin=Math.max(0,yMax-10)}
  const W=1000,H=410,m={l:58,r:22,t:20,b:56},pad=Math.max(86400000*10,(latest-start)*.025),xmin=start-pad,xmax=latest+pad,x=t=>m.l+(t-xmin)/(xmax-xmin)*(W-m.l-m.r),y=v=>m.t+(yMax-v)/(yMax-yMin)*(H-m.t-m.b),mobile=innerWidth<600,tickCount=mobile?3:6,xt=Array.from({length:tickCount},(_,i)=>start+(latest-start)*i/(tickCount-1)),yTicks=5,yt=Array.from({length:yTicks},(_,i)=>yMin+(yMax-yMin)*i/(yTicks-1));
  let record=-Infinity;const line=[];for(const day of days.filter(d=>d.timestamp<=latest)){record=Math.max(record,day.frontierScore);if(day.timestamp>=start)line.push({x:x(day.timestamp),y:y(record)});else if(!line.length)line.push({x:x(start),y:y(record)})}const path=line.map((p,i)=>i?`H ${p.x} V ${p.y}`:`M ${p.x} ${p.y}`).join(' ');
  chart.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${labels[state.metric]} scores by release date"><g>${yt.map(t=>`<line class="timeline-grid" x1="${m.l}" x2="${W-m.r}" y1="${y(t)}" y2="${y(t)}"/><text class="timeline-axis-text" text-anchor="end" x="${m.l-9}" y="${y(t)+4}">${Number.isInteger(t)?t:t.toFixed(1)}%</text>`).join('')}</g><line class="timeline-axis" x1="${m.l}" x2="${W-m.r}" y1="${H-m.b}" y2="${H-m.b}"/>${xt.map((t,i)=>`<text class="timeline-axis-text" text-anchor="${i===0?'start':i===xt.length-1?'end':'middle'}" x="${x(t)}" y="${H-m.b+23}">${shortDate(t)}</text>`).join('')}<text class="timeline-axis-label" text-anchor="middle" x="${(m.l+W-m.r)/2}" y="${H-7}">Release date</text><text class="timeline-axis-label" text-anchor="middle" transform="translate(14 ${(m.t+H-m.b)/2}) rotate(-90)">Score</text>${state.frontier?`<path class="timeline-frontier" d="${path}"/>`:''}<g>${points.map((p,i)=>`<g class="timeline-point-group" tabindex="0" role="button" data-i="${i}" aria-label="${esc(p.name)}, ${p.score.toFixed(2)} percent, ${fullDate(p.timestamp)}">${p.isRecord?`<circle class="timeline-record-ring" cx="${x(p.timestamp)}" cy="${y(p.score)}" r="6.5"/>`:''}<circle class="timeline-hit" cx="${x(p.timestamp)}" cy="${y(p.score)}" r="11"/><circle class="timeline-point" cx="${x(p.timestamp)}" cy="${y(p.score)}" r="4" fill="${colors[provider(p.name)]}"/></g>`).join('')}</g></svg>`;
  const providers=[...new Set(points.map(p=>provider(p.name)))].sort();legend.innerHTML=providers.map(p=>`<span><i style="background:${colors[p]}"></i>${p}</span>`).join('');chart.querySelectorAll('[data-i]').forEach(node=>{const p=points[+node.dataset.i];['mouseenter','focus','click','touchstart'].forEach(e=>node.addEventListener(e,()=>select(p,node),{passive:true}))});const holder=days.flatMap(d=>d.observations).findLast(p=>p.isRecord);if(holder)select(holder,chart.querySelector(`[data-i="${points.indexOf(holder)}"]`))
 }
 root.querySelectorAll('[data-metric]').forEach(tab=>{tab.addEventListener('click',()=>{state.metric=tab.dataset.metric;root.querySelectorAll('[data-metric]').forEach(x=>{const active=x===tab;x.setAttribute('aria-selected',String(active));x.tabIndex=active?0:-1});render()});tab.addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight'].includes(e.key))return;e.preventDefault();const tabs=[...root.querySelectorAll('[data-metric]')],next=tabs[(tabs.indexOf(tab)+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length];next.focus();next.click()})});
 root.querySelectorAll('[data-range]').forEach(button=>button.addEventListener('click',()=>{state.range=button.dataset.range;root.querySelectorAll('[data-range]').forEach(x=>x.setAttribute('aria-pressed',String(x===button)));render()}));root.querySelector('[data-full-scale]').addEventListener('change',e=>{state.fullScale=e.target.checked;render()});root.querySelector('[data-frontier]').addEventListener('change',e=>{state.frontier=e.target.checked;render()});let resizeTimer;addEventListener('resize',()=>{clearTimeout(resizeTimer);resizeTimer=setTimeout(render,100)});render();
}
</script>
